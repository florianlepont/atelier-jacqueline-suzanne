# Sanity Content Lake — build-time only. Never exposed to the browser.
# Copy this file to .env and fill in real values (never commit .env).

# Sanity project ID (sanity.io/manage → project → Project ID)
SANITY_PROJECT_ID=

# Dataset name (e.g. "production")
SANITY_DATASET=

# Read-only (Viewer) API token for build-time fetches.
# Create via: npx sanity tokens add "Build-time Viewer (read-only)" --role=viewer --yes
# (run from the sanity/ Studio directory, requires an authenticated `sanity login` session)
SANITY_API_READ_TOKEN=

# Public origin used to generate canonical URLs, hreflang links and the sitemap.
# Keep the default GitHub Pages origin in CI; replace it with the OVH domain at launch.
SITE_URL=https://florianlepont.github.io

# Contact form POST target (05-02-PLAN.md). Optional — defaults to the
# same-origin path /contact.php at build time when unset, which is correct
# for the OVH production build. Override with the absolute production URL
# (https://atelierjacquelinesuzanne.fr/contact.php) only for the GitHub
# Pages staging build, since that host cannot execute PHP.
PUBLIC_CONTACT_ENDPOINT=
