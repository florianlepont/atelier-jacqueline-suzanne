{
  "name": "atelier-jacqueline-suzanne",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,mjs}\" \"tests/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,mjs}\" \"tests/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" \"*.{ts,mjs}\"",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:artifact": "node tests/scripts/verify-static-artifact.mjs",
    "test:smoke": "bash scripts/launch-smoke-check.sh",
    "sanity:downsize-images": "node scripts/sanity-downsize-images.mjs"
  },
  "dependencies": {
    "@fontsource/unbounded": "^5.3.0",
    "@sanity/client": "8.9.0",
    "@sanity/image-url": "2.1.1",
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "jsdom": "^30.1.2",
    "prettier": "3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "5.0.3"
  }
}
