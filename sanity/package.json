{
  "name": "atelier-jacqueline-suzanne",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage && node scripts/check-tsx-coverage.mjs"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/locale-fr-fr": "^1.2.37",
    "@sanity/orderable-document-list": "^2.0.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "6.6.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.11",
    "jsdom": "30.1.1",
    "prettier": "^3.9",
    "typescript": "^7.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@sanity/uuid": "3.0.3",
    "@module-federation/dts-plugin": {
      "undici": "7.30.0"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.0",
      "smol-toml": "1.7.0"
    },
    "adm-zip": "0.6.1",
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
