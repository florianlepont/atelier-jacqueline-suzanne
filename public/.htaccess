# Apache does not automatically wire Astro's prerendered src/pages/404.astro
# into its own error handling on static hosting — both pieces are required
# together (RESEARCH.md "Don't Hand-Roll" table).
ErrorDocument 404 /404.html

# OVH's Apache lists directory contents by default for any folder lacking
# an index file, which would expose the _astro/ asset tree and any future
# upload directory (ASVS V4).
Options -Indexes

# OVH auto-issues and auto-renews a Let's Encrypt certificate on web
# hosting plans, so HTTPS already works — this only stops plaintext
# requests being served instead (ASVS V13/V14). %{HTTP_HOST} is used
# instead of a hardcoded domain so the rule stays correct if the hosting
# account ever serves another name.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Security headers (ASVS V14). Wrapped in IfModule so a host without
# mod_headers serves the site unchanged instead of answering 500.
#
# The Content-Security-Policy matches what the site really loads: its own
# files, images from the Sanity CDN, and the inline scripts and styles Astro
# emits (hence 'unsafe-inline'; Astro has no nonce support on a static host).
# Everything else is closed: no plugins, no framing, no third-party scripts,
# forms and fetch() only to this origin (the contact form posts to
# /contact.php). If a future feature loads from another host, add it here.
#
# HSTS lasts six months, without includeSubDomains or preload: nothing here
# is allowed to affect other names on the domain. It is sent unconditionally
# (a first version gated on %{HTTPS} was never emitted on OVH); browsers ignore
# it on plain HTTP, and plain HTTP is redirected to HTTPS above anyway.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://cdn.sanity.io; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>
