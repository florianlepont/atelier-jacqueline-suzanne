---
// French Contact page (CONT-01, CONT-02): mounts the ContactForm island
// (via ContactPageBody) at the bottom of BaseLayout's body, passing
// `locale` as a build-time prop. Mirrors src/pages/en/contact.astro — only
// locale and import depth differ; the render model lives in
// src/lib/page-models.ts's buildContactPageModel().
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPageBody from '../components/ContactPageBody.astro';
import { getContactPage } from '../lib/sanity';
import { buildContactPageModel } from '../lib/page-models';

const locale = 'fr' as const;
const model = buildContactPageModel({ contact: await getContactPage(), locale });
---

<BaseLayout
  title={model.seoTitle}
  description={model.seoDescription}
  socialImage={model.socialImage}
  noIndex={model.noIndex}
  structuredData={model.structuredData as unknown as Record<string, unknown>}
>
  <ContactPageBody
    locale={locale}
    intro={model.intro}
    publicEmail={model.publicEmail}
    location={model.location}
    availability={model.availability}
    instagramLink={model.instagramLink}
    otherLinks={model.otherLinks}
    emailLabel={model.emailLabel}
    formHeading={model.formHeading}
    formSubheading={model.formSubheading}
    newTabHint={model.newTabHint}
  />
</BaseLayout>
