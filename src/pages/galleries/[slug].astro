---
// French gallery detail page (PORT-01/PORT-03): one static page per gallery
// slug via getStaticPaths(). The full gallery is fetched once in
// getStaticPaths and passed as props, avoiding a second per-page fetch
// (02-UI-SPEC.md interfaces note). Mirrors the EN counterpart at
// src/pages/en/galleries/[slug].astro — only import depth and locale key
// differ.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailHero from '../../components/DetailHero.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import type { GalleryGridItem } from '../../components/GalleryGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getGalleries } from '../../lib/sanity';
import { thumbnailUrl, fullSizeUrl, responsiveImageSrcSet, responsiveThumbnailSrcSet } from '../../lib/image';
import type { Gallery } from '../../lib/sanity';

export const getStaticPaths = (async () => {
  const galleries = await getGalleries();
  return galleries.map((gallery) => ({
    params: { slug: gallery.slug },
    props: { gallery },
  }));
}) satisfies GetStaticPaths;

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const locale = 'fr' as const;
// WR-03: statement is Studio-required (fr/en) per 02-01's schema validation,
// but a document written outside the Studio's publish-time validation could
// still be partially populated mid-edit.
const statement = gallery.statement?.[locale] ?? '';
// D-07/UI-SPEC Layout Notes: hero-scrim uses the gallery's cover photo
// (images[0]) at full size, same helper the Lightbox uses for its slides.
const heroImage = gallery.images[0];
const heroSrc = fullSizeUrl(heroImage, 2000);
const heroAlt = heroImage.alt?.[locale] ?? '';
// quick-260724-mjp: hero cover photo is now the shared DetailHero's
// clickable data-index="0" trigger, mirroring the édition hero's
// aria-label wording (and the gallery grid's own FR aria-label wording).
const heroAriaLabel = `Voir en taille réelle, image 1 sur ${gallery.images.length}`;
const seoTitle = gallery.seo?.title?.[locale] ?? `${gallery.title} — Atelier Jacqueline Suzanne`;
const seoDescription = gallery.seo?.description?.[locale] ?? statement;
const socialImage = fullSizeUrl(gallery.seo?.image ?? heroImage, 1200);

// Bug fix (gallery-thumb-grid-confusion): images[0] is already shown
// full-bleed as the hero above — rendering it again as the grid's first
// thumbnail duplicated it back-to-back. Skip index 0 here; it's still
// reachable in the Lightbox via prev/next wraparound since Lightbox below
// still receives the FULL gallery.images array.
const gridItems: GalleryGridItem[] = gallery.images.slice(1).map((img, i) => {
  const index = i + 1;
  return {
    index,
    src: thumbnailUrl(img, 600),
    srcset: responsiveThumbnailSrcSet(img),
    alt: '',
    ariaLabel: `Voir en taille réelle, image ${index + 1} sur ${gallery.images.length}`,
  };
});

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: gallery.title,
  description: seoDescription,
  url: Astro.url.toString(),
  inLanguage: 'fr',
  creator: { '@type': 'Person', name: 'Romane Lepont' },
  image: gallery.images.map((image) => ({
    '@type': 'ImageObject',
    contentUrl: fullSizeUrl(image, 2000),
    caption: image.alt?.fr ?? '',
    creditText: image.rights?.credit ?? 'Romane Lepont',
    copyrightNotice: image.rights?.copyrightNotice ?? '© Romane Lepont — Tous droits réservés',
  })),
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  socialImage={socialImage}
  noIndex={gallery.seo?.noIndex}
  structuredData={structuredData}
  headerVariant="transparent"
>
  <div class="gallery-detail">
    <DetailHero
      leadPhotoSrc={heroSrc}
      leadPhotoSrcSet={responsiveImageSrcSet(heroImage)}
      leadPhotoAlt={heroAlt}
      title={gallery.title}
      total={gallery.images.length}
      heroAriaLabel={heroAriaLabel}
      objectFit="contain"
    />
    <div class="gallery-detail__content">
      <p class="gallery-detail__statement">{statement}</p>
      {gallery.images.length > 1 && <GalleryGrid items={gridItems} />}
    </div>
  </div>
  <Lightbox images={gallery.images} locale={locale} />
</BaseLayout>

<style>
  .gallery-detail {
    padding: 0 0 var(--space-2xl);
  }

  .gallery-detail__content {
    padding: var(--space-2xl) var(--space-md) 0;
  }

  .gallery-detail__statement {
    max-width: 640px;
    font-size: 16px; /* Body role */
    font-weight: var(--weight-regular);
    line-height: 1.5;
    margin: 0 0 var(--space-2xl);
  }
</style>
