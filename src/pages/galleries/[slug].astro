---
// French gallery detail page (PORT-01/PORT-03): one static page per gallery
// slug via getStaticPaths(). The full gallery is fetched once in
// getStaticPaths and passed as props, avoiding a second per-page fetch
// (02-UI-SPEC.md interfaces note). Mirrors the EN counterpart at
// src/pages/en/galleries/[slug].astro — only import depth and locale key
// differ.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailHero from '../../components/DetailHero.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import type { GalleryGridItem } from '../../components/GalleryGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getGalleries } from '../../lib/sanity';
import { fullSizeUrl, responsiveImageSrcSet } from '../../lib/image';
import type { Gallery } from '../../lib/sanity';
import { pickHeroIndex } from '../../lib/image-orientation';

export const getStaticPaths = (async () => {
  const galleries = await getGalleries();
  return galleries.map((gallery) => ({
    params: { slug: gallery.slug },
    props: { gallery },
  }));
}) satisfies GetStaticPaths;

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const locale = 'fr' as const;
// WR-03: statement is Studio-required (fr/en) per 02-01's schema validation,
// but a document written outside the Studio's publish-time validation could
// still be partially populated mid-edit.
const statement = gallery.statement?.[locale] ?? '';
// quick-260724-oep: prefer the first LANDSCAPE image as the hero (the hero
// renders object-fit: contain — a portrait images[0] looks small/heavily
// letterboxed in the wide hero box), falling back to images[0] when no
// image is landscape. heroIndex is the hero's REAL array position, used
// below for the aria-label, the DetailHero trigger, and to exclude the
// hero (by its real index, not position 0) from the grid.
const heroIndex = pickHeroIndex(gallery.images);
const heroImage = gallery.images[heroIndex];
const heroSrc = fullSizeUrl(heroImage, 2000);
const heroAlt = heroImage.alt?.[locale] ?? '';
// quick-260724-mjp: hero cover photo is the shared DetailHero's clickable
// trigger; quick-260724-oep fixes this label to state the hero's REAL
// 1-based position (heroIndex + 1) so a screen-reader user is never told
// "image 1" and then lands on a different Lightbox counter.
const heroAriaLabel = `Voir en taille réelle, image ${heroIndex + 1} sur ${gallery.images.length}`;
const seoTitle = gallery.seo?.title?.[locale] ?? `${gallery.title} — Atelier Jacqueline Suzanne`;
const seoDescription = gallery.seo?.description?.[locale] ?? statement;
const socialImage = fullSizeUrl(gallery.seo?.image ?? heroImage, 1200);

// Bug fix (gallery-thumb-grid-confusion), generalized by quick-260724-oep:
// the hero image is already shown full-bleed above — exclude it from the
// grid by its REAL array index (not a hardcoded slice(1)), preserving every
// other image's own real position so grid clicks open the correct Lightbox
// slide. It's still reachable in the Lightbox via prev/next wraparound
// since Lightbox below still receives the FULL, unreordered gallery.images
// array. Grid src/srcset use the UNCROPPED helpers so each tile's intrinsic
// ratio equals its aspectRatio for the masonry layout below (never crops).
const gridItems: GalleryGridItem[] = gallery.images
  .map((img, index) => ({ img, index }))
  .filter((pair) => pair.index !== heroIndex)
  .map(({ img, index }) => {
    const { width, height } = img.dimensions ?? {};
    const aspectRatio = width && height && height > 0 ? width / height : 1;
    return {
      index,
      src: fullSizeUrl(img, 600),
      srcset: responsiveImageSrcSet(img, [320, 480, 600, 900]),
      alt: '',
      ariaLabel: `Voir en taille réelle, image ${index + 1} sur ${gallery.images.length}`,
      aspectRatio,
    };
  });

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: gallery.title,
  description: seoDescription,
  url: Astro.url.toString(),
  inLanguage: 'fr',
  creator: { '@type': 'Person', name: 'Romane Lepont' },
  image: gallery.images.map((image) => ({
    '@type': 'ImageObject',
    contentUrl: fullSizeUrl(image, 2000),
    caption: image.alt?.fr ?? '',
    creditText: image.rights?.credit ?? 'Romane Lepont',
    copyrightNotice: image.rights?.copyrightNotice ?? '© Romane Lepont — Tous droits réservés',
  })),
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  socialImage={socialImage}
  noIndex={gallery.seo?.noIndex}
  structuredData={structuredData}
  headerVariant="transparent"
>
  <div class="gallery-detail">
    <DetailHero
      leadPhotoSrc={heroSrc}
      leadPhotoSrcSet={responsiveImageSrcSet(heroImage)}
      leadPhotoAlt={heroAlt}
      title={gallery.title}
      total={gallery.images.length}
      heroAriaLabel={heroAriaLabel}
      objectFit="contain"
      heroIndex={heroIndex}
    />
    <div class="gallery-detail__content">
      <p class="gallery-detail__statement">{statement}</p>
      {gallery.images.length > 1 && <GalleryGrid items={gridItems} layout="masonry" />}
    </div>
  </div>
  <Lightbox images={gallery.images} locale={locale} />
</BaseLayout>

<style>
  .gallery-detail {
    padding: 0 0 var(--space-2xl);
  }

  .gallery-detail__content {
    padding: var(--space-2xl) var(--space-md) 0;
  }

  .gallery-detail__statement {
    max-width: 640px;
    font-size: 16px; /* Body role */
    font-weight: var(--weight-regular);
    line-height: 1.5;
    margin: 0 0 var(--space-2xl);
  }
</style>
