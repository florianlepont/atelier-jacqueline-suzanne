---
// French gallery detail page (PORT-01/PORT-03). Thin locale adapter —
// getStaticPaths + prop passthrough only; all fetching-once/model-building/
// rendering lives in GalleryDetailPage.astro (quick-260811-kog-04).
import type { GetStaticPaths } from 'astro';
import GalleryDetailPage from '../../components/GalleryDetailPage.astro';
import { getGalleries } from '../../lib/sanity';
import { getHomeGalleryIndex } from '../../lib/home-page-model';

export const getStaticPaths = (async () => {
  const galleries = await getGalleries();
  return galleries.map((gallery) => ({
    params: { slug: gallery.slug },
    props: { gallery, homeIndex: getHomeGalleryIndex(galleries, gallery.slug) },
  }));
}) satisfies GetStaticPaths;

const { gallery, homeIndex } = Astro.props;
---

<GalleryDetailPage gallery={gallery} locale="fr" homeIndex={homeIndex} />
