---
// English About page: mirrors the French Sanity-managed page. Only locale
// and import depth differ; the render model lives in
// src/lib/page-models.ts's buildAboutPageModel().
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutPageBody from '../../components/AboutPageBody.astro';
import { getAboutPage, getSiteSettings } from '../../lib/sanity';
import { buildAboutPageModel } from '../../lib/page-models';

const model = buildAboutPageModel({
  about: await getAboutPage(),
  siteSettings: await getSiteSettings(),
  locale: 'en',
  pageUrl: Astro.url.toString(),
});
---

<BaseLayout
  title={model.seoTitle}
  description={model.seoDescription}
  socialImage={model.socialImage}
  noIndex={model.noIndex}
  structuredData={model.structuredData as unknown as Record<string, unknown>}
>
  <AboutPageBody
    heading={model.heading}
    studioPracticeHeading={model.studioPracticeHeading}
    mediumTechniqueHeading={model.mediumTechniqueHeading}
    biography={model.biography}
    practice={model.practice}
    medium={model.medium}
    portraitImage={model.portraitImage}
    portraitAlt={model.portraitAlt}
    exhibitionImage={model.exhibitionImage}
    exhibitionAlt={model.exhibitionAlt}
  />
</BaseLayout>
