---
// English gallery detail page (PORT-01/PORT-03). Thin locale adapter —
// getStaticPaths + prop passthrough only; all fetching-once/model-building/
// rendering lives in GalleryDetailPage.astro (quick-260811-kog-04).
import type { GetStaticPaths } from 'astro';
import GalleryDetailPage from '../../../components/GalleryDetailPage.astro';
import { getGalleries } from '../../../lib/sanity';

export const getStaticPaths = (async () => {
  const galleries = await getGalleries();
  return galleries.map((gallery) => ({
    params: { slug: gallery.slug },
    props: { gallery },
  }));
}) satisfies GetStaticPaths;

const { gallery } = Astro.props;
---

<GalleryDetailPage gallery={gallery} locale="en" />
