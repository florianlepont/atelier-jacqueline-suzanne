---
// English édition detail page (EDN-03/04/06/07): one static page per édition
// slug via getStaticPaths(). Mirrors src/pages/editions/[slug].astro — only
// import depth and locale key differ. See that file's header comment for
// the full rationale (D-05/D-06/D-07/D-08, no edition.seo field).
//
// quick-260727-the: the shared markup + style block live in
// EditionDetailBody.astro; this file keeps only data-fetch + locale
// resolution + fallbacks.
import type { GetStaticPaths } from 'astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EditionDetailBody from '../../../components/EditionDetailBody.astro';
import type { GalleryGridItem } from '../../../components/GalleryGrid.astro';
import { getEditions } from '../../../lib/sanity';
import { thumbnailUrl, fullSizeUrl, responsiveImageSrcSet, responsiveThumbnailSrcSet } from '../../../lib/image';
import { getRelatedGalleryLink } from '../../../lib/related-gallery';

export const getStaticPaths = (async () => {
  const editions = await getEditions();
  return editions.map((edition) => ({
    params: { slug: edition.slug },
    props: { edition },
  }));
}) satisfies GetStaticPaths;

const { edition } = Astro.props;
const locale = 'en' as const;

const overviewHref = getRelativeLocaleUrl(locale, 'editions');

const statement = edition.statement?.[locale] ?? '';
const leadPhotoSrc = fullSizeUrl(edition.leadPhoto, 2000);
const leadPhotoSrcSet = responsiveImageSrcSet(edition.leadPhoto);
const leadPhotoAlt = edition.leadPhoto.alt?.[locale] ?? '';

// SEO built WITHOUT any seo field (edition has none) — see FR file's note.
const seoTitle = `${edition.title} — Atelier Jacqueline Suzanne`;
const seoDescription = statement;
const socialImage = fullSizeUrl(edition.leadPhoto, 1200);

// D-06: the Lightbox receives leadPhoto + images as one combined array so
// the counter total is images.length + 1.
// D-02: nullish-guarded so a partially-populated édition (images missing)
// cannot throw during getStaticPaths SSG (mirrors WR-03 in
// src/pages/galleries/[slug].astro).
const lightboxImages = [edition.leadPhoto, ...(edition.images ?? [])];
const total = lightboxImages.length;

// D-09: compact single-line format-details string (informational, not a
// product-spec table — EDN-06 boundary).
// D-02: dimensions/pageCount/printRun guarded — see FR file's note.
const dimensionsText = `${edition.dimensions?.width ?? ''} × ${edition.dimensions?.height ?? ''} ${edition.dimensions?.unit ?? ''}`;
const formatText = `Pages: ${edition.pageCount ?? ''} · Print run: ${edition.printRun ?? ''} copies · Dimensions: ${dimensionsText}`;

// quick-260724-l5i: sketch-005 Synthesis scroll-reveal hero primitives,
// computed here (locale-aware) and passed as already-localized props to
// the shared DetailHero component — see that file's header comment for
// why it never imports src/lib/image or src/lib/sanity itself.
const heroAriaLabel = `View full size, image 1 of ${total}`;
const heroCaption = 'Printed edition';
// quick-260724-wdr: locale-aware scroll-hint label passed to DetailHero (see
// that component's Props doc for why it can't localize this itself).
const scrollHintLabel = 'Scroll';

// EDN-08: optional, unidirectional cross-link to a related Portfolio
// gallery. Null on every currently-published édition today -- renders
// nothing (no placeholder) in that case.
const relatedLink = getRelatedGalleryLink(edition.relatedGallery, locale);

// D-06/D-07: NO .slice(1) here — leadPhoto is a separate field (rendered as
// the clickable hero above, data-index 0), so nothing to skip; index = i+1
// is the combined-array offset matching lightboxImages.
const gridItems: GalleryGridItem[] = (edition.images ?? []).map((img, i) => {
  const index = i + 1;
  return {
    index,
    src: thumbnailUrl(img, 600),
    srcset: responsiveThumbnailSrcSet(img),
    alt: img.alt?.[locale] ?? '',
    ariaLabel: `View full size, image ${i + 2} of ${total}`,
  };
});
---

<BaseLayout title={seoTitle} description={seoDescription} socialImage={socialImage} headerVariant="transparent">
  <EditionDetailBody
    leadPhotoSrc={leadPhotoSrc}
    leadPhotoSrcSet={leadPhotoSrcSet}
    leadPhotoAlt={leadPhotoAlt}
    title={edition.title}
    formatText={formatText}
    total={total}
    heroAriaLabel={heroAriaLabel}
    caption={heroCaption}
    statement={statement}
    scrollHintLabel={scrollHintLabel}
    overviewHref={overviewHref}
    backLinkLabel={"Back to Editions"}
    relatedLink={relatedLink}
    gridItems={gridItems}
    lightboxImages={lightboxImages}
    locale={locale}
  />
</BaseLayout>
