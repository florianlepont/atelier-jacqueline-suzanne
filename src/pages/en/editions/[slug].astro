---
// English édition detail page (EDN-03/04/06/07). Thin locale adapter —
// getStaticPaths + prop passthrough only; all fetching-once/model-building/
// rendering lives in EditionDetailPage.astro (quick-260811-kog-04).
import type { GetStaticPaths } from 'astro';
import EditionDetailPage from '../../../components/EditionDetailPage.astro';
import { getEditions } from '../../../lib/sanity';

export const getStaticPaths = (async () => {
  const editions = await getEditions();
  return editions.map((edition) => ({
    params: { slug: edition.slug },
    props: { edition },
  }));
}) satisfies GetStaticPaths;

const { edition } = Astro.props;
---

<EditionDetailPage edition={edition} locale="en" />
