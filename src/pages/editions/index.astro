---
// French Éditions overview: an asymmetric "Poster Grid" of full-bleed photo
// tiles, grouped by 3 (hero + up to 2 stacked smalls, side alternating by
// group index) — the sketch-approved layout (D-01 through D-04,
// 12-CONTEXT.md; quick task 260723-txi). Mirrors the shared "editorial page"
// shell conventions established by about.astro (top hairline + eyebrow +
// h1), but the grid itself is a genuinely new pattern — there is no
// gallery-page equivalent to mirror (12-PATTERNS.md).
// Mirrors src/pages/en/editions/index.astro — only import depth and locale
// differ; the render model lives in src/lib/page-models.ts's
// buildEditionsIndexModel().
//
// quick-260727-the: the shared markup + style block + grouping logic live
// in EditionsOverviewBody.astro; this file keeps only data-fetch + model.
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditionsOverviewBody from '../../components/EditionsOverviewBody.astro';
import { getEditions, getEditionsPage } from '../../lib/sanity';
import { buildEditionsIndexModel } from '../../lib/page-models';

const model = buildEditionsIndexModel({
  editionsPage: await getEditionsPage(),
  editions: await getEditions(),
  locale: 'fr',
});
---

<BaseLayout title={model.seoTitle} description={model.seoDescription}>
  <EditionsOverviewBody
    heading={model.heading}
    intro={model.intro}
    tiles={model.tiles}
    emptyHeading={model.emptyHeading}
    emptyBody={model.emptyBody}
    viewEditionLabel={model.viewEditionLabel}
  />
</BaseLayout>
