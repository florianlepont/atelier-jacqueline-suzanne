---
// French édition detail page (EDN-03/04/06/07): one static page per édition
// slug via getStaticPaths(). The full édition list is fetched once in
// getStaticPaths and passed as props, avoiding a second per-page fetch
// (mirrors src/pages/galleries/[slug].astro's fetch-once-pass-as-props
// convention). Mirrors the EN counterpart at
// src/pages/en/editions/[slug].astro — only import depth and locale key
// differ.
//
// quick-260801-kgh: the cover photo is now derived exactly like a gallery
// (single `images` array, `pickHeroIndex` prefers the first LANDSCAPE
// photo, falling back to images[0]) — there is no more dedicated cover
// field. `lightboxImages` is the single, unreordered `images` array; the
// grid excludes the hero by its REAL index (not a hardcoded slice/offset),
// exactly like src/pages/galleries/[slug].astro.
//
// Two remaining deliberate deviations from the gallery detail page
// (12-CONTEXT.md): D-05 the hero is clickable (opens the Lightbox at its
// real position), D-08 an in-flow "Retour aux éditions" back-link (the
// deliberate fix for the Phase 10 header-backhome-overlap-logo regression —
// never position:absolute, never inside the hero).
//
// edition has NO seo field/group (confirmed absent from
// sanity/schemas/edition.ts) — SEO title/description/social image are built
// directly from edition.title / edition.statement[locale] / the hero image
// selected by pickHeroIndex. Do not reach for a nonexistent edition.seo.
//
// quick-260727-the: the shared markup + style block live in
// EditionDetailBody.astro; this file keeps only data-fetch + locale
// resolution + fallbacks.
import type { GetStaticPaths } from 'astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditionDetailBody from '../../components/EditionDetailBody.astro';
import type { GalleryGridItem } from '../../components/GalleryGrid.astro';
import { getEditions } from '../../lib/sanity';
import { thumbnailUrl, fullSizeUrl, responsiveImageSrcSet, responsiveThumbnailSrcSet } from '../../lib/image';
import { pickHeroIndex } from '../../lib/image-orientation';
import { getRelatedGalleryLink } from '../../lib/related-gallery';

export const getStaticPaths = (async () => {
  const editions = await getEditions();
  return editions.map((edition) => ({
    params: { slug: edition.slug },
    props: { edition },
  }));
}) satisfies GetStaticPaths;

const { edition } = Astro.props;
const locale = 'fr' as const;

const overviewHref = getRelativeLocaleUrl(locale, 'editions');

const statement = edition.statement?.[locale] ?? '';

// quick-260801-kgh: mirrors src/pages/galleries/[slug].astro — prefer the
// first LANDSCAPE image as the hero, falling back to images[0] when no
// image is landscape. heroIndex is the hero's REAL array position, used
// below for the aria-label, the DetailHero trigger, and to exclude the
// hero (by its real index, not position 0) from the grid.
// D-02: nullish-guarded so a partially-populated édition (images missing)
// cannot throw during getStaticPaths SSG (mirrors WR-03 in
// src/pages/galleries/[slug].astro).
const images = edition.images ?? [];
const heroIndex = pickHeroIndex(images);
const heroImage = images[heroIndex];
const leadPhotoSrc = fullSizeUrl(heroImage, 2000);
const leadPhotoSrcSet = responsiveImageSrcSet(heroImage);
const leadPhotoAlt = heroImage.alt?.[locale] ?? '';

// SEO built WITHOUT any seo field (edition has none) — see file-level note.
const seoTitle = `${edition.title} — Atelier Jacqueline Suzanne`;
const seoDescription = statement;
const socialImage = fullSizeUrl(heroImage, 1200);

// quick-260801-kgh: the Lightbox receives the single, unreordered `images`
// array — no more combined [leadPhoto, ...images] array, so the counter
// total is simply images.length.
const lightboxImages = images;
const total = lightboxImages.length;

// D-09: compact single-line format-details string (informational, not a
// product-spec table — EDN-06 boundary).
// D-02: dimensions/pageCount/printRun guarded — see file-level note above.
const dimensionsText = `${edition.dimensions?.width ?? ''} × ${edition.dimensions?.height ?? ''} ${edition.dimensions?.unit ?? ''}`;
const formatText = `Pages : ${edition.pageCount ?? ''} · Tirage : ${edition.printRun ?? ''} exemplaires · Dimensions : ${dimensionsText}`;

// quick-260724-l5i: sketch-005 Synthesis scroll-reveal hero primitives,
// computed here (locale-aware) and passed as already-localized props to
// the shared DetailHero component — see that file's header comment for
// why it never imports src/lib/image or src/lib/sanity itself.
// quick-260801-kgh: the aria-label now announces the hero's REAL 1-based
// position (heroIndex + 1), matching the gallery detail page, so a
// screen-reader user is never told a position that disagrees with the
// Lightbox counter.
const heroAriaLabel = `Voir en taille réelle, image ${heroIndex + 1} sur ${total}`;
const heroCaption = 'Édition imprimée';
// quick-260724-wdr: locale-aware scroll-hint label passed to DetailHero (see
// that component's Props doc for why it can't localize this itself).
const scrollHintLabel = 'Faire défiler';

// EDN-08: optional, unidirectional cross-link to a related Portfolio
// gallery. Null on every currently-published édition today -- renders
// nothing (no placeholder) in that case.
const relatedLink = getRelatedGalleryLink(edition.relatedGallery, locale);

// quick-260801-kgh: the hero image is already shown full-bleed above —
// exclude it from the grid by its REAL array index (not a hardcoded
// offset), preserving every other image's own real position so grid
// clicks open the correct Lightbox slide. Mirrors
// src/pages/galleries/[slug].astro's own grid derivation, except the
// édition grid keeps its square thumbnail treatment (thumbnailUrl /
// responsiveThumbnailSrcSet, no masonry aspectRatio — see plan scope
// boundaries).
const gridItems: GalleryGridItem[] = images
  .map((img, index) => ({ img, index }))
  .filter((pair) => pair.index !== heroIndex)
  .map(({ img, index }) => ({
    index,
    src: thumbnailUrl(img, 600),
    srcset: responsiveThumbnailSrcSet(img),
    alt: img.alt?.[locale] ?? '',
    ariaLabel: `Voir en taille réelle, image ${index + 1} sur ${total}`,
  }));
---

<BaseLayout title={seoTitle} description={seoDescription} socialImage={socialImage} headerVariant="transparent">
  <EditionDetailBody
    leadPhotoSrc={leadPhotoSrc}
    leadPhotoSrcSet={leadPhotoSrcSet}
    leadPhotoAlt={leadPhotoAlt}
    title={edition.title}
    formatText={formatText}
    total={total}
    heroAriaLabel={heroAriaLabel}
    heroIndex={heroIndex}
    caption={heroCaption}
    statement={statement}
    scrollHintLabel={scrollHintLabel}
    overviewHref={overviewHref}
    backLinkLabel={"Retour aux éditions"}
    relatedLink={relatedLink}
    gridItems={gridItems}
    lightboxImages={lightboxImages}
    locale={locale}
  />
</BaseLayout>
