---
// Single canonical header (HOME-10, D-01) — extracted verbatim from
// BaseLayout.astro's former inline <header> markup/CSS. Rendered by
// BaseLayout for every non-homepage page (Plan 01); the homepage itself
// switches to rendering this same component in Plan 02.
//
// Every href/label is passed in by the caller (both call sites already
// compute these identically today) — this component only imports
// LanguageSwitcher, never getRelativeLocaleUrl/siteSettings/sanity directly,
// so it stays a pure, build-time-only, zero-hydration presentational
// component (T-10-01: no secret/token path reaches the client).
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNavPanel from './MobileNavPanel.astro';

interface Props {
  // 2-value union, not BaseLayout's 3-value headerVariant — 'none'
  // suppression stays entirely in BaseLayout's own conditional
  // (RESEARCH.md Open Question 2). SiteHeader only ever needs to know how
  // to paint a header, never whether to paint one at all.
  variant: 'solid' | 'transparent';
  siteTitle: string;
  homeHref: string;
  editionsLabel: string;
  editionsHref: string;
  aboutLabel: string;
  aboutHref: string;
  contactLabel: string;
  contactHref: string;
  instagramUrl: string;
  instagramLabel: string;
  instagramNewTabHint: string;
  logoBlackSrc: string;
  logoWhiteSrc: string;
  // D-01 (Phase 20, HOME-13): opt-in mobile-nav mode. Default false, so every
  // existing/future caller that omits it renders byte-for-byte the same
  // header as today — no attribute, no extra element, no extra CSS match, no
  // extra client script. This component is the project's documented
  // per-page-regression hotspot (Phase 16's site-wide `overflow-x` revert;
  // Phase 19's scoped-style scope-hash bug), so this new responsibility must
  // stay fully inert unless a caller explicitly opts in. Only
  // HomeCarousel.astro's single homepage call site passes `true`.
  mobileNav?: boolean;
}

const {
  variant,
  siteTitle,
  homeHref,
  editionsLabel,
  editionsHref,
  aboutLabel,
  aboutHref,
  contactLabel,
  contactHref,
  instagramUrl,
  instagramLabel,
  instagramNewTabHint,
  logoBlackSrc,
  logoWhiteSrc,
  mobileNav = false,
} = Astro.props;

// D-01: three new copy strings, resolved with the same
// `Astro.currentLocale === 'en'` locale derivation LanguageSwitcher.astro
// already uses for its own copy. Deliberate departure from this component's
// "every label is passed in by the caller" convention (see header comment
// above): threading three more required props would force an edit at every
// existing call site, which is exactly the blast radius D-01's inertness
// requirement exists to avoid — and LanguageSwitcher.astro, already a child
// of this component, is the in-repo precedent for a nested component
// deriving its own locale-conditional copy rather than receiving it as a
// prop. Resolved unconditionally (cheap, no DOM/IO) but only ever rendered
// below when `mobileNav` is true.
const isEnLocale = Astro.currentLocale === 'en';
const openMenuLabel = isEnLocale ? 'Open menu' : 'Ouvrir le menu';
const closeMenuLabel = isEnLocale ? 'Close menu' : 'Fermer le menu';
const menuLabel = 'Menu';
---

<header
  class:list={['chrome-band', 'site-header', `site-header--${variant}`]}
  data-role="site-header"
  data-mobile-nav={mobileNav ? 'true' : undefined}
>
  <a href={homeHref} class="logo-mark" aria-label={siteTitle}>
    <span class="logo-mark__chip" aria-hidden="true"></span>
    <img src={logoBlackSrc} alt="" class="logo-mark__img logo-mark__img--default" />
    <img src={logoWhiteSrc} alt="" class="logo-mark__img logo-mark__img--hover" />
  </a>
  <nav class="site-nav" aria-label="Primary">
    {/* EDN-01/D-01: Éditions renders FIRST, highest visual nav priority —
        before the existing About/Contact links. Reuses .nav-link verbatim,
        no new class/active-state treatment (13-UI-SPEC.md). */}
    <a href={editionsHref} class="nav-link">{editionsLabel}</a>
    <a href={aboutHref} class="nav-link">{aboutLabel}</a>
    <a href={contactHref} class="nav-link">{contactLabel}</a>
    {/* Instagram link — moved in verbatim from HomeCarousel.astro (D-03), so
        it now renders on every page, not just the homepage. */}
    <a
      href={instagramUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="nav-link"
      aria-label={`Instagram ${instagramLabel}`}
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
        <circle cx="12" cy="12" r="4.6" />
        <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
      </svg>
      <span class="sr-only">{instagramNewTabHint}</span>
    </a>
  </nav>
  {/* D-04: reserved for the homepage's carousel/grid mode-toggle (Plan 02) —
      empty on every other page. */}
  <slot name="extra" />
  <LanguageSwitcher />
  {mobileNav && (
    /* D-01/HOME-13 (Phase 20 Plan 03): the hamburger toggle, last child so
       it lands at the far right of the flex row, matching the reference
       image. Rendered ONLY when mobileNav is true — inert everywhere else.
       No id, no inline styles: `aria-controls`/CSS both key off `#mobile-nav`
       and the `.mobile-nav__toggle` class defined below. */
    <button
      type="button"
      class="mobile-nav__toggle"
      data-role="mobile-nav-toggle"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label={openMenuLabel}
    >
      <span class="mobile-nav__bars" aria-hidden="true">
        <span class="mobile-nav__bar"></span>
        <span class="mobile-nav__bar"></span>
        <span class="mobile-nav__bar"></span>
      </span>
    </button>
  )}
</header>
{mobileNav && (
  /* D-01/T-20-06: rendered as a SIBLING of <header>, never a descendant —
     i18n.spec.ts, homepage-carousel-core.spec.ts and site-header.spec.ts all
     assert header-scoped counts of exactly 1 switcher link and exactly 1
     Éditions link; nesting the dialog inside <header> would break those. */
  <MobileNavPanel
    homeHref={homeHref}
    siteTitle={siteTitle}
    editionsLabel={editionsLabel}
    editionsHref={editionsHref}
    aboutLabel={aboutLabel}
    aboutHref={aboutHref}
    contactLabel={contactLabel}
    contactHref={contactHref}
    instagramUrl={instagramUrl}
    instagramLabel={instagramLabel}
    instagramNewTabHint={instagramNewTabHint}
    logoBlackSrc={logoBlackSrc}
    closeMenuLabel={closeMenuLabel}
    menuLabel={menuLabel}
  />
)}

<style is:global>
  /* Relocated from BaseLayout.astro (RESEARCH.md Pattern 3 / this plan's
     "SCOPING GOTCHA" note): the <header> now renders from this component,
     leaving BaseLayout's own scoped-style scope, so .chrome-band's header
     padding must live in an is:global block to keep reaching it. Global CSS
     still applies to the footer's own `footer.chrome-band` element too
     (BaseLayout.astro keeps that selector's border-top rule scoped there —
     unaffected, since is:global rules apply site-wide regardless of which
     component defines them). */
  .chrome-band {
    padding: var(--space-lg) var(--space-md);
  }

  @media (min-width: 768px) {
    .chrome-band {
      padding: var(--space-xl) var(--space-md);
    }
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    transition: background-color 0.35s ease, color 0.35s ease;
  }

  /* quick-260724-uf5 (sketch 006): deliberately REUSES the exact same
     `ajs-header` name HomeCarousel.astro's own `.home`-scoped global override
     of `.site-header` rule already assigns to this same element (that more-specific homepage
     rule wins on the homepage, but sets the IDENTICAL value, so there is no
     conflict). Everywhere else (gallery/edition/about/contact) this newly
     lets the header participate as a persistent, named element in
     cross-document View Transitions, so it stays put across a navigation
     instead of crossfading. A second/different name must NOT be invented
     here — a mismatch between the source and destination documents' names
     would make the header crossfade instead of persist. Do not modify
     HomeCarousel.astro's own rule or its `ajs-header` value. */
  .site-header {
    view-transition-name: ajs-header;
  }

  .site-header--solid {
    background-color: var(--color-dominant);
    color: var(--color-ink);
    border-bottom: var(--border-hairline) solid var(--color-border);
  }

  /* D-07/Plan 04.1-05: absolutely-positioned, transparent/gradient header
     over a hero photo scrim — no hairline border (the scrim itself is the
     delineation). Nav text renders white in this variant. */
  .site-header--transparent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.25) 60%, rgba(0, 0, 0, 0) 100%);
    color: #FFFFFF;
  }

  /* Header links are neutral chrome, not accent actions. Keep every link,
     including LanguageSwitcher.astro's locally-styled link, aligned with
     the variant's contrast color. The repeated .site-header class raises
     specificity above the switcher's scoped accent-color declaration. */
  .site-header.site-header--solid .nav-link,
  .site-header.site-header--solid .switcher-link,
  .site-header.site-header--transparent .nav-link,
  .site-header.site-header--transparent .switcher-link {
    color: inherit;
  }

  /* D-11/D-13/RESEARCH.md Pattern 3 (revised per logo-hover-and-font debug
     session): two normal-flow <img> elements, hard display:none/block swap
     on hover — matches the reference site's own hover MECHANIC exactly
     (verified byte-for-byte against its compiled CSS: `.image-link` is
     `display: inline-block`, `.image-rollover` is `display: none` by
     default, swapped on hover, no transition/opacity). Deliberately NOT
     absolutely-positioned: an earlier version of this fix stacked the hover
     image with `position: absolute` while the default image used
     `display: none` on hover, which collapsed `.logo-mark`'s own box to 0x0
     (no in-flow child left) and shifted the sibling nav layout on hover.
     Both logo PNGs share the same intrinsic aspect ratio, so swapping which
     one is in-flow causes no layout jump.

     The dark `__chip` backdrop is KEPT (unlike the original fix plan) but
     changed from an opacity-fade to the same instant display:none/block
     toggle as the images — verified by downloading the reference site's own
     rollover PNG asset (not just its CSS) that its "hover" logo has an
     opaque black background baked directly into the image file, which is
     how it stays legible over the white header. Our white logo variant
     (AJS_Brutalist_White_Transparent.png) is transparent, so without an
     instant backdrop behind it, the hover state is nearly invisible against
     a light header — reproducing the reference's CSS literally without this
     would visually regress legibility versus both the reference site and
     the pre-fix implementation. */
  .logo-mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-mark__chip {
    position: absolute;
    inset: calc(-1 * var(--space-sm));
    background-color: var(--color-ink);
    border-radius: var(--radius-none);
    display: none;
    z-index: 0;
  }

  .logo-mark__img {
    position: relative;
    z-index: 1;
    display: block;
    width: 56px;
    height: auto;
  }

  .logo-mark__img--hover {
    display: none;
  }

  /* Solid header: default = black logo; hover/focus-within hard-swaps to the
     white variant over the instantly-shown dark chip, no transition. */
  .site-header--solid .logo-mark:hover .logo-mark__img--default,
  .site-header--solid .logo-mark:focus-within .logo-mark__img--default {
    display: none;
  }

  .site-header--solid .logo-mark:hover .logo-mark__img--hover,
  .site-header--solid .logo-mark:focus-within .logo-mark__img--hover,
  .site-header--solid .logo-mark:hover .logo-mark__chip,
  .site-header--solid .logo-mark:focus-within .logo-mark__chip {
    display: block;
  }

  /* Transparent header (revised per logo-hover-and-font debug session, Round
     2): white logo variant shown by default (over the dark scrim already
     provided by the header background) — unchanged. Hover/focus-within now
     hard-swaps to the BLACK variant, same mechanic as the solid header, but
     with a LIGHT chip instead of the solid header's dark chip — the black
     hover-logo would be invisible against both the dark scrim and a dark
     chip, so the backdrop color must flip with the logo color, not stay
     fixed. Used on gallery-detail pages (dark hero background) as well as
     any other transparent-header page. */
  .site-header--transparent .logo-mark__img--default {
    display: none;
  }

  .site-header--transparent .logo-mark__img--hover {
    display: block;
  }

  .site-header--transparent .logo-mark:hover .logo-mark__img--hover,
  .site-header--transparent .logo-mark:focus-within .logo-mark__img--hover {
    display: none;
  }

  .site-header--transparent .logo-mark:hover .logo-mark__img--default,
  .site-header--transparent .logo-mark:focus-within .logo-mark__img--default,
  .site-header--transparent .logo-mark:hover .logo-mark__chip,
  .site-header--transparent .logo-mark:focus-within .logo-mark__chip {
    display: block;
  }

  /* Mode-aware chip color: solid header's chip (behind the white hover-logo)
     stays dark (--color-ink, the base .logo-mark__chip rule above) — this
     override only applies inside the transparent header, behind the black
     hover-logo, so it must be light instead. */
  .site-header--transparent .logo-mark__chip {
    background-color: var(--color-dominant);
  }

  .site-nav {
    margin-right: auto;
    margin-left: var(--space-md);
    display: flex;
    gap: var(--space-md);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target-min);
    padding: var(--space-xs) var(--space-sm);
    font-size: 14px; /* Label role */
    font-weight: var(--weight-regular);
    line-height: 1.5;
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    text-decoration: underline;
  }

  /* D-01 (Phase 20 Plan 03): the hamburger toggle and the 3-bar glyph it
     shares with MobileNavPanel.astro's own close button (Pattern 3 — one CSS
     definition drives both, so plan 20-04 can morph either instance into an
     X with `transform` alone). `display: none` is the BASE state at every
     width; only the phone media query below opts it in, so this rule is
     inert on every page that doesn't render a hamburger at all. */
  .mobile-nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: var(--tap-target-min);
    min-height: var(--tap-target-min);
    padding: 0;
    background: none;
    border: none;
    /* color: inherit is load-bearing: it's what makes the bars white over
       the carousel hero and ink in grid mode via HomeCarousel's existing
       per-mode header re-skin below, with no new mode-specific rule. */
    color: inherit;
    cursor: pointer;
  }

  .mobile-nav__bars {
    position: relative;
    display: block;
    width: 22px;
    height: 16px;
  }

  /* Absolute positioning (rather than flex spacing) is deliberate: plan
     20-04 morphs these three bars into an X with `transform` alone, which
     needs a stable, layout-independent origin per bar. */
  .mobile-nav__bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
  }

  .mobile-nav__bar:nth-child(1) {
    top: 0;
  }

  .mobile-nav__bar:nth-child(2) {
    top: 7px;
  }

  .mobile-nav__bar:nth-child(3) {
    top: 14px;
  }

  .mobile-nav__toggle:focus-visible,
  .mobile-nav-panel__close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Ported forward from HomeCarousel.astro's own live-tested mobile
     pixel-budget CSS (RESEARCH.md Pitfall 1/Pattern Map) — BaseLayout's
     header has never had mobile-specific CSS before (it only ever carried 4
     flex items). Now that Instagram is a 3rd .nav-link on every page
     (D-03), About/Contact/gallery-detail need the same wrap/gap trims the
     homepage already relies on. */
  @media (max-width: 767px) {
    .site-header {
      flex-wrap: nowrap;
      gap: var(--space-xs);
    }

    .site-nav {
      margin-left: 0;
      gap: var(--space-xs);
    }

    .site-nav .nav-link {
      padding-left: var(--space-xs);
      padding-right: var(--space-xs);
    }
  }

  /* D-01/RESEARCH.md Open Question 2 (resolved): a SEPARATE media block, not
     merged into the one above, so every page that doesn't pass mobileNav
     keeps the existing 767px/400px trims exactly as-is. When mobileNav is
     true, the header's own inline nav row and inline language switcher hide
     entirely at phone widths — only the hamburger shows. The direct-child
     combinator on the switcher rule is documentation as much as safety: the
     panel's own switcher (rendered inside MobileNavPanel.astro, a sibling of
     <header>) is never a `.site-header > .language-switcher`, so it can
     never be caught by this rule. */
  @media (max-width: 767px) {
    .site-header[data-mobile-nav='true'] .site-nav {
      display: none;
    }

    .site-header[data-mobile-nav='true'] > .language-switcher {
      display: none;
    }

    .site-header[data-mobile-nav='true'] .mobile-nav__toggle {
      display: inline-flex;
    }
  }

  /* Keep the full navigation usable on genuinely narrow phones without a
     second header row or horizontal scrolling. Every control retains its
     44px vertical tap target; only horizontal padding and icon/logo width
     are tightened. */
  @media (max-width: 400px) {
    .chrome-band {
      padding: var(--space-sm);
    }

    .site-header {
      flex-wrap: nowrap;
      gap: 0;
    }

    .logo-mark__img {
      width: 40px;
    }

    .site-nav {
      min-width: 0;
      margin-left: var(--space-xs);
      gap: 0;
    }

    .site-nav .nav-link {
      min-width: 0;
      padding-right: 2px;
      padding-left: 2px;
      font-size: 12px;
    }

    .site-nav .nav-link svg {
      width: 18px;
      height: 18px;
    }

    .site-header .language-switcher .switcher-link {
      padding-right: 2px;
      padding-left: 2px;
      font-size: 12px;
    }
  }

  /* D-01/D-02 (Phase 20 Plan 03): the mobile-nav panel shell, copying
     Lightbox.astro's `dialog#lightbox` sizing shape exactly (verified in
     this codebase to already defeat the UA's default centered/
     intrinsically-sized <dialog> box model). All four sizing declarations
     below are required: the two max-* values are what defeat that default
     regardless of the dialog's own content size.
     Phase 20 Plan 04 (D-03): the open/close motion. `display`/`overlay`
     with `allow-discrete` are what let a top-layer element animate in at
     all rather than appearing instantly — this is the whole open
     animation, driven by CSS alone via the entry-state at-rule block
     below, no JS involved. */
  .mobile-nav-panel {
    padding: 0;
    border: none;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    background: var(--color-dominant);
    color: var(--color-ink);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 220ms ease, transform 220ms ease, display 220ms allow-discrete, overlay 220ms allow-discrete;
  }

  /* An unconditional `display` on the base rule would beat the UA's own
     `:not([open])` rule regardless of specificity (author origin always
     wins) — so the display rules are split, same shape as Lightbox.astro's
     `dialog#lightbox[open]`/`:not([open])` pair. */
  .mobile-nav-panel[open] {
    display: flex;
    flex-direction: column;
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-nav-panel:not([open]) {
    display: none;
  }

  /* This is the entire open animation — no JS drives it. Safari/WebKit
     ships this entry-state at-rule but not the paired overlay allow-discrete
     behaviour needed to animate a top-layer element OUT, so the close
     direction is driven from JS (MobileNavPanel.astro's client script) on
     every engine instead, to keep behaviour uniform rather than silently
     engine-dependent. */
  @starting-style {
    .mobile-nav-panel[open] {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  /* The reverse state the client script's close funnel waits on
     (transitionend) before calling panel.close(). */
  .mobile-nav-panel[open].is-closing {
    opacity: 0;
    transform: translateY(-8px);
  }

  /* The panel is opaque and fills the viewport, so the backdrop only ever
     shows through during the open/close transition above — safe against a
     visible seam because it is the same --color-dominant white as the
     panel itself. */
  .mobile-nav-panel::backdrop {
    background: var(--color-dominant);
  }

  /* Plan 20-05 (D-02, T-20-10): the panel's decorative halftone texture,
     reusing PageTitleHeader.astro's exact `.page-title-header__halftone`
     radial-gradient/background-size dot values verbatim for visual
     consistency, but with FRESH containment geometry re-derived for this
     dialog's own 100vw/100vh box (RESEARCH.md Open Question 1) rather than
     porting that component's viewport-relative centering constants, which
     are tuned for a content-column-relative element, not a full-viewport
     dialog. Bounded `min()` sizing anchored at the dialog's own top-right
     corner is the ENTIRE containment strategy, deliberately not paired
     with any clipping rule of any kind (see PageTitleHeader.astro's own
     history comment for why this codebase treats that class of fix as
     unsafe against unrelated sticky-positioned elements sharing the same
     document). A box inset this way has nowhere to spill outside itself. */
  .mobile-nav-panel__halftone {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 0;
    pointer-events: none;
    width: min(100vw, 320px);
    height: min(100vh, 320px);
    background-image: radial-gradient(rgba(26, 26, 26, 0.16) 1.4px, transparent 1.6px);
    background-size: 9px 9px;
    /* Fades the dot field out toward the panel's interior from its own
       top-right corner — same multi-stop opacity ramp shape as
       PageTitleHeader.astro's mask, expressed in THIS element's own
       coordinates (no `--editorial-page-*` term, no `50vw` centering term:
       this box is already anchored at the dialog's corner, not resolving
       against the viewport). */
    -webkit-mask-image: radial-gradient(circle 300px at top right, black 0%, rgba(0, 0, 0, 0.72) 18%, rgba(0, 0, 0, 0.42) 40%, rgba(0, 0, 0, 0.18) 65%, rgba(0, 0, 0, 0.05) 85%, transparent 100%);
    mask-image: radial-gradient(circle 300px at top right, black 0%, rgba(0, 0, 0, 0.72) 18%, rgba(0, 0, 0, 0.42) 40%, rgba(0, 0, 0, 0.18) 65%, rgba(0, 0, 0, 0.05) 85%, transparent 100%);
    opacity: 0;
    /* Deliberately distinct keyframe names from PageTitleHeader's own
       equivalent pair — both rule sets live in the same global stylesheet,
       and a name collision there would silently rebind one component's
       animation to the other's timing. */
    animation:
      mobile-nav-halftone-fade-in 0.6s ease 0.15s forwards,
      mobile-nav-halftone-drift 10s linear infinite;
  }

  @keyframes mobile-nav-halftone-fade-in {
    to { opacity: 1; }
  }

  @keyframes mobile-nav-halftone-drift {
    from { background-position: 0 0; }
    to { background-position: 90px 45px; }
  }

  /* The logo must land in the SAME screen position as the closed header's
     logo, which means matching .chrome-band's own padding at both phone
     breakpoints (see the @media (max-width: 400px) override below). Explicit
     stacking (position: relative + z-index: 1, mirrored on .mobile-nav-panel__nav,
     .mobile-nav-panel > .language-switcher (20-06) and
     .mobile-nav-panel__secondary below) keeps the content above the
     absolutely-positioned halftone: without it, a positioned element with
     z-index: auto still paints AFTER non-positioned in-flow content in the
     same stacking context, putting the dot field over 32px Unbounded text. */
  .mobile-nav-panel__bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg) var(--space-md);
  }

  .mobile-nav-panel__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .mobile-nav-panel__logo-img {
    display: block;
    width: 56px; /* matches .logo-mark__img */
    height: auto;
  }

