---
// Shared fr/en Édition detail page body (quick-260727-the): holds the
// entire `<div class="edition-detail">` markup PLUS the sibling
// `<Lightbox />` element, plus the byte-identical style block previously
// duplicated across src/pages/editions/[slug].astro and
// src/pages/en/editions/[slug].astro. All locale-resolved data +
// locale-specific visible strings arrive as props; no i18n/data-fetch
// logic lives here.
import DetailHero from './DetailHero.astro';
import GalleryGrid, { type GalleryGridItem } from './GalleryGrid.astro';
import Lightbox from './Lightbox.astro';
import type { GalleryImage } from '../lib/sanity';

interface Props {
  leadPhotoSrc: string;
  leadPhotoSrcSet: string;
  leadPhotoAlt: string;
  title: string;
  formatText: string;
  total: number;
  heroAriaLabel: string;
  heroIndex: number;
  caption: string;
  statement: string;
  scrollHintLabel: string;
  // quick-260803-bvu (Item 6): overviewHref is now ALSO the scroll-up-to-
  // return gesture's destination (passed to DetailHero as
  // carouselReturnHref below) — no longer just the back-link's href, since
  // the back-link itself is gone (see the content div below).
  overviewHref: string;
  relatedLink: { href: string; text: string } | null;
  gridItems: GalleryGridItem[];
  lightboxImages: GalleryImage[];
  contactCtaHref: string;
  contactCtaLabel: string;
  locale: 'fr' | 'en';
}

const {
  leadPhotoSrc,
  leadPhotoSrcSet,
  leadPhotoAlt,
  title,
  formatText,
  total,
  heroAriaLabel,
  heroIndex,
  caption,
  statement,
  scrollHintLabel,
  overviewHref,
  relatedLink,
  gridItems,
  lightboxImages,
  contactCtaHref,
  contactCtaLabel,
  locale,
} = Astro.props;
---

<div class="edition-detail">
  <DetailHero
    leadPhotoSrc={leadPhotoSrc}
    leadPhotoSrcSet={leadPhotoSrcSet}
    leadPhotoAlt={leadPhotoAlt}
    title={title}
    formatText={formatText}
    total={total}
    heroAriaLabel={heroAriaLabel}
    heroIndex={heroIndex}
    caption={caption}
    statement={statement}
    scrollHintLabel={scrollHintLabel}
    carouselReturnHref={overviewHref}
    editionVariant
    editionPanel
    accent="#FFFFFF"
    accentText="#1A1A1A"
    desktopAccent="#1A1A1A"
    desktopAccentText="#FFFFFF"
  />
  <div class="edition-detail__content">
    {/* quick-260803-bvu (Item 5): the format-details line used to be
        rendered TWICE — once here (decorative, aria-hidden, inside
        DetailHero's reveal panel) and once as this real paragraph. The
        duplicate is gone; DetailHero's own reveal-panel copy (now with
        aria-hidden removed) is the single accessible instance, visible on
        both desktop and mobile. */}
    {/* quick-260803-bvu (Item 6): the "Retour aux éditions" link that used
        to open this div is gone — the scroll-up-to-return gesture (wired
        above via carouselReturnHref={overviewHref}) is now the deliberate
        replacement, confirmed live to arm reliably at both desktop and
        mobile widths on every currently-published édition. No
        absolutely-positioned replacement affordance was added in its
        place: that is exactly the Phase 10 header/logo-overlap regression
        this link's original in-flow placement (D-08) was built to avoid,
        and reintroducing an absolutely-positioned link here would risk it
        again. Browser back and the header nav remain the documented exits
        for a visitor who never triggers the gesture. */}
    {relatedLink && (
      <a class="edition-detail__related" href={relatedLink.href}>
        {relatedLink.text}
      </a>
    )}
    {/* quick-260803-jby: masonry now selected explicitly here, matching
        GalleryDetailBody.astro's own call site — see GalleryGrid.astro's
        `layout` prop comment for why its bento default is no longer the
        mechanism either real caller relies on. */}
    {gridItems.length > 0 && <GalleryGrid items={gridItems} layout="masonry" />}
    {/* CONT-04: unconditional contact CTA, last child of .edition-detail__content,
        after the grid — D-07. Shares structure/copy/styling with the gallery-page
        CTA (one shared string, D-06); its own .edition-detail__ scoped class names
        cannot cascade onto the sibling .edition-detail__related link above (D-09). */}
    <div class="edition-detail__contact-cta-zone">
      <div class="edition-detail__contact-cta-rule"></div>
      <a class="edition-detail__contact-cta" href={contactCtaHref}>
        {contactCtaLabel}
        <span class="edition-detail__contact-cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>
<Lightbox images={lightboxImages} locale={locale} />

<style>
  .edition-detail {
    padding: 0 0 var(--space-2xl);
  }

  .edition-detail__content {
    padding: var(--space-2xl) var(--space-md) 0;
  }

  /* EDN-08: compact cross-link to a related gallery. It deliberately uses
     the same framed CTA on every viewport so the collection is visible
     without competing with the edition's format line or image grid. */
  .edition-detail__related {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    padding: 10px var(--space-md);
    font-size: var(--text-label-size);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    border: 2px solid currentColor;
    margin: 0 0 var(--space-2xl);
  }

  .edition-detail__related::after {
    content: '→';
    flex: none;
    font-size: 20px;
    line-height: 1;
  }

  .edition-detail__related:hover,
  .edition-detail__related:focus-visible {
    color: var(--color-accent);
    outline: 2px solid var(--color-accent);
    outline-offset: var(--focus-ring-offset);
  }

  @media (max-width: 767px) {
    .edition-detail__content {
      padding-top: var(--space-sm);
    }

    .edition-detail__related {
      max-width: 100%;
      margin: 0 0 var(--space-xl);
    }
  }

  /* CONT-04: contact CTA closing the photo sequence, sketch 018 Variant B.
     Literal 20px/600/1.25 values are pinned to the sketch's own reference,
     not the numerically-coincidental --text-heading-* tokens (UI-SPEC.md). */
  .edition-detail__contact-cta-zone {
    padding-top: var(--space-2xl);
  }

  .edition-detail__contact-cta-rule {
    border-top: 1px solid var(--pink-600);
    width: 48px;
    margin-bottom: var(--space-md);
  }

  .edition-detail__contact-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.25;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .edition-detail__contact-cta-arrow {
    color: var(--pink-600);
    font-size: 20px;
    transition: transform 0.15s ease;
  }

  .edition-detail__contact-cta:hover,
  .edition-detail__contact-cta:focus-visible {
    border-bottom-color: var(--color-ink);
  }

  .edition-detail__contact-cta:hover .edition-detail__contact-cta-arrow,
  .edition-detail__contact-cta:focus-visible .edition-detail__contact-cta-arrow {
    transform: translateX(4px);
  }
</style>
