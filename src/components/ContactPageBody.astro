---
// Shared fr/en Contact page body (quick-260727-the): holds the entire
// `<div class="contact-page">` markup plus the byte-identical style block
// previously duplicated across src/pages/contact.astro and
// src/pages/en/contact.astro. All locale-resolved data + locale-specific
// visible strings arrive as props; no i18n/data-fetch logic lives here.
//
// quick-260728-ek0: rebuilt to sketch-012 variant A3 ("Grand titre, sans
// scroll") — giant display title, one-viewport-tall centered desktop
// composition, hairline-bordered form panel (no offset shadow). See
// .planning/sketches/012-contact-page-composition/README.md.
import ContactForm from './ContactForm.astro';
import PageTitleHeader from './PageTitleHeader.astro';

interface Props {
  locale: 'fr' | 'en';
  intro: string;
  publicEmail: string;
  location?: string;
  availability?: string;
  instagramLink?: { url: string; label: string } | null;
  otherLinks: { url: string; label: string }[];
  emailLabel: string;
  formHeading: string;
  formSubheading: string;
  newTabHint: string;
}

const {
  locale,
  intro,
  publicEmail,
  location,
  availability,
  instagramLink,
  otherLinks,
  emailLabel,
  formHeading,
  formSubheading,
  newTabHint,
} = Astro.props;
---

<div class="contact-page">
  <PageTitleHeader heading="Contact" headingId="contact-title" intro={intro} />

  <div class="contact-page__grid">
    <div class="contact-page__left">
      <div class="contact-page__channels">
        <a class="contact-page__detail" href={`mailto:${publicEmail}`}>
          <span class="contact-page__detail-inner">
            <span class="contact-page__label">{emailLabel}</span>
            <span class="contact-page__arrow" aria-hidden="true">↗</span>
          </span>
          <span class="contact-page__value">{publicEmail}</span>
        </a>
        {instagramLink && (
          <a
            class="contact-page__detail contact-page__social"
            href={instagramLink.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-page__detail-inner">
              <span class="contact-page__label">Instagram</span>
              <span class="contact-page__arrow" aria-hidden="true">↗</span>
            </span>
            <span class="contact-page__value">{instagramLink.label}</span>
            <span class="sr-only">{newTabHint}</span>
          </a>
        )}
      </div>
      {(location || availability) && (
        <div class="contact-page__meta">
          {location && <p>{location}</p>}
          {availability && <p>{availability}</p>}
        </div>
      )}
      {otherLinks.length > 0 && (
        <ul class="contact-page__links">
          {otherLinks.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.label}<span class="sr-only">{newTabHint}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <section class="contact-page__form-panel" aria-labelledby="contact-form-title">
      <h2 id="contact-form-title">{formHeading}</h2>
      <p class="contact-page__form-sub">{formSubheading}</p>
      <ContactForm locale={locale} publicEmail={publicEmail} />
    </section>
  </div>
</div>

<style>
  /* Same top-anchored positioning as Éditions' .editions-list (not
     vertically centered) — title/eyebrow land at the exact same distance
     from the site header on both pages (padding-top is identical, width-
     based, matching Éditions exactly — that's what the title/eyebrow/line
     alignment actually depends on). padding-bottom deliberately stays
     height-responsive (unlike Éditions' fixed 7vw) — Éditions doesn't care
     since it already scrolls; here a fixed ~96px bottom pad reintroduced
     70px of scroll at 768px-tall viewports since nothing else shrinks to
     compensate for it anymore now that centering is gone. */
  .contact-page {
    --color-accent: var(--color-ink);

    width: min(100%, var(--editorial-page-max));
    margin: 0 auto;
    box-sizing: border-box;
    padding-inline: var(--editorial-page-padding-inline);
    padding-top: clamp(48px, 7vw, 56px);
    padding-bottom: clamp(16px, 3vh, 96px);
  }

  /* PageTitleHeader.astro owns the header/eyebrow/h1/intro/halftone markup
     and styling now — shared byte-for-byte with the Éditions overview page
     (sketch-012 F1), so the two can never drift out of alignment again —
     including the halftone's -700px bleed, completely unclipped, same as
     Éditions. Clipping it at any container narrower than the viewport
     (.page-title-header, then .contact-page) kept falling short of
     Éditions' actual reach, since .contact-page itself is inset from the
     real page edge (max-width + centering). Solved at the source instead:
     clip vertical overflow at <body> (see the :global(body) rule below),
     which spans the full viewport width — so the halftone reaches exactly
     as far right as it does on Éditions, with no container narrower than
     the viewport ever clipping it. */

  /* Guarantees no vertical scroll on desktop regardless of the halftone's
     unclipped bleed, WITHOUT touching horizontal overflow (the halftone
     still reaches the true right edge of the viewport, matching Éditions).
     Explicitly scoped to min-width:800px — mobile MUST keep real scrolling
     (stacked layout is legitimately taller than the viewport there; this
     is not the "content might overflow" edge case below, it's expected,
     everyday mobile content). Verified directly: without this guard,
     overflow-y:hidden still measured as computed on mobile in testing, yet
     window.scrollTo() kept working there anyway (Chromium quirk not fully
     understood) — not something to depend on. The @media guard removes all
     doubt regardless of that.
     Trade-off on desktop: this is a hard clip, not a "content naturally
     fits" budget — verified 0px overflow and full submit-button visibility
     at 650-1080px+ height across both locales, but at some untested
     viewport/font-rendering combination content could clip and become
     unreachable rather than scrollable. Scoped via :global() so it only
     loads in the bundle for pages using ContactPageBody (same pattern as
     EditionsOverviewBody's :global(html.editions-row-active) rules).
  */
  @media (min-width: 800px) {
    :global(html:has(.contact-page)),
    :global(body:has(.contact-page)) {
      overflow-y: hidden;
    }
  }

  .contact-page__grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(18px, 2.6vw, 40px);
    align-items: start;
    /* Same hairline weight/color as the line below the Éditions title
       (.editions-index__row:first-of-type) — full-width here, since
       Contact's content below the header is a two-column grid, not a
       row list. */
    border-top: var(--border-hairline) solid var(--color-ink);
  }

  .contact-page__channels {
    display: grid;
  }

  .contact-page__detail {
    position: relative;
    display: block;
    padding: clamp(6px, 1.1vh, 12px) 0;
    border-bottom: var(--border-hairline) solid var(--color-border);
    color: var(--color-ink);
    text-decoration: none;
    overflow: hidden;
  }

  .contact-page__detail::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-ink);
    transform: translateX(-101%);
    transition: transform 320ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .contact-page__detail:hover::before,
  .contact-page__detail:focus-visible::before {
    transform: translateX(0);
  }

  .contact-page__detail-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .contact-page__detail:hover .contact-page__detail-inner,
  .contact-page__detail:focus-visible .contact-page__detail-inner,
  .contact-page__detail:hover .contact-page__value,
  .contact-page__detail:focus-visible .contact-page__value {
    color: var(--gray-0);
  }

  .contact-page__label,
  .contact-page__arrow {
    font-size: 10px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .contact-page__detail:hover .contact-page__label,
  .contact-page__detail:focus-visible .contact-page__label {
    opacity: 0.85;
  }

  .contact-page__value {
    position: relative;
    z-index: 1;
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(13px, 1.2vw, 16px);
  }

  .contact-page__meta {
    margin-top: clamp(6px, 1.2vh, 14px);
    font-size: 11px;
    line-height: 1.5;
    color: #6b6b6b;
  }

  .contact-page__meta p {
    margin: 0;
  }

  .contact-page__meta p + p {
    margin-top: 4px;
  }

  .contact-page__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-page__form-panel {
    padding: clamp(var(--space-md), 2vh, var(--space-xl));
    border: var(--border-hairline) solid var(--color-ink);
  }

  .contact-page__form-panel h2 {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.1;
  }

  .contact-page__form-sub {
    margin: 0 0 clamp(14px, 2.4vh, 22px);
    font-size: 13px;
    color: #6b6b6b;
  }

  @media (max-width: 800px) {
    .contact-page__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
