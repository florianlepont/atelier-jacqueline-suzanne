---
// Shared fr/en Contact page body (quick-260727-the): holds the entire
// `<div class="contact-page">` markup plus the byte-identical style block
// previously duplicated across src/pages/contact.astro and
// src/pages/en/contact.astro. All locale-resolved data + locale-specific
// visible strings arrive as props; no i18n/data-fetch logic lives here.
//
// quick-260728-ek0: rebuilt to sketch-012 variant A3 ("Grand titre, sans
// scroll") — giant display title, one-viewport-tall centered desktop
// composition, hairline-bordered form panel (no offset shadow). See
// .planning/sketches/012-contact-page-composition/README.md.
import ContactForm from './ContactForm.astro';

interface Props {
  locale: 'fr' | 'en';
  intro: string;
  publicEmail: string;
  location?: string;
  availability?: string;
  instagramLink?: { url: string; label: string } | null;
  otherLinks: { url: string; label: string }[];
  emailLabel: string;
  formHeading: string;
  formSubheading: string;
  newTabHint: string;
}

const {
  locale,
  intro,
  publicEmail,
  location,
  availability,
  instagramLink,
  otherLinks,
  emailLabel,
  formHeading,
  formSubheading,
  newTabHint,
} = Astro.props;
---

<div class="contact-page">
  <section class="contact-page__header" aria-labelledby="contact-title">
    <div class="contact-page__halftone" aria-hidden="true"></div>
    <div class="contact-page__titleblock">
      <p class="contact-page__eyebrow">Atelier Jacqueline Suzanne</p>
      <h1 id="contact-title">Contact</h1>
    </div>
    <p class="contact-page__lead">{intro}</p>
  </section>

  <div class="contact-page__grid">
    <div class="contact-page__left">
      <div class="contact-page__channels">
        <a class="contact-page__detail" href={`mailto:${publicEmail}`}>
          <span class="contact-page__detail-inner">
            <span class="contact-page__label">{emailLabel}</span>
            <span class="contact-page__arrow" aria-hidden="true">↗</span>
          </span>
          <span class="contact-page__value">{publicEmail}</span>
        </a>
        {instagramLink && (
          <a
            class="contact-page__detail contact-page__social"
            href={instagramLink.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-page__detail-inner">
              <span class="contact-page__label">Instagram</span>
              <span class="contact-page__arrow" aria-hidden="true">↗</span>
            </span>
            <span class="contact-page__value">{instagramLink.label}</span>
            <span class="sr-only">{newTabHint}</span>
          </a>
        )}
      </div>
      {(location || availability) && (
        <div class="contact-page__meta">
          {location && <p>{location}</p>}
          {availability && <p>{availability}</p>}
        </div>
      )}
      {otherLinks.length > 0 && (
        <ul class="contact-page__links">
          {otherLinks.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.label}<span class="sr-only">{newTabHint}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <section class="contact-page__form-panel" aria-labelledby="contact-form-title">
      <h2 id="contact-form-title">{formHeading}</h2>
      <p class="contact-page__form-sub">{formSubheading}</p>
      <ContactForm locale={locale} publicEmail={publicEmail} />
    </section>
  </div>
</div>

<style>
  .contact-page {
    --color-accent: var(--color-ink);

    display: flex;
    flex-direction: column;
    justify-content: center; /* header+grid move as ONE group — leftover space splits evenly top/bottom instead of pooling as a single void in the middle */
    max-width: var(--editorial-page-max);
    margin: 0 auto;
    box-sizing: border-box;
    padding: clamp(var(--space-md), 2.4vh, var(--space-2xl)) var(--editorial-page-padding-inline);
    min-height: calc(100svh - var(--contact-chrome-reserve, 152px)); /* header only — footer is hidden via hideFooter on this page */
  }

  /* Same two-column broken-grid header as Éditions (sketch-012 F1): title
     block left, lead beside it on the right past a hairline, ≥760px. */
  .contact-page__header {
    position: relative;
    isolation: isolate; /* contains the halftone's z-index:-1 so it doesn't escape behind <main>'s background (same fix as 260728-lbh) */
    /* Éditions' halftone is fine bleeding -700px in every direction because
       that page already scrolls — here it would silently add 700px of
       scrollable area below the fold and break the no-scroll guarantee.
       Clip it; the mask's visible glow stays within a few hundred px of
       the header's own corner, well inside this box. */
    overflow: hidden;
    margin-bottom: clamp(var(--space-xl), 6vh, 88px); /* bounded — never justify-content: space-between, which pools a single void on short-wide viewports */
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }
  @media (min-width: 760px) {
    .contact-page__header {
      grid-template-columns: auto 1fr;
      align-items: end;
      column-gap: var(--space-2xl);
    }
  }

  .contact-page__titleblock {
    position: relative;
    grid-column: 1;
  }

  /* Identical drifting dot-halftone effect as the Éditions title (sketch-012
     F1, quick-260728-lbh) — purely decorative, position:absolute so it never
     affects layout height / the no-scroll budget. */
  .contact-page__halftone {
    position: absolute;
    top: -700px;
    bottom: -700px;
    left: -700px;
    right: -700px;
    background-image: radial-gradient(rgba(26, 26, 26, 0.16) 1.4px, transparent 1.6px);
    background-size: 9px 9px;
    -webkit-mask-image: radial-gradient(circle 640px at right 700px top 700px, black 0%, rgba(0, 0, 0, 0.72) 18%, rgba(0, 0, 0, 0.42) 40%, rgba(0, 0, 0, 0.18) 65%, rgba(0, 0, 0, 0.05) 85%, transparent 100%);
    mask-image: radial-gradient(circle 640px at right 700px top 700px, black 0%, rgba(0, 0, 0, 0.72) 18%, rgba(0, 0, 0, 0.42) 40%, rgba(0, 0, 0, 0.18) 65%, rgba(0, 0, 0, 0.05) 85%, transparent 100%);
    z-index: -1;
    pointer-events: none;
    display: none;
    opacity: 0;
    transition: filter 0.3s ease;
    animation: contact-halftone-fade-in 0.6s ease 0.3s forwards, contact-halftone-drift 10s linear infinite;
  }
  @media (min-width: 760px) {
    .contact-page__halftone {
      display: block;
    }
  }
  @keyframes contact-halftone-fade-in {
    to { opacity: 1; }
  }
  @keyframes contact-halftone-drift {
    from { background-position: 0 0; }
    to { background-position: 90px 45px; }
  }
  .contact-page__header:hover .contact-page__halftone {
    animation-duration: 0.6s, 4s;
    filter: contrast(1.35) brightness(0.85);
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-page__halftone {
      animation: none;
      opacity: 1 !important;
    }
    .contact-page__eyebrow::before {
      animation: none;
    }
  }

  /* Matches the Éditions overview title's new typographic treatment
     (quick-260728-dbf): pulsing accent dot + ink-colored label text,
     --text-label-size token, 0.08em tracking. */
  .contact-page__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 clamp(var(--space-xs), 0.8vh, var(--space-sm));
    font-size: var(--text-label-size);
    font-weight: var(--weight-semibold);
    line-height: var(--text-label-leading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .contact-page__eyebrow::before {
    content: '';
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    background: var(--color-accent);
    display: inline-block;
    animation: contact-eyebrow-pulse 2.2s ease-in-out infinite;
  }
  @keyframes contact-eyebrow-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }

  /* Identical to the Éditions title (sketch-012 F1) — same margin, font-size
     clamp, line-height, letter-spacing, white-space, and display. Spacing
     to the lead now comes from the header grid's own `gap` (matching how
     Éditions spaces its title block from its intro), not a margin here. */
  .contact-page h1 {
    margin: var(--space-md) 0 0;
    font-size: clamp(64px, 9vw, 140px);
    font-weight: var(--weight-semibold);
    font-family: var(--font-display);
    line-height: 1.05;
    letter-spacing: -0.04em;
    white-space: nowrap;
    display: inline-block;
  }

  /* Identical to the Éditions intro: grid-column 1 (stacked) on mobile,
     column 2 with a left hairline past 760px, 46ch max-width, 1.5 line-height. */
  .contact-page__lead {
    grid-column: 1;
    margin: 0;
    max-width: 46ch;
    line-height: 1.5;
    color: #3a3a3a;
  }
  @media (min-width: 760px) {
    .contact-page__lead {
      grid-column: 2;
      padding-bottom: 0.3em;
      padding-left: var(--space-lg);
      border-left: var(--border-hairline) solid var(--color-border);
    }
  }

  .contact-page__grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(18px, 2.6vw, 40px);
    align-items: start;
    /* Same hairline weight/color as the line below the Éditions title
       (.editions-index__row:first-of-type) — full-width here, since
       Contact's content below the header is a two-column grid, not a
       row list. */
    border-top: var(--border-hairline) solid var(--color-ink);
  }

  .contact-page__channels {
    display: grid;
  }

  .contact-page__detail {
    position: relative;
    display: block;
    padding: clamp(6px, 1.1vh, 12px) 0;
    border-bottom: var(--border-hairline) solid var(--color-border);
    color: var(--color-ink);
    text-decoration: none;
    overflow: hidden;
  }

  .contact-page__detail::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-ink);
    transform: translateX(-101%);
    transition: transform 320ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .contact-page__detail:hover::before,
  .contact-page__detail:focus-visible::before {
    transform: translateX(0);
  }

  .contact-page__detail-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .contact-page__detail:hover .contact-page__detail-inner,
  .contact-page__detail:focus-visible .contact-page__detail-inner,
  .contact-page__detail:hover .contact-page__value,
  .contact-page__detail:focus-visible .contact-page__value {
    color: var(--gray-0);
  }

  .contact-page__label,
  .contact-page__arrow {
    font-size: 10px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .contact-page__detail:hover .contact-page__label,
  .contact-page__detail:focus-visible .contact-page__label {
    opacity: 0.85;
  }

  .contact-page__value {
    position: relative;
    z-index: 1;
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(13px, 1.2vw, 16px);
  }

  .contact-page__meta {
    margin-top: clamp(6px, 1.2vh, 14px);
    font-size: 11px;
    line-height: 1.5;
    color: #6b6b6b;
  }

  .contact-page__meta p {
    margin: 0;
  }

  .contact-page__meta p + p {
    margin-top: 4px;
  }

  .contact-page__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-page__form-panel {
    padding: clamp(var(--space-md), 2vh, var(--space-xl));
    border: var(--border-hairline) solid var(--color-ink);
  }

  .contact-page__form-panel h2 {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.1;
  }

  .contact-page__form-sub {
    margin: 0 0 clamp(14px, 2.4vh, 22px);
    font-size: 13px;
    color: #6b6b6b;
  }

  @media (max-width: 800px) {
    .contact-page {
      display: block;
      min-height: auto;
    }

    .contact-page__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
