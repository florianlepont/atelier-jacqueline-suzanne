---
// Homepage hero carousel + 2-column grid toggle (D-08/D-09/D-10/D-12), the
// real gallery entry point replacing Phase 1's placeholder homepage. A
// dependency-free vanilla-JS island (no client:* directive — no framework to
// hydrate), mirroring Lightbox.astro's hidden-data-node + typed <script>
// pattern (04.1-RESEARCH.md Pattern 4).
//
// T-04.1-04-ID (threat model, mitigate): gallery data below is pre-fetched
// and pre-filtered (D-12) by the calling page's frontmatter via
// getGalleries() — this component and its client <script> never import
// src/lib/sanity.ts, so SANITY_API_READ_TOKEN never reaches the browser.
//
// This component also renders the homepage's own header — since Phase 10
// Plan 02 (HOME-10, D-01/D-02/D-04), that means rendering the SAME
// <SiteHeader> component every other page renders (About/Contact/gallery-
// detail via BaseLayout), with variant="transparent" fixed (RESEARCH.md
// Pattern 1 — never re-rendered) and the carousel/grid mode-toggle passed
// into its named `extra` slot. The page invokes `<BaseLayout
// headerVariant="none">` to avoid a duplicate <header> — see
// 04.1-UI-SPEC.md Layout Notes ("Homepage — Carousel mode" / "Grid mode")
// and 10-UI-SPEC.md "<SiteHeader> component contract".
import { getRelativeLocaleUrl } from 'astro:i18n';
import SiteHeader from './SiteHeader.astro';
import { wordmarkPhotoFilter, ZOOM_REVEAL_DISTANCE } from '../lib/home-carousel';

interface GalleryEntry {
  slug: string;
  title: string;
  heroSrc: string;
  heroSrcSet: string;
  gridSrc: string;
  gridSrcSet: string;
  blurSrc: string;
  alt: string;
  statement: string;
  heroColor?: string;
  heroTextColor?: string;
}

interface SiteCopy {
  editionsLabel: string;
  aboutLabel: string;
  contactLabel: string;
  homepageIntro: string;
  instagramUrl: string;
  instagramLabel: string;
}

interface Props {
  locale: 'fr' | 'en';
  galleries: GalleryEntry[];
  siteCopy: SiteCopy;
}

const { locale, galleries, siteCopy } = Astro.props;
const isEn = locale === 'en';

// Site-wide editable copy is resolved by the page at build time. Defaults in
// site-config.ts preserve the prototype wording until the new Sanity fields
// are populated.
// homeHref is still needed below for the logo's own link — no separate
// "Accueil"/"Home" nav link anymore (direct user feedback: redundant,
// since clicking the logo already goes home).
const homeHref = getRelativeLocaleUrl(locale, '');
// Matches BaseLayout.astro's editionsLabel/aboutLabel/contactLabel/
// editionsHref/aboutHref/contactHref exactly — the homepage's own header
// renders its own nav (headerVariant="none" suppresses BaseLayout's), but
// must still surface every primary site section, not just Home/Galleries
// (real user feedback: About/Contact were reported missing from the
// homepage nav). EDN-01/D-13/SC #3: this const only feeds the shared
// <SiteHeader> nav below — it never touches the `galleries` carousel/grid
// data, which stays pure photography.
const editionsLabel = siteCopy.editionsLabel;
const editionsHref = getRelativeLocaleUrl(locale, 'editions');
const aboutLabel = siteCopy.aboutLabel;
const aboutHref = getRelativeLocaleUrl(locale, 'about');
const contactLabel = siteCopy.contactLabel;
const contactHref = getRelativeLocaleUrl(locale, 'contact');
// HOME-04 (D-05): reuses BaseLayout.astro's footer Instagram link's exact
// href/target/rel/sr-only-hint semantics verbatim — this component doesn't
// import from BaseLayout, so the same locale-conditional const is declared
// locally rather than re-derived (BaseLayout.astro:76).
const instagramNewTabHint = isEn ? ' (opens in new tab)' : ' (nouvelle fenêtre)';
const toggleCarouselLabel = isEn ? 'Carousel' : 'Carrousel';
const toggleGridLabel = isEn ? 'Grid' : 'Grille';
const pauseCarouselLabel = isEn ? 'Pause automatic carousel' : 'Mettre le carrousel en pause';
const playCarouselLabel = isEn ? 'Play automatic carousel' : 'Relancer le carrousel';
// quick-260726-u97 (sketch 008 Variant C): the permanent center-zone cursor
// label — always visible, not a hover-discovery hint (direct feedback on
// the sketch confirmed there is no unlabeled ring state).
const openLabel = isEn ? 'OPEN' : 'OUVRIR';
const wordmark = 'Atelier Jacqueline Suzanne';
const introBody = siteCopy.homepageIntro;

const totalLabel = String(galleries.length).padStart(2, '0');
const firstGallery = galleries[0];

// Base-aware logo paths (matches BaseLayout.astro's assetBase pattern) — a
// bare root-relative "/logos/..." src 404s under the GitHub Pages deploy's
// ASTRO_BASE=/ajs-website/ subpath (.github/workflows/deploy.yml), even
// though every <a href> here is already base-safe via getRelativeLocaleUrl.
const assetBase = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const logoWhiteSrc = `${assetBase}/logos/AJS_Brutalist_White_Transparent.png`;
const logoBlackSrc = `${assetBase}/logos/AJS_Brutalist_Black_Transparent.png`;
---

{galleries.length === 0 ? (
  <p class="home-empty">{isEn ? 'No galleries available yet.' : 'Aucune galerie disponible pour le moment.'}</p>
) : (
  <section
    class="home"
    data-display-mode="carousel"
    style={{
      '--wordmark-photo': 'none',
      '--wordmark-photo-filter': wordmarkPhotoFilter(firstGallery.heroTextColor),
      '--current-accent': firstGallery.heroColor ?? 'var(--color-accent)',
      '--current-accent-text': firstGallery.heroTextColor ?? 'var(--color-on-accent)',
      /* Phase 21 (HOME-14/HOME-15): the phone-width scroll deck's own
         full-screen zoom wordmark/photo-crossfade layer (below) reads these
         two custom properties. Deliberately sourced from firstGallery, the
         SAME gallery whose heroSrc the deck's first slide (Task 2 below)
         also uses, so the wordmark zoom lands on the exact photo the first
         slide then shows — no seam between the intro transition and the
         first real slide. */
      '--zoom-photo': `url(${firstGallery.heroSrc})`,
      '--zoom-photo-filter': wordmarkPhotoFilter(firstGallery.heroTextColor),
    }}
  >
    <SiteHeader
      variant="transparent"
      siteTitle={wordmark}
      homeHref={homeHref}
      editionsLabel={editionsLabel}
      editionsHref={editionsHref}
      aboutLabel={aboutLabel}
      aboutHref={aboutHref}
      contactLabel={contactLabel}
      contactHref={contactHref}
      instagramUrl={siteCopy.instagramUrl}
      instagramLabel={siteCopy.instagramLabel}
      instagramNewTabHint={instagramNewTabHint}
      logoBlackSrc={logoBlackSrc}
      logoWhiteSrc={logoWhiteSrc}
      mobileNav={true}
    >
      {/* HOME-13/D-01 (Phase 20 Plan 03): the only opt-in call site in the
          codebase — every other <SiteHeader> consumer (BaseLayout.astro)
          keeps omitting this prop entirely. */}
      {/* D-04: the ONLY content ever passed through SiteHeader's named
          `extra` slot — inherently homepage-only functionality (no "mode"
          concept exists on About/Contact/gallery-detail). Markup/behavior
          unchanged from before the SiteHeader extraction. */}
      <button
        slot="extra"
        type="button"
        class="home-toggle"
        data-role="mode-toggle"
        data-action="toggle-mode"
        data-label-carousel={toggleCarouselLabel}
        data-label-grid={toggleGridLabel}
        aria-label={toggleGridLabel}
      >
        <span class="home-toggle__box" aria-hidden="true">
          <span class="home-toggle__morph">
            <span class="home-toggle__morph-cell"></span>
            <span class="home-toggle__morph-cell"></span>
            <span class="home-toggle__morph-cell"></span>
            <span class="home-toggle__morph-cell"></span>
            <span class="home-toggle__morph-cell"></span>
            <span class="home-toggle__morph-cell"></span>
          </span>
        </span>
      </button>
    </SiteHeader>

    <div class="home-hero" data-role="home-carousel">
      {/* Wraps the photo + its overlaid chrome (scrim, arrows, caption) in
          its own sized box, separate from .home-hero__accent below. On
          mobile, .home-hero__accent is in-flow (not absolute — see its
          mobile override), which used to make .home-hero itself grow taller
          than the photo to fit the panel; since .home-hero__img/__caption
          were absolutely positioned against .home-hero's *entire* (grown)
          box, the photo silently stretched down behind the panel and the
          caption landed past it, overlapping. This wrapper is what
          .home-hero__img/__scrim/__arrow/__caption are now absolutely
          positioned against, so they stay confined to the photo's own
          16:9 band regardless of how tall the accent panel makes
          .home-hero grow. */}
      <div class="home-hero__photo">
        {/* quick-260726-u97 (sketch 008 Variant C): parallax-push peek
            layers, sitting UNDERNEATH the current photo (z-index below the
            .home-hero__img layers) — as the pointer nears an edge, the
            current photo peels away (Task 3's cursor script) and one of
            these real adjacent-gallery photos is revealed underneath. Rest
            position is fully off-screen (translateX ±100%), populated with
            real data in render() below, desktop-gated (hoverCapable) since
            touch has no hover to approach an edge with. */}
        <img data-role="peek-prev" alt="" aria-hidden="true" class="home-hero__peek home-hero__peek--prev" />
        <img data-role="peek-next" alt="" aria-hidden="true" class="home-hero__peek home-hero__peek--next" />
        <img data-role="hero-image-placeholder" src={firstGallery.blurSrc} alt="" aria-hidden="true" class="home-hero__img home-hero__img-placeholder" />
        <img
          data-role="hero-image"
          src={firstGallery.heroSrc}
          srcset={firstGallery.heroSrcSet}
          sizes="100vw"
          alt={firstGallery.alt}
          fetchpriority="high"
          class="home-hero__img home-hero__img--sharp"
        />
        <div class="home-hero__scrim" aria-hidden="true"></div>

        <div class="home-hero__caption">
          {/* Direct request: replaces the prev/next arrow buttons with a
              clickable dashed progress indicator (one segment per gallery,
              current one highlighted) — navigation itself moves to keyboard
              arrow keys and touch swipe, handled in the <script> below. Each
              dash is still a real, individually-focusable/clickable <button>
              (not decorative), so mouse/touch users who don't know the
              keyboard shortcut retain a direct way to jump to any gallery.
              Nested inside .home-hero__caption (bottom-left, not the top)
              per direct follow-up feedback, so it flows naturally above the
              index/title/byline instead of needing its own hardcoded
              vertical offset — one less pixel-math dependency to keep in
              sync with the rest of the caption's content. */}
          <div class="home-hero__carousel-controls">
            {/* WR-03 fix: this is a labeled group of independently-tabbable
                buttons, not an ARIA tablist — role="tab" requires
                aria-selected (not aria-current) as its selected-state
                attribute, and implies the roving-tabindex/arrow-key tab
                pattern, neither of which this widget implements (global
                Left/Right already drives photo navigation independently of
                dash focus). role="group" + aria-current="true" on the
                current dash correctly conveys "the current gallery" for a
                non-tab widget without the mismatched semantics. */}
            <div class="home-hero__progress" data-role="progress" role="group" aria-label={isEn ? 'Choose a gallery' : 'Choisir une galerie'}>
              {galleries.map((gallery, i) => (
                <button
                  type="button"
                  class="home-hero__progress-dash"
                  data-action="go-to"
                  data-index={i}
                  aria-current={i === 0 ? 'true' : 'false'}
                  aria-label={`${gallery.title} (${i + 1}/${galleries.length})`}
                />
              ))}
            </div>
            <button
              type="button"
              class="home-hero__autoplay-toggle"
              data-role="autoplay-toggle"
              data-label-pause={pauseCarouselLabel}
              data-label-play={playCarouselLabel}
              aria-label={pauseCarouselLabel}
              aria-pressed="false"
            >
              <span class="home-hero__pause-icon" aria-hidden="true"><span></span><span></span></span>
              <span class="home-hero__play-icon" aria-hidden="true"></span>
            </button>
          </div>
          <p class="home-hero__index" data-role="index-label">01 / {totalLabel}</p>
          <a class="home-hero__title" data-role="gallery-title" href={getRelativeLocaleUrl(locale, `galleries/${firstGallery.slug}`)}>{firstGallery.title.toUpperCase()}</a>
        </div>

        {/* quick-260726-u97 (sketch 008 Variant C): the custom hover cursor
            replacing the removed scroll-to-open gesture — permanent OUVRIR/
            OPEN center ring, accent-tinted directional arrow pill at the 22%
            edge zones. Gated entirely behind (hover: hover) and
            (pointer: fine) in both CSS and JS below, so it never activates
            on touch (the mobile fallback is a plain tap, wired in Task 5). */}
        <div class="home-hero__cursor" data-role="hero-cursor" data-zone="center" aria-hidden="true">
          <div class="home-hero__cursor-ring">
            <span class="home-hero__cursor-label">{openLabel}</span>
            <span class="home-hero__cursor-arrow" aria-hidden="true">&#8594;</span>
          </div>
        </div>
      </div>

      <div
        class="home-hero__accent"
        data-role="accent-panel"
        style={{ color: firstGallery.heroTextColor ?? 'var(--color-on-accent)' }}
      >
        {/* D-08: the solid title is the no-JS/loading fallback. Once the
            responsive hero has loaded, render() uses its browser-selected
            currentSrc for this photo cutout, avoiding a second 2000px image
            download on narrow screens.

            quick-260727-iao: mirrors .home-hero__photo's own current/peekPrev/
            peekNext three-layer structure so the wordmark cutout can slide in
            lockstep with the carousel photo through both hover-peek and
            click-commit. The h1 stays the FIRST child, unchanged in class and
            content — it remains the sole accessible heading; the two spans
            after it are aria-hidden duplicates matched only by the distinct
            `.home-hero__wordmark-peek` token (never `.home-hero__wordmark`),
            so every existing single-match `.home-hero__wordmark` locator
            keeps matching exactly this one element. --wm-seam/data-peek-zone
            are written by syncWordmarkLayers() in the <script> below; the
            inline defaults here (seam=1, zone=right) render identically to
            "current full, both peeks clipped" for SSR/pre-JS. */}
        <div class="home-hero__wordmark-stack" data-role="wordmark-stack" data-peek-zone="right" style={{ '--wm-seam': '1' }}>
          <h1 class="home-hero__wordmark">Atelier<br />Jacqueline<br />Suzanne</h1>
          <span class="home-hero__wordmark-peek home-hero__wordmark-peek--prev" data-role="wordmark-peek-prev" aria-hidden="true">Atelier<br />Jacqueline<br />Suzanne</span>
          <span class="home-hero__wordmark-peek home-hero__wordmark-peek--next" data-role="wordmark-peek-next" aria-hidden="true">Atelier<br />Jacqueline<br />Suzanne</span>
        </div>
        <p class="home-hero__intro">{introBody}</p>
      </div>
    </div>

    <div class="home-grid" data-role="home-grid" hidden>
      <div class="home-grid__tiles">
        {/* D-06: non-link hero tile — same square sizing as every gallery
            tile, but a plain <div> (no gallery to navigate to). D-05: solid
            accent background, no photo/cutout. */}
        <div class="home-grid__tile home-grid__tile--hero">
          <h1 class="home-grid__wordmark">Atelier<br />Jacqueline<br />Suzanne</h1>
          <p class="home-grid__intro-body">{introBody}</p>
        </div>
        {galleries.map((gallery) => (
          <a
            href={getRelativeLocaleUrl(locale, `galleries/${gallery.slug}`)}
            class="home-grid__tile"
            style={{ '--tile-accent': gallery.heroColor ?? 'var(--color-accent)' }}
          >
            <img src={gallery.blurSrc} alt="" aria-hidden="true" class="home-grid__tile-img home-grid__tile-img-placeholder" />
            <img
              src={gallery.gridSrc}
              srcset={gallery.gridSrcSet}
              sizes="(max-width: 767px) 100vw, 33vw"
              width="600"
              height="600"
              alt={gallery.alt}
              loading="lazy"
              decoding="async"
              class="home-grid__tile-img home-grid__tile-img--sharp"
            />
            <div class="home-grid__tile-scrim" aria-hidden="true"></div>
            <span class="home-grid__tile-copy">
              <span class="home-grid__tile-title">{gallery.title}</span>
              <span class="home-grid__tile-description">{gallery.statement}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    {/* Phase 21 (HOME-14/HOME-15): the phone-width scroll deck. NEW, parallel
        markup, sibling to .home-hero/.home-grid above — shown ONLY below
        767px by a pure CSS media query (Task 3), never a JS markup swap
        (21-RESEARCH.md Anti-Patterns). This is deliberately NOT a reuse of
        the carousel's own DOM: that subtree carries progress dashes, an
        autoplay toggle, peek layers and a hover cursor this mobile view
        explicitly does not want (D-01/D-16). No motion is wired yet — this
        task only builds the structure/CSS end-state; plans 21-05/21-06 layer
        the scroll driver and arrival observer on top.
        - D-16: the wordmark is intro-only. It lives ONLY in the zoom stage
          below, once, and no .home-slide repeats it — regular slides show
          just title + description.
        - D-10: each slide is a real anchor with a build-time-rendered href,
          so tapping it opens the gallery via the browser's own click
          semantics. There is no synthesized openCurrent()/coordinate
          heuristic here, and therefore no exclusion guard to get wrong —
          precisely the tap-hijack bug class CR-01 was (fixed separately, in
          the EXISTING carousel's touchend handler, by plan 21-02).
        - D-07: exactly one photo per gallery (its own hero/cover photo) —
          not a multi-photo-per-gallery preview. */}
    <div class="home-scroll-deck" data-role="scroll-deck">
      <div
        class="home-scroll-deck__track"
        data-role="zoom-track"
        data-reveal-distance={ZOOM_REVEAL_DISTANCE}
        style={`--zoom-reveal-distance: ${ZOOM_REVEAL_DISTANCE}px`}
      >
        <div class="home-scroll-deck__stage" data-role="zoom-stage">
          <div class="home-scroll-deck__photo" data-role="zoom-photo" aria-hidden="true"></div>
          <h1 class="home-scroll-deck__wordmark" data-role="zoom-wordmark">
            <span class="home-scroll-deck__focus-letter" data-role="zoom-focus-letter">A</span>telier<br />Jacqueline<br />Suzanne
          </h1>
        </div>
      </div>
      <div class="home-scroll-deck__slides" data-role="deck-slides">
        {galleries.map((gallery, i) => (
          <a
            href={getRelativeLocaleUrl(locale, `galleries/${gallery.slug}`)}
            class="home-slide"
            data-role="deck-slide"
            data-index={i}
            data-hero-color={gallery.heroColor}
            data-hero-text-color={gallery.heroTextColor}
            style={{
              '--slide-accent': gallery.heroColor ?? 'var(--color-accent)',
              '--slide-accent-text': gallery.heroTextColor ?? 'var(--color-on-accent)',
            }}
          >
            <img
              src={gallery.heroSrc}
              srcset={gallery.heroSrcSet}
              sizes="100vw"
              alt={gallery.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={i === 0 ? 'high' : undefined}
              class="home-slide__img"
            />
            <div class="home-slide__accent">
              <span class="home-slide__title">{gallery.title}</span>
              <p class="home-slide__description">{gallery.statement}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    {/* Build-time data for the runtime script to read (Lightbox.astro
        precedent) — the script never imports src/lib/sanity, it only reads
        this already-fetched, already-filtered (D-12) static markup. */}
    <ul hidden data-role="home-carousel-data">
      {galleries.map((gallery) => (
        <li
          data-slug={gallery.slug}
          data-title={gallery.title}
          data-hero-src={gallery.heroSrc}
          data-hero-srcset={gallery.heroSrcSet}
          data-blur-src={gallery.blurSrc}
          data-alt={gallery.alt}
          data-statement={gallery.statement}
          data-href={getRelativeLocaleUrl(locale, `galleries/${gallery.slug}`)}
          data-hero-color={gallery.heroColor}
          data-hero-text-color={gallery.heroTextColor}
        />
      ))}
    </ul>

    <script>
      import { computeHoverZone, computeWordmarkBackgroundPosition, computeWordmarkSeamFraction, detectSwipeDirection, pickRandomGalleryIndex, wordmarkPhotoFilter } from '../lib/home-carousel';

      interface GalleryEntry {
        slug: string;
        title: string;
        heroSrc: string;
        heroSrcSet: string;
        blurSrc: string;
        alt: string;
        statement: string;
        href: string;
        heroColor?: string;
        heroTextColor?: string;
      }

      const root = document.querySelector<HTMLElement>('.home[data-display-mode]');
      const hero = document.querySelector<HTMLElement>('[data-role="home-carousel"]');
      const grid = document.querySelector<HTMLElement>('[data-role="home-grid"]');
      const dataEl = document.querySelector<HTMLUListElement>('ul[data-role="home-carousel-data"]');

      if (root && hero && grid && dataEl) {
        const galleries: GalleryEntry[] = Array.from(dataEl.querySelectorAll('li')).map((li) => ({
          slug: li.dataset.slug ?? '',
          title: li.dataset.title ?? '',
          heroSrc: li.dataset.heroSrc ?? '',
          heroSrcSet: li.dataset.heroSrcset ?? '',
          blurSrc: li.dataset.blurSrc ?? '',
          alt: li.dataset.alt ?? '',
          statement: li.dataset.statement ?? '',
          href: li.dataset.href ?? '',
          heroColor: li.dataset.heroColor || undefined,
          heroTextColor: li.dataset.heroTextColor || undefined,
        }));

        // ACCENTS cycles generically via index % ACCENTS.length (RESEARCH.md
        // Open Question 3) — written for N galleries, not hardcoded to 2,
        // so it extends correctly once more galleries migrate. bg/text pairs
        // per the prototype's ACCENTS array (plan interfaces block).
        const ACCENTS: Array<{ bg: string; text: string }> = [
          { bg: 'var(--color-accent)', text: 'var(--color-on-accent)' },
          { bg: 'var(--palette-purple)', text: '#FFFFFF' },
          { bg: 'var(--palette-teal)', text: 'var(--color-ink)' },
          { bg: 'var(--palette-lime)', text: 'var(--color-ink)' },
          { bg: 'var(--palette-plum)', text: '#FFFFFF' },
        ];
        const heroImg = hero.querySelector<HTMLImageElement>('[data-role="hero-image"]');
        const heroPlaceholderImg = hero.querySelector<HTMLImageElement>('[data-role="hero-image-placeholder"]');
        const indexLabel = hero.querySelector<HTMLElement>('[data-role="index-label"]');
        const titleEl = hero.querySelector<HTMLElement>('[data-role="gallery-title"]');
        const accentPanel = hero.querySelector<HTMLElement>('[data-role="accent-panel"]');
        const wordmarkEl = hero.querySelector<HTMLElement>('.home-hero__wordmark');
        // quick-260727-iao: the mirrored-peek wordmark stack — all nullable,
        // no-op safe if the markup is ever missing.
        const wordmarkStackEl = hero.querySelector<HTMLElement>('.home-hero__wordmark-stack');
        const wordmarkPeekPrevEl = hero.querySelector<HTMLElement>('.home-hero__wordmark-peek--prev');
        const wordmarkPeekNextEl = hero.querySelector<HTMLElement>('.home-hero__wordmark-peek--next');
        const progressDashes = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-role="progress"] .home-hero__progress-dash'));
        const autoplayToggle = hero.querySelector<HTMLButtonElement>('[data-role="autoplay-toggle"]');

        // HOME-09 (D-03/D-06): grid tiles are server-rendered once and never
        // re-rendered by render() — a one-time load-listener setup here
        // (not inside render()) fades each tile's sharp <img> in over its
        // blurred placeholder as it lazy-loads into view.
        const gridTileImgs = Array.from(document.querySelectorAll<HTMLImageElement>('.home-grid__tile-img--sharp'));
        gridTileImgs.forEach((img) => {
          if (img.complete) {
            showSharp(img);
          } else {
            img.addEventListener('load', () => showSharp(img), { once: true });
            // A failed fetch never fires 'load' — without this, a broken image
            // leaves the tile stuck on its blurred placeholder forever.
            img.addEventListener('error', () => showSharp(img), { once: true });
          }
        });

        // quick-260724-uf5 (sketch 006): the SOURCE side of the homepage ->
        // gallery-detail cross-document photo morph. Mirrors this file's
        // existing dynamic-naming pattern for the in-page mode-toggle morph
        // (namedMorphTile below) — assign the name on click and leave it in
        // place. Harmless on browsers without cross-document View
        // Transitions support: this is a plain style write, no
        // preventDefault, no manual navigation — every homepage -> gallery
        // link is a real <a href>, so unsupported browsers just navigate
        // normally.
        let namedCrossDocPhoto: HTMLElement | null = null;
        function setCrossDocPhoto(img: HTMLElement) {
          // Clearing any previously-named element first guarantees only ONE
          // element ever carries `hero-photo` at a time — important because
          // inline names survive back/forward bfcache restores, and a user
          // could otherwise leave a grid tile named, go back, switch to
          // carousel or another tile, and end up with two elements sharing
          // `hero-photo`, which is invalid and would silently skip the
          // transition.
          if (namedCrossDocPhoto && namedCrossDocPhoto !== img) {
            namedCrossDocPhoto.style.viewTransitionName = '';
          }
          img.style.viewTransitionName = 'hero-photo';
          namedCrossDocPhoto = img;
        }

        // Carousel title: names the current slide's sharp photo immediately
        // before the browser's default link navigation proceeds.
        if (titleEl && heroImg) {
          titleEl.addEventListener('click', () => setCrossDocPhoto(heroImg));
        }

        // Grid tiles: attaching to each tile's parent `.home-grid__tile`
        // link and naming THAT tile's own sharp img means a click anywhere
        // on the tile names exactly the right photo. setCrossDocPhoto
        // clears the prior name first, so only the just-clicked tile
        // carries `hero-photo`.
        gridTileImgs.forEach((img) => {
          const tile = img.closest('.home-grid__tile');
          if (tile) {
            tile.addEventListener('click', () => setCrossDocPhoto(img));
          }
        });

        let carouselIndex = 0;
        let timer: ReturnType<typeof setInterval> | null = null;
        const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        // CR-01 fix: this desktop carousel's `data-display-mode` never
        // actually leaves 'carousel' on a phone — the mode-toggle button
        // that would flip it to 'grid' is display:none below 767px (see
        // the `@media (max-width: 767px)` rule further down), so that
        // dataset check alone can't gate auto-advance off at phone widths.
        // Matches the identical `(max-width: 767px)` breakpoint the
        // phone-only scroll-deck script (`mobile`, second <script> block
        // below) and its CSS already use, byte-for-byte.
        const phoneViewport = window.matchMedia('(max-width: 767px)');
        let autoAdvancePausedByUser = reduceMotionQuery.matches;
        let hasUserChosenAutoplay = false;
        // Cancels the previous render()'s pending hero load/error listeners so
        // rapid swaps (fast clicks/swipes) don't stack up never-fired 'load'
        // listeners on heroImg (each abandoned request never fires 'load').
        let pendingHeroLoadCtrl: AbortController | null = null;

        function showSharp(img: HTMLImageElement) {
          img.classList.add('is-loaded');
        }

        function revealWordmarkPhoto() {
          if (!heroImg) return;
          const selectedSrc = heroImg.currentSrc || heroImg.src;
          if (!selectedSrc) return;
          root!.style.setProperty('--wordmark-photo', `url(${selectedSrc})`);
          syncWordmarkLayers();
          root!.classList.add('has-wordmark-photo');
        }

        // .home-hero__img uses the default object-position (50% 50%,
        // dead center) — kept as named constants so the crop math below
        // stays generic if that ever changes again.
        const OBJECT_POSITION_X = 0.5;
        const OBJECT_POSITION_Y = 0.5;

        // Direct user feedback: background-size:cover scoped to the small
        // wordmark box (the previous approach) shows an independently
        // re-cropped/zoomed slice of the photo, not the SAME slice that's
        // actually behind the panel — it doesn't read as a true cutout.
        // This computes the exact background-size/position the wordmark's
        // own background-image needs so it lines up pixel-for-pixel with
        // heroImg's own object-fit:cover crop — i.e. what you'd see if the
        // panel really were a hole cut in the same physical photo. Must be
        // computed in JS: CSS has no way to say "background-size:cover
        // relative to a DIFFERENT (larger) box than the element's own".
        function syncWordmarkAlignment() {
          if (!heroImg || !wordmarkEl) return;
          // heroImg carries a plain full-cover box (inset: 0; width/height:
          // 100%) — its own rect is read directly here (not .home-hero's)
          // since object-fit:cover's crop math is relative to the img's own
          // rendered box.
          // quick-260727-kq8: opt out of the drq clamp (clampToPhoto=false)
          // — the seam-driven clip-path (--wm-seam on
          // .home-hero__wordmark-stack, CSS zone selectors) already
          // guarantees only the in-bounds [0, seam] slice of this layer
          // ever paints, so the full-box clamp is redundant here and its
          // only effect was freezing this current layer's position once the
          // raw value exceeded the photo's bounds.
          const result = computeWordmarkBackgroundPosition(
            heroImg.naturalWidth,
            heroImg.naturalHeight,
            heroImg.getBoundingClientRect(),
            wordmarkEl.getBoundingClientRect(),
            OBJECT_POSITION_X,
            OBJECT_POSITION_Y,
            false,
          );
          if (!result) return;
          wordmarkEl.style.setProperty('--wordmark-bg-size', result.size);
          wordmarkEl.style.setProperty('--wordmark-bg-position', result.position);
        }

        // quick-260727-iao: which edge's peek layer is "active" — sticky
        // across interactions so a mouseleave recede eases toward the SAME
        // extreme the seam was already tracking (no snap/desync between the
        // eased photo receding and the wordmark). Deliberately no 'center'
        // value: at neutral the seam fraction naturally rests at its
        // current-covers-all extreme (s=1 for right, s=0 for left), which
        // renders identically to "center" (current full, both peeks
        // clipped) — see the CSS zone selectors in Task 2.
        let lastPeekZone: 'left' | 'right' = 'right';

        // Extends (does not replace) syncWordmarkAlignment()'s current-layer
        // math: also feeds the active peek layer its own independent crop
        // via the SAME pure computeWordmarkBackgroundPosition(), and derives
        // the live seam fraction from heroImg's LIVE edge via
        // computeWordmarkSeamFraction() — mirroring exactly how the photo's
        // own peekPrev/peekNext layers are positioned relative to heroImg.
        function syncWordmarkLayers() {
          syncWordmarkAlignment();
          if (!wordmarkStackEl || !wordmarkEl || !heroImg) return;
          const zone = lastPeekZone;
          const peekImg = zone === 'right' ? peekNext : peekPrev;
          const peekEl = zone === 'right' ? wordmarkPeekNextEl : wordmarkPeekPrevEl;
          const restExtreme = zone === 'right' ? '1' : '0';
          const wmRect = wordmarkEl.getBoundingClientRect();

          // Rare fallback (nearest layer's clamped edge, NEVER solid ink):
          // only hit before an adjacent photo has finished loading — peek
          // srcs are preloaded in render(), so this is effectively just the
          // very first paint.
          if (!peekImg || !peekEl || !peekImg.naturalWidth) {
            wordmarkStackEl.style.setProperty('--wm-seam', restExtreme);
            wordmarkStackEl.dataset.peekZone = zone;
            return;
          }
          // quick-260727-kq8: same clamp opt-out as the current-layer call
          // above — the peek layer is equally seam-clip-gated (its own
          // CSS zone selector), so it needs the same continuous, unclamped
          // tracking rather than freezing at a clamped boundary value.
          const peekResult = computeWordmarkBackgroundPosition(
            peekImg.naturalWidth,
            peekImg.naturalHeight,
            peekImg.getBoundingClientRect(),
            wmRect,
            OBJECT_POSITION_X,
            OBJECT_POSITION_Y,
            false,
          );
          if (!peekResult) {
            wordmarkStackEl.style.setProperty('--wm-seam', restExtreme);
            wordmarkStackEl.dataset.peekZone = zone;
            return;
          }
          peekEl.style.backgroundImage = `url(${peekImg.currentSrc || peekImg.src})`;
          peekEl.style.setProperty('--wordmark-bg-size', peekResult.size);
          peekEl.style.setProperty('--wordmark-bg-position', peekResult.position);

          const heroRect = heroImg.getBoundingClientRect();
          const seam = computeWordmarkSeamFraction(zone, heroRect.left, heroRect.right, wmRect.left, wmRect.width);
          wordmarkStackEl.style.setProperty('--wm-seam', String(seam));
          wordmarkStackEl.dataset.peekZone = zone;
        }

        // quick-260727-bsm (Bug A — wordmark peek desync): syncWordmarkAlignment()
        // above already computes the correct cutout from heroImg's live rect
        // (which reflects the CSS `transform: translateX(var(--peek-shift))`
        // set by updatePeek() below), but it was previously only ever called
        // on load/resize — never while the photo was actually mid-transform.
        // This rAF pump keeps calling it every frame for as long as the photo
        // can plausibly still be moving (an active peek push, or the ~420ms
        // ease-settle after the mouse stops/leaves), so the "hole cut in the
        // photo" illusion never freezes relative to the photo sliding
        // underneath it. quick-260727-iao: the pump now keeps ALL THREE
        // wordmark layers' cutouts AND the seam tracking the live photo
        // motion, not just the single current-layer position.
        let wordmarkSyncRaf: number | null = null;
        let wordmarkSyncUntil = 0;

        function pumpWordmarkSync() {
          syncWordmarkLayers();
          if (performance.now() < wordmarkSyncUntil) {
            wordmarkSyncRaf = requestAnimationFrame(pumpWordmarkSync);
          } else {
            wordmarkSyncRaf = null;
          }
        }

        // References `hoverCapable`, declared later in this script (~line
        // 830) — safe because this function is only ever CALLED at runtime
        // (from updatePeek()/resetPeek(), both themselves only invoked on
        // user interaction or from render(), which first runs at the very
        // end of this script), never during initial synchronous parse.
        function keepWordmarkSynced(ms = 500) {
          if (!hoverCapable || reduceMotionQuery.matches) return;
          wordmarkSyncUntil = Math.max(wordmarkSyncUntil, performance.now() + ms);
          if (wordmarkSyncRaf === null) {
            wordmarkSyncRaf = requestAnimationFrame(pumpWordmarkSync);
          }
        }

        // quick-260803-bvu (Item 1): `forceCrossfade` is opt-in, defaulting
        // to false so every existing caller (dash click, keyboard, swipe)
        // keeps today's exact behavior. Only the auto-advance tick below
        // passes true. See the sync-branch comment for the full diagnosis
        // of why a genuine short delay (not just a forced reflow) is
        // needed for the crossfade to actually play once the next photo
        // is already cached.
        function render(forceCrossfade = false) {
          const gallery = galleries[carouselIndex];
          if (!gallery) return;
          // The clipped wordmark has no visible glyph fill until its photo
          // exists. Return to the solid inherited text fallback for every
          // swap, then opt into the cutout only after the active sharp hero
          // has loaded successfully. This keeps the title readable while
          // the independent blur placeholder is the only painted image.
          root!.classList.remove('has-wordmark-photo');
          root!.style.setProperty('--wordmark-photo', 'none');
          const fallbackAccent = ACCENTS[carouselIndex % ACCENTS.length];
          const accent = gallery.heroColor
            ? { bg: gallery.heroColor, text: gallery.heroTextColor ?? 'var(--color-on-accent)' }
            : fallbackAccent;
          if (heroImg && heroPlaceholderImg) {
            heroPlaceholderImg.src = gallery.blurSrc;
            heroImg.classList.remove('is-loaded'); // Pitfall 3: must precede src reassignment
            heroImg.srcset = gallery.heroSrcSet;
            heroImg.sizes = '100vw';
            heroImg.src = gallery.heroSrc;
            heroImg.alt = gallery.alt;
            // Abort the previous render()'s pending listeners first — a superseded
            // request never fires 'load', so without this, rapid swaps stack up
            // never-fired { once: true } listeners on heroImg indefinitely.
            pendingHeroLoadCtrl?.abort();
            if (heroImg.complete) {
              if (forceCrossfade) {
                // quick-260803-bvu (Item 1): once the next photo is already
                // cached (the common case, thanks to the D-05 preload
                // below), `is-loaded` gets removed then re-added within the
                // very same synchronous call — confirmed live (via
                // getComputedStyle sampling every 15-40ms across a real
                // swap, and via isolated remove/re-add experiments) that
                // NEITHER a forced layout read (`offsetWidth`) NOR even a
                // double-rAF wait gives the browser enough genuine elapsed
                // time to register the "unloaded" (opacity: 0) state before
                // the re-add retargets it back to 1 — the two writes
                // collapse into a no-op and the 260ms crossfade never
                // visibly plays. Only a real, if brief, elapsed-time delay
                // reliably retriggers it (confirmed: 60ms reliably produces
                // a full, visible fade across repeated runs). The blurred
                // placeholder (already reassigned above) is on screen for
                // this whole window, so the delay is invisible — it only
                // defers the SHARP layer's own fade-in, which is exactly
                // the situation the blur-up mechanic (HOME-09) exists for.
                window.setTimeout(() => {
                  showSharp(heroImg);
                  if (heroImg.naturalWidth > 0) {
                    revealWordmarkPhoto();
                  }
                }, 60);
              } else {
                showSharp(heroImg);
                if (heroImg.naturalWidth > 0) {
                  revealWordmarkPhoto();
                }
              }
            } else {
              pendingHeroLoadCtrl = new AbortController();
              const onLoad = () => {
                showSharp(heroImg);
                revealWordmarkPhoto();
              };
              const onError = () => showSharp(heroImg);
              // 'error' covers a failed fetch (bad asset, transient CDN issue) —
              // without it the hero stays stuck on the blurred placeholder forever.
              heroImg.addEventListener('load', onLoad, { once: true, signal: pendingHeroLoadCtrl.signal });
              heroImg.addEventListener('error', onError, { once: true, signal: pendingHeroLoadCtrl.signal });
            }
          }
          if (indexLabel) {
            indexLabel.textContent = `${String(carouselIndex + 1).padStart(2, '0')} / ${String(galleries.length).padStart(2, '0')}`;
          }
          if (titleEl) {
            titleEl.textContent = gallery.title.toUpperCase();
            titleEl.setAttribute('href', gallery.href);
          }
          if (accentPanel) {
            accentPanel.style.color = accent.text;
          }
          root!.style.setProperty('--current-accent', accent.bg);
          root!.style.setProperty('--current-accent-text', accent.text);
          root!.style.setProperty('--wordmark-photo-filter', wordmarkPhotoFilter(accent.text));
          progressDashes.forEach((dash, i) => {
            dash.setAttribute('aria-current', i === carouselIndex ? 'true' : 'false');
          });
          restartFill();

          // D-05: warm the browser's HTTP cache for the next gallery's hero
          // photo so the crossfade above resolves near-instantly by the time
          // the next auto-advance/prev/next/toggle swap actually happens.
          const nextIndex = (carouselIndex + 1) % galleries.length;
          const nextSrc = galleries[nextIndex]?.heroSrc;
          if (nextSrc) {
            const preload = new Image();
            preload.srcset = galleries[nextIndex]?.heroSrcSet ?? '';
            preload.sizes = '100vw';
            preload.src = nextSrc;
          }

          // quick-260726-u97 (sketch 008 Variant C): keeps the peek layers'
          // sources tracking the CURRENT slide's real neighbours on every
          // swap (auto-advance, dash click, arrow keys, swipe) — forward
          // references to hoverCapable/peekPrev/peekNext/resetPeek are safe:
          // render() is first invoked at the very end of this script, after
          // those declarations have already executed. Guarded on
          // hoverCapable so touch skips the extra image loads entirely.
          if (hoverCapable) {
            const prevGallery = galleries[(carouselIndex - 1 + galleries.length) % galleries.length];
            const nextGallery = galleries[nextIndex];
            if (peekPrev && prevGallery) {
              peekPrev.src = prevGallery.heroSrc;
              peekPrev.srcset = prevGallery.heroSrcSet;
              peekPrev.sizes = '100vw';
            }
            if (peekNext && nextGallery) {
              peekNext.src = nextGallery.heroSrc;
              peekNext.srcset = nextGallery.heroSrcSet;
              peekNext.sizes = '100vw';
            }
            resetPeek();
          }
        }

        // quick-260725-dcg (Fix 3): toggles the class that freezes/resumes
        // the current dash's fill (see .home.is-autoplay-paused in the
        // <style> block above) in lockstep with the 6000ms timer's own
        // running/stopped state.
        function setFillPaused(paused: boolean) {
          root!.classList.toggle('is-autoplay-paused', paused);
        }

        // Restarts the ::after fill animation from 0% on the freshly-current
        // dash: remove .is-filling from every dash, force a reflow, then add
        // it back only to the current one. The remove -> reflow -> add
        // sequence is required for the CSS animation to restart
        // deterministically (including on a fast double-navigation),
        // without relying on aria-current re-matching to retrigger it.
        function restartFill() {
          progressDashes.forEach((d) => d.classList.remove('is-filling'));
          const current = progressDashes[carouselIndex];
          if (!current) return;
          void current.offsetWidth;
          current.classList.add('is-filling');
        }

        function stopAutoAdvance() {
          if (timer) clearInterval(timer);
          timer = null;
          setFillPaused(true);
        }

        // D-09: auto-advance every 6000ms, paused on keyboard focus, resumed
        // on focusout — never paused permanently. HOME-11: the pointer
        // merely hovering the carousel no longer pauses it (mouseenter/
        // mouseleave listeners removed).
        function startAutoAdvance() {
          stopAutoAdvance();
          // CR-01: the phone-width guard must be checked here (the single
          // choke point every call site — bottom-of-script startup,
          // focusout, the autoplay toggle, showCarousel(), the
          // reduced-motion listener, and the manual-nav resumes in
          // goToPrev/goToNext/goToIndex — already funnels through) rather
          // than duplicated at each call site.
          if (autoAdvancePausedByUser || phoneViewport.matches || root!.dataset.displayMode !== 'carousel') return;
          timer = setInterval(() => {
            carouselIndex = (carouselIndex + 1) % galleries.length;
            // quick-260803-bvu (Item 1): auto-advance must always look like
            // a plain crossfade, never the manual peek/drag slide — see the
            // `is-auto-snap` CSS comment and render()'s `forceCrossfade`
            // comment for the full diagnosis. `heroPhoto` is declared later
            // in this script but this callback only ever runs after the
            // whole script (including that declaration) has executed once,
            // via startAutoAdvance()'s own first call at the bottom.
            if (heroPhoto) {
              heroPhoto.classList.add('is-auto-snap');
              render(true);
              // Forces the un-eased transform reset to commit before
              // transitions are re-enabled below (same forced-reflow
              // pattern as .is-opening elsewhere in this file).
              void heroPhoto.offsetWidth;
              // quick-260803-bvu (Item 1): is-auto-snap must stay present
              // past render()'s own deferred crossfade (a 60ms delay, then
              // the 260ms opacity transition itself — see the
              // forceCrossfade branch inside render()). If it were removed
              // synchronously here instead, and the pointer is still
              // hovering, is-tracking would immediately reclaim the sharp
              // image's transition rule (it also sets `transition: none`)
              // and silently re-swallow the crossfade partway through.
              // Tradeoff, accepted: if the pointer happens to leave the
              // photo (a genuine mouseleave recede) within this ~400ms
              // window, that recede's own eased transform is forced
              // instant instead — a narrow, low-impact edge case, and only
              // for a single auto-advance tick's window.
              window.setTimeout(() => {
                heroPhoto!.classList.remove('is-auto-snap');
              }, 400);
            } else {
              render(true);
            }
          }, 6000);
          setFillPaused(false);
          restartFill();
        }

        function syncAutoplayControl() {
          if (!autoplayToggle) return;
          autoplayToggle.classList.toggle('is-paused', autoAdvancePausedByUser);
          autoplayToggle.setAttribute('aria-pressed', String(autoAdvancePausedByUser));
          autoplayToggle.setAttribute(
            'aria-label',
            autoAdvancePausedByUser
              ? autoplayToggle.dataset.labelPlay ?? ''
              : autoplayToggle.dataset.labelPause ?? '',
          );
        }

        autoplayToggle?.addEventListener('click', () => {
          hasUserChosenAutoplay = true;
          autoAdvancePausedByUser = !autoAdvancePausedByUser;
          syncAutoplayControl();
          if (autoAdvancePausedByUser) {
            stopAutoAdvance();
          } else {
            startAutoAdvance();
          }
        });

        reduceMotionQuery.addEventListener('change', (event) => {
          if (hasUserChosenAutoplay) return;
          autoAdvancePausedByUser = event.matches;
          syncAutoplayControl();
          if (autoAdvancePausedByUser) stopAutoAdvance();
          else startAutoAdvance();
        });

        // CR-01: a resize/orientation change crossing the 767px breakpoint
        // (e.g. rotating a tablet, or a desktop window narrowed past it)
        // must (re)apply the phone-width gate live, not just at initial
        // load. startAutoAdvance() already no-ops if paused-by-user or
        // still below the breakpoint, so this is safe to call
        // unconditionally on the "now wider" transition.
        phoneViewport.addEventListener('change', () => {
          if (phoneViewport.matches) stopAutoAdvance();
          else startAutoAdvance();
        });

        function showCarousel() {
          root!.dataset.displayMode = 'carousel';
          hero!.hidden = false;
          grid!.hidden = true;
          startAutoAdvance();
        }

        function showGrid() {
          root!.dataset.displayMode = 'grid';
          hero!.hidden = true;
          grid!.hidden = false;
          stopAutoAdvance();
          // quick-260726-u97: a lingering peek can't survive a mode switch
          // (forward reference, safe — see render()'s own call above).
          if (hoverCapable) resetPeek();
        }

        hero.addEventListener('focusin', stopAutoAdvance);
        hero.addEventListener('focusout', startAutoAdvance);

        // quick-260725-dcg (Fix 3): resets the 6000ms countdown (and, via
        // startAutoAdvance()'s own setFillPaused/restartFill calls, re-syncs
        // the fill) on manual navigation — but only when auto-advance is
        // currently running (timer !== null). This preserves keyboard-focus
        // pause (the timer is null while focused, so manual nav won't
        // secretly restart auto-advance) and the explicit-pause state; when
        // paused, render()'s own restartFill() call still relocates the fill
        // to the new dash, but is-autoplay-paused keeps it frozen.
        function goToPrev() {
          carouselIndex = (carouselIndex - 1 + galleries.length) % galleries.length;
          render();
          if (timer !== null) startAutoAdvance();
        }

        function goToNext() {
          carouselIndex = (carouselIndex + 1) % galleries.length;
          render();
          if (timer !== null) startAutoAdvance();
        }

        function goToIndex(i: number) {
          if (i < 0 || i >= galleries.length || i === carouselIndex) return;
          carouselIndex = i;
          render();
          if (timer !== null) startAutoAdvance();
        }

        progressDashes.forEach((dash) => {
          dash.addEventListener('click', () => {
            const i = Number(dash.dataset.index);
            if (!Number.isNaN(i)) goToIndex(i);
            // HOME-11 fallout fix: a mouse click on this <button> leaves it
            // holding DOM focus in Chromium, which — now that hover no
            // longer pauses/resumes (D-01) — would permanently freeze
            // auto-advance via the focusin/focusout pair (D-02) until the
            // user tabs elsewhere. `:focus-visible` distinguishes a real
            // keyboard-driven focus (kept, so D-02's Tab-in pause still
            // works) from this mouse-click focus (blurred immediately, so
            // the timer resumes via `focusout`).
            if (!dash.matches(':focus-visible')) dash.blur();
          });
        });

        // Direct request: arrow-key navigation, only while the carousel
        // (not the grid) is showing, and only when focus isn't inside a
        // form control elsewhere on the page (About/Contact share this
        // layout's header, and a stray ArrowLeft/ArrowRight while typing
        // in an <input> shouldn't hijack the carousel).
        document.addEventListener('keydown', (event) => {
          // CR-01 (see IN-01): the dataset check alone never gates this off
          // on a phone, for the same reason startAutoAdvance() needed its
          // own explicit phoneViewport check above.
          if (root!.dataset.displayMode !== 'carousel' || phoneViewport.matches) return;
          const target = event.target as HTMLElement | null;
          if (target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            goToPrev();
          } else if (event.key === 'ArrowRight') {
            event.preventDefault();
            goToNext();
          }
        });

        // Direct request: swipe support on mobile. touchstart/touchend
        // (not touchmove) — only the net horizontal distance matters, and
        // this avoids fighting the browser's own vertical scroll handling
        // mid-gesture. Horizontal delta must clearly exceed vertical delta
        // (SWIPE_DIRECTION_RATIO) before it's treated as a swipe, so an
        // intentional vertical scroll over the hero never triggers a
        // gallery change.
        const SWIPE_MIN_DISTANCE = 50;
        const SWIPE_DIRECTION_RATIO = 1.5;
        let touchStartX = 0;
        let touchStartY = 0;
        const heroPhoto = hero.querySelector<HTMLElement>('.home-hero__photo');
        heroPhoto?.addEventListener('touchstart', (event) => {
          const touch = event.changedTouches[0];
          if (!touch) return;
          touchStartX = touch.clientX;
          touchStartY = touch.clientY;
        }, { passive: true });
        // quick-260726-u97: mobile tap-to-open — extends this SAME handler
        // (not a second touch listener) so it composes cleanly with the
        // swipe it already detects. A genuine tap (negligible movement on
        // both axes) opens the current gallery; a real horizontal swipe
        // navigates (unchanged, above); a vertical scroll-drag (large
        // deltaY) is neither, so it correctly does nothing — a tap never
        // fires mid-swipe and never hijacks a vertical scroll.
        const TAP_MAX_MOVEMENT = 10;
        heroPhoto?.addEventListener('touchend', (event) => {
          // D-11 (20-REVIEW.md CR-01): a tap that bubbles up from a caption
          // control — a progress dash or the autoplay toggle — must not be
          // reinterpreted as a tap-to-open. Mirrors the existing desktop
          // click handler's own .home-hero__caption exclusion below. This
          // guard belongs HERE (not in the new mobile scroll deck) because
          // this handler stays live for touchscreen tablets at 768px and
          // wider (phase success criterion 5).
          const target = event.target as HTMLElement | null;
          if (target?.closest('.home-hero__caption')) return;
          const touch = event.changedTouches[0];
          if (!touch) return;
          const deltaX = touch.clientX - touchStartX;
          const deltaY = touch.clientY - touchStartY;
          const direction = detectSwipeDirection(deltaX, deltaY, SWIPE_MIN_DISTANCE, SWIPE_DIRECTION_RATIO);
          if (direction === 'next') {
            goToNext();
            return;
          }
          if (direction === 'prev') {
            goToPrev();
            return;
          }
          if (Math.abs(deltaX) <= TAP_MAX_MOVEMENT && Math.abs(deltaY) <= TAP_MAX_MOVEMENT) {
            openCurrent();
          }
        }, { passive: true });

        // D3: reuses the current slide's title link — its href AND its
        // existing click listener (which already calls setCrossDocPhoto())
        // — rather than duplicating routing or morph-naming. Works
        // identically on desktop (center-zone click) and touch (tap-to-open
        // above). The `opening` guard is the only re-entrancy protection
        // this feature needs: on a hybrid touchscreen-laptop a tap can fire
        // BOTH touchend (tap-to-open) and a synthesized click (desktop
        // center-open click handler below), and native navigation must not
        // be triggered twice.
        let opening = false;
        // quick-260727-bsm (Bug C — abrupt edge-click pop): guards
        // commitEdge()'s in-flight peek-to-full-slide-then-swap sequence —
        // see commitEdge() below.
        let committing = false;
        function openCurrent() {
          if (opening) return;
          opening = true;
          if (heroPhoto) {
            // Synchronous, un-eased reset (via .is-opening disabling the
            // transition below, plus the forced reflow) so the outgoing
            // cross-document `hero-photo` View Transition snapshot captures
            // the photo at rest, never mid-push, even if an edge-peek
            // parallax was still easing back when this fired.
            heroPhoto.classList.add('is-opening');
            heroPhoto.style.setProperty('--peek-shift', '0');
            void heroPhoto.offsetWidth;
          }
          if (titleEl) {
            titleEl.click();
          } else {
            const fallbackHref = galleries[carouselIndex]?.href;
            if (fallbackHref) window.location.href = fallbackHref;
          }
        }

        // quick-260726-u97 (sketch 008 Variant C): the custom hover cursor +
        // edge-zone/peek interaction that replaces the removed scroll-to-open
        // gesture. Entirely inert on touch/coarse-pointer — matchMedia here
        // (not just the CSS media query) means none of this JS ever wires up
        // on a touchscreen; the mobile fallback is a plain tap (Task 5).
        const hoverCapable = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        const EDGE_ZONE_FRACTION = 0.22;
        const PEEK_MAX_PUSH_FRACTION = 0.16;
        let currentZone: 'center' | 'left' | 'right' = 'center';
        let currentProximity = 0;
        // Declared at this outer scope (not nested inside the hoverCapable
        // block below) so render()/showGrid() — defined earlier in this
        // script but only ever invoked after every declaration here has
        // run — can call them unconditionally; both no-op safely when the
        // elements are null (touch, or markup ever missing).
        let peekPrev: HTMLImageElement | null = null;
        let peekNext: HTMLImageElement | null = null;

        function resetPeek() {
          if (!heroPhoto) return;
          heroPhoto.style.setProperty('--peek-shift', '0');
          if (peekPrev) peekPrev.style.transform = 'translateX(-100%)';
          if (peekNext) peekNext.style.transform = 'translateX(100%)';
          // quick-260727-iao: a synchronous snap (not just the eased rAF
          // pump below) so a post-swap reset under .is-opening lands the
          // seam on the current-full extreme immediately, with no stale
          // peek frame left over from before the swap. lastPeekZone is
          // deliberately left as-is (not reset here) so a genuine
          // mouseleave recede eases the seam toward the SAME extreme the
          // photo is also receding toward, in sync.
          syncWordmarkLayers();
          // quick-260727-bsm (Bug A): the mouseleave recede AND every
          // render() swap (render() calls resetPeek() in its hoverCapable
          // block) both change the photo's transform — keep the wordmark
          // synced through the ease-settle here too.
          keepWordmarkSynced();
        }

        // quick-260726-u97 (sketch 008 Variant C, exact sketch coefficients):
        // ports the sketch's parallax-push math directly — current photo
        // pushes at most 16% of its own width, prev/next slide in at a
        // full 100% rate, so the adjacent layer always covers the vacated
        // gap (no background ever shows through).
        function updatePeek() {
          if (!heroPhoto) return;
          if (reduceMotionQuery.matches) {
            // Decorative only — reduced-motion visitors get no parallax
            // (the cursor's own arrow still signals direction).
            resetPeek();
            return;
          }
          if (currentZone === 'left') {
            lastPeekZone = 'left';
            heroPhoto.style.setProperty('--peek-shift', `${currentProximity * PEEK_MAX_PUSH_FRACTION * 100}%`);
            if (peekPrev) peekPrev.style.transform = `translateX(${-100 + currentProximity * 100}%)`;
            if (peekNext) peekNext.style.transform = 'translateX(100%)';
          } else if (currentZone === 'right') {
            lastPeekZone = 'right';
            heroPhoto.style.setProperty('--peek-shift', `${-currentProximity * PEEK_MAX_PUSH_FRACTION * 100}%`);
            if (peekNext) peekNext.style.transform = `translateX(${100 - currentProximity * 100}%)`;
            if (peekPrev) peekPrev.style.transform = 'translateX(-100%)';
          } else {
            resetPeek();
            return;
          }
          // quick-260727-bsm (Bug A): covers the active-mousemove push AND
          // the retarget-then-settle — 500ms comfortably exceeds the 420ms
          // transform transition so the sync loop keeps running through the
          // ease after the mouse stops moving. The `resetPeek()` branch
          // above already calls this itself (and returns before reaching
          // here), so this only fires for the left/right push branches.
          keepWordmarkSynced();
        }

        // quick-260727-bsm (Bug C — abrupt edge-click pop): an edge-zone
        // CLICK used to swap heroImg.src synchronously via goToPrev()/
        // goToNext() while the photo was still at its peek-pushed offset,
        // then resetPeek() eased it back in the WRONG direction relative to
        // the peek the user just watched — an abrupt "pop". This instead
        // continues the in-progress peek to a FULL slide (easing from
        // wherever the current proximity left off, not resetting first),
        // then swaps content synchronously (transitions disabled via the
        // existing .is-opening class) once the peek layer has fully arrived
        // — at that instant the incoming photo sits at translateX(0),
        // exactly where the outgoing heroImg (now advanced) will render, so
        // the swap is pixel-coincident with no pop, no third-image flash,
        // and no directional reversal. Only the desktop edge-zone CLICK
        // path uses this — keyboard/dash/swipe/auto-advance keep calling
        // goToPrev()/goToNext()/goToIndex() directly, unchanged.
        function commitEdge(direction: 'prev' | 'next') {
          if (committing || opening) return;
          if (!heroPhoto || reduceMotionQuery.matches) {
            // No peek to continue (reduced-motion never shows one, and
            // without heroPhoto there's nothing to animate) — the plain
            // swap is correct here.
            if (direction === 'next') goToNext();
            else goToPrev();
            return;
          }
          committing = true;
          const photo = heroPhoto;

          // quick-260727-drq (Bug 1): removed BEFORE setting the full-slide
          // targets below so the edge-click commit re-engages the 420ms
          // ease (a discrete moment, not continuous tracking).
          photo.classList.remove('is-tracking');

          // quick-260727-iao: g04's commit-time has-wordmark-photo/
          // --wordmark-photo removal is RETIRED — with the mirrored-peek
          // three-layer stack (Task 2/3) there is always a correct photo to
          // show at every proximity (the active peek layer's own
          // independently-clamped crop), so the "give up and go solid
          // because the drq clamp froze the single old layer" failure mode
          // this used to work around no longer exists. has-wordmark-photo
          // now stays present continuously through the commit (the normal,
          // cached-adjacent-photo case never toggles it at all); the seam
          // is what visibly slides instead. render()'s own start-of-swap
          // has-wordmark-photo removal (the genuine loading/error fallback
          // for an uncached hero) is untouched below.
          lastPeekZone = direction === 'next' ? 'right' : 'left';

          if (direction === 'next') {
            photo.style.setProperty('--peek-shift', '-100%');
            if (peekNext) peekNext.style.transform = 'translateX(0)';
          } else {
            photo.style.setProperty('--peek-shift', '100%');
            if (peekPrev) peekPrev.style.transform = 'translateX(0)';
          }
          // quick-260727-iao: the wordmark cutout is visible (not solid ink)
          // throughout the commit now, so the sync pump is meaningful again
          // — it drives the seam continuously from the LIVE
          // heroImg.getBoundingClientRect() through the ~420ms eased slide,
          // mirroring the photo's own peek layers sliding in underneath.
          keepWordmarkSynced(500);

          const relevantLayer = direction === 'next' ? peekNext : peekPrev;
          let done = false;
          let fallbackTimer: ReturnType<typeof setTimeout> | null = null;

          // Single-shot: guarded by `done` so transitionend and the
          // fallback timer can never both run it.
          function finish() {
            if (done) return;
            done = true;
            relevantLayer?.removeEventListener('transitionend', onTransitionEnd);
            if (fallbackTimer !== null) clearTimeout(fallbackTimer);
            // Synchronous, un-eased swap under .is-opening (reuses the
            // existing openCurrent()/View-Transition-snapshot transition-
            // disable rule) — advance the index, render() (swaps
            // heroImg.src to the now-cached, already-loaded adjacent photo:
            // instant showSharp, no fade — and resetPeek()s the layers to
            // neutral, all un-eased), force a reflow, then remove
            // .is-opening.
            photo.classList.add('is-opening');
            carouselIndex = direction === 'next'
              ? (carouselIndex + 1) % galleries.length
              : (carouselIndex - 1 + galleries.length) % galleries.length;
            render();
            void photo.offsetWidth;
            photo.classList.remove('is-opening');
            committing = false;
            // quick-260727-fc2: re-arm the continuous-tracking class once
            // the commit has fully settled. commitEdge() removed it above
            // (before setting its full-slide targets) for the discrete
            // commit itself, but never re-added it — so without this, every
            // peek AFTER the first edge-click commit in a single continuous
            // hover session reverted to the eased CSS transition,
            // reintroducing Bug 1's Safari transition-retarget jitter.
            // Guarded by the live hover signal (.is-cursor-active, added on
            // mouseenter / removed on mouseleave) so tracking is never left
            // armed while the pointer has actually left the photo during
            // the commit window.
            if (photo.classList.contains('is-cursor-active')) {
              photo.classList.add('is-tracking');
            }
            if (timer !== null) startAutoAdvance();
          }

          function onTransitionEnd(event: TransitionEvent) {
            if (event.propertyName !== 'transform') return;
            finish();
          }

          relevantLayer?.addEventListener('transitionend', onTransitionEnd);
          // 420ms transition + slack — guarantees finish() always runs even
          // if the transitionend event never fires (e.g. a null layer).
          fallbackTimer = setTimeout(finish, 480);
        }

        if (hoverCapable && heroPhoto) {
          const cursorEl = heroPhoto.querySelector<HTMLElement>('[data-role="hero-cursor"]');
          peekPrev = heroPhoto.querySelector<HTMLImageElement>('[data-role="peek-prev"]');
          peekNext = heroPhoto.querySelector<HTMLImageElement>('[data-role="peek-next"]');

          heroPhoto.addEventListener('mousemove', (event) => {
            // quick-260727-bsm (Bug C): a stray move mid-commit must not
            // rewrite --peek-shift and fight the in-progress full-slide
            // animation commitEdge() is driving.
            if (committing) return;
            const rect = heroPhoto.getBoundingClientRect();
            const x = event.clientX - rect.left;
            const y = event.clientY - rect.top;
            if (cursorEl) {
              cursorEl.style.transform = `translate(${x}px, ${y}px)`;
            }
            // quick-260803-bvu (Item 2): the progress dashes and the
            // pause/play toggle live inside .home-hero__caption, which sits
            // inside the left EDGE_ZONE_FRACTION band — so the accent
            // directional pill (.home-hero__cursor-ring, z-index 4) was
            // painting directly over them. is-over-controls (CSS below)
            // hides the custom cursor whenever the pointer is over the
            // caption and this skips the peek push entirely, restoring an
            // unobstructed hit area with the controls' own native pointer
            // cursor (.home-hero__progress-dash/.home-hero__autoplay-toggle
            // already set `cursor: pointer` explicitly, confirmed live —
            // that part was never broken, only the visual overlap was).
            const target = event.target as HTMLElement | null;
            const overControls = !!target?.closest('.home-hero__caption');
            heroPhoto.classList.toggle('is-over-controls', overControls);
            if (overControls) {
              currentZone = 'center';
              currentProximity = 0;
              if (cursorEl) {
                cursorEl.dataset.zone = 'center';
              }
              resetPeek();
              return;
            }
            const { zone, proximity } = computeHoverZone(x / rect.width, EDGE_ZONE_FRACTION);
            currentZone = zone;
            currentProximity = proximity;
            if (cursorEl) {
              cursorEl.dataset.zone = zone;
            }
            updatePeek();
          });

          heroPhoto.addEventListener('mouseenter', () => {
            heroPhoto.classList.add('is-cursor-active');
            // quick-260727-drq (Bug 1): arms the instant, un-eased peek
            // transform for the whole hover — removed only right before the
            // two discrete moments (mouseleave's resetPeek() below, and
            // commitEdge()'s full-slide targets) so those keep the 420ms
            // ease.
            heroPhoto.classList.add('is-tracking');
          });

          heroPhoto.addEventListener('mouseleave', () => {
            heroPhoto.classList.remove('is-cursor-active');
            // quick-260803-bvu (Item 2): belt-and-braces — a mouseleave that
            // fires while the pointer was last over the caption (a fast
            // exit can skip an intermediate mousemove) must not leave the
            // cursor permanently hidden for the next hover session.
            heroPhoto.classList.remove('is-over-controls');
            currentZone = 'center';
            currentProximity = 0;
            if (cursorEl) {
              cursorEl.dataset.zone = 'center';
            }
            // quick-260727-drq (Bug 1): removed BEFORE resetPeek() below so
            // the recede back to neutral re-engages the 420ms ease.
            heroPhoto.classList.remove('is-tracking');
            // quick-260727-bsm (Bug C): a commit already in flight owns the
            // peek layers' animation to full-slide — resetting them here
            // would fight it. finish()'s own render()->resetPeek() call
            // handles the neutral reset once the commit completes.
            if (!committing) resetPeek();
          });

          // Desktop click: center zone opens the current gallery, edge
          // zones commit the in-progress peek to a full slide then swap
          // (commitEdge — Bug C). Clicks inside .home-hero__caption are
          // ignored so the title link, progress dashes, and autoplay toggle
          // keep their own existing handlers — they must never be hijacked
          // by zone navigation.
          heroPhoto.addEventListener('click', (event) => {
            if (committing || opening) return;
            const target = event.target as HTMLElement;
            if (target.closest('.home-hero__caption')) return;
            if (currentZone === 'left') {
              commitEdge('prev');
            } else if (currentZone === 'right') {
              commitEdge('next');
            } else {
              openCurrent();
            }
          });
        }

        // D-01/D-02/D-03: a single stateful button — its aria-label always
        // names the mode you'd switch TO, read off its own data-label-*
        // attributes (the plain module script can't read frontmatter vars).
        const modeToggleBtn = root.querySelector<HTMLButtonElement>('[data-role="mode-toggle"]');

        // Shared-element morph target: the grid gallery tiles (hero tile
        // excluded — it has no matching carousel slide), queried once
        // alongside the other element lookups above. gridGalleryTiles[i]
        // corresponds 1:1 with galleries[i]/carouselIndex, since both derive
        // from the same server-rendered gallery order.
        const gridGalleryTiles = Array.from(
          grid.querySelectorAll<HTMLElement>('.home-grid__tile:not(.home-grid__tile--hero)'),
        );
        let namedMorphTile: HTMLElement | null = null;

        // Narrow local typing for the View Transitions DOM API — avoids
        // depending on lib.dom's (not-yet-universal) ViewTransition types
        // just to feature-detect and call it.
        type VTDocument = Document & {
          startViewTransition?: (cb: () => void) => {
            finished: Promise<void>;
            ready: Promise<void>;
            updateCallbackDone: Promise<void>;
          };
        };
        const vtDoc = document as VTDocument;

        modeToggleBtn?.addEventListener('click', () => {
          // Stop the periodic attention-pulse (see .home-toggle--used in
          // the <style> block) for good once the visitor has actually
          // found and used the control — no reason to keep nudging it.
          modeToggleBtn.classList.add('home-toggle--used');

          const goingToGrid = root!.dataset.displayMode === 'carousel';

          // Accessible name flips synchronously, outside the transition
          // callback — correct even before the (possibly deferred-a-frame)
          // DOM mutation below runs.
          modeToggleBtn.setAttribute(
            'aria-label',
            goingToGrid ? modeToggleBtn.dataset.labelCarousel ?? '' : modeToggleBtn.dataset.labelGrid ?? '',
          );

          // Re-point the shared-element morph name to whichever gallery the
          // carousel currently shows (it auto-advances), so both toggle
          // directions morph the correct tile rather than always the first.
          if (namedMorphTile) {
            namedMorphTile.style.viewTransitionName = '';
          }
          const morphTarget = gridGalleryTiles[carouselIndex] ?? null;
          if (morphTarget) {
            morphTarget.style.viewTransitionName = 'ajs-hero-morph';
          }
          namedMorphTile = morphTarget;

          // HOME-06 (D-10/D-12): .home-hero__photo/.home-hero__accent no
          // longer carry a permanent, unconditional view-transition-name in
          // CSS (see their <style> comments) — name them here instead,
          // synchronously before startViewTransition() is called, exactly
          // mirroring how morphTarget/namedMorphTile above are assigned:
          // set on click, left in place (not proactively reverted to '').
          // Deliberately NOT cleared via transition.finished — an earlier
          // version of this fix did that, but a second toggle click fired
          // before the first transition's `finished` promise settled races
          // the cleanup against the second click's own naming, sometimes
          // clearing the name while the second transition is still capturing
          // its snapshot (confirmed as the cause of a real, reproducible
          // failure in the existing accent-panel fade-timing test — the
          // named pseudo-element silently failed to materialize). Leaving
          // the name in place after the first interaction is safe: it still
          // fully addresses the D-10 hypothesis (the element carries no name
          // at first paint / before any interaction, which is the scenario
          // the reported mobile regression is about), it just no longer
          // reverts to unnamed between later toggles — same persistence
          // model gridGalleryTiles' morphTarget already uses.
          if (heroPhoto) heroPhoto.style.viewTransitionName = 'ajs-hero-morph';
          if (accentPanel) accentPanel.style.viewTransitionName = 'ajs-accent-panel';

          const mutate = goingToGrid ? showGrid : showCarousel;

          if (typeof vtDoc.startViewTransition === 'function') {
            // WebKit can expose the entering accent-panel pseudo-element at
            // its final opacity as soon as `ready` resolves, ignoring the
            // intended delayed entrance. Keep the real panel (and therefore
            // its new-state capture) transparent until the photo transition
            // has finished, then restore its normal CSS opacity. This guard
            // is only needed when the panel enters (grid -> carousel).
            const guardedAccentPanel = goingToGrid ? null : accentPanel;
            guardedAccentPanel?.style.setProperty('opacity', '0');

            const transition = vtDoc.startViewTransition(mutate);
            if (guardedAccentPanel) {
              const revealAccentPanel = () => {
                guardedAccentPanel.style.removeProperty('opacity');
                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

                // The View Transition overlay is gone, so this animation
                // affects the real panel rather than another engine-owned
                // snapshot. Cancel after completion to hand opacity back to
                // the component stylesheet without a visual discontinuity.
                const fade = guardedAccentPanel.animate(
                  [{ opacity: 0 }, { opacity: 1 }],
                  {
                    duration: 320,
                    easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
                    fill: 'both',
                  },
                );
                const releaseFade = () => fade.cancel();
                void fade.finished.then(releaseFade, releaseFade);
              };
              void transition.finished.then(revealAccentPanel, revealAccentPanel);
            }
          } else {
            mutate();
          }
        });

        // quick-260725-tqs (Item 6, Part C): land on the gallery requested
        // by DetailHero's scroll-up-to-return gesture (?carousel=<slug>).
        // SECURITY (T-tqs-01, mitigate): matched via findIndex against the
        // already-known, already-safe `galleries` array — never used to
        // build a DOM/attribute selector string, so the untrusted URL param
        // can never become a selector-injection sink. An unknown/absent
        // slug harmlessly leaves carouselIndex at its default (0).
        const requested = new URLSearchParams(window.location.search).get('carousel');
        if (requested) {
          const i = galleries.findIndex((g) => g.slug === requested);
          if (i >= 0) carouselIndex = i;
        }

        render();
        syncAutoplayControl();
        startAutoAdvance();

        // HOME-16/D-05: a random-per-visit STARTING accent, layered on top
        // of the render() call above rather than folded into it — only the
        // panel-level accent custom properties + accentPanel.style.color
        // change here; carouselIndex/heroImg/titleEl/indexLabel/
        // progressDashes stay exactly as render() already left them
        // (gallery 0, or the ?carousel=<slug> target above). Every
        // subsequent render() call (auto-advance/dash/keyboard/swipe)
        // continues to derive the accent from galleries[carouselIndex]
        // exactly as before — this override only ever runs once, here, for
        // the initial paint.
        //
        // Deliberately excludes --wordmark-photo-filter: that property is
        // NOT part of "the accent" this randomizes — it's a brightness/
        // contrast heuristic tuned to the PHOTO currently revealed through
        // the wordmark's letter-shaped cutout (still gallery 0's own photo,
        // untouched by this override) and correlated with THAT SAME
        // gallery's own heroTextColor (a naturally-dark photo is paired with
        // a white-text accent site-wide, and needs its filter "lifted"
        // rather than darkened — see the render()/wordmarkPhotoFilter
        // comment). render()'s initial call above already set it correctly
        // from gallery 0's own data; overriding it from the randomly-picked
        // gallery's (different) text color would apply the wrong photo's
        // brightness heuristic to gallery 0's actual photo.
        root!.classList.add('is-accent-init');
        const randomIndex = pickRandomGalleryIndex(galleries.length);
        const randomGallery = galleries[randomIndex];
        const randomFallback = ACCENTS[randomIndex % ACCENTS.length];
        const randomAccent = randomGallery?.heroColor
          ? { bg: randomGallery.heroColor, text: randomGallery.heroTextColor ?? 'var(--color-on-accent)' }
          : randomFallback;
        root!.style.setProperty('--current-accent', randomAccent.bg);
        root!.style.setProperty('--current-accent-text', randomAccent.text);
        if (accentPanel) accentPanel.style.color = randomAccent.text;
        // Releases the transition suppression only after the new colour has
        // actually been painted — a single rAF can still land before paint,
        // so a double rAF is used (the first schedules the frame the browser
        // paints the override in, the second runs after that paint).
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            root!.classList.remove('is-accent-init');
          });
        });

        // Re-align the wordmark cutout on resize — both the hero photo's
        // rendered size and the wordmark's own position within it change
        // at different viewport widths (see the mobile-width overrides
        // above), so a stale computed --wordmark-bg-size/-position from a
        // previous width would drift out of alignment.
        let resizeTimer: ReturnType<typeof setTimeout> | null = null;
        window.addEventListener('resize', () => {
          if (resizeTimer) clearTimeout(resizeTimer);
          resizeTimer = setTimeout(syncWordmarkLayers, 100);
        });
      }
    </script>

    <script>
      // Phase 21 (HOME-15, D-01/D-02/D-03/D-04/D-12/D-15): the wordmark-to-
      // photo zoom driver — a SECOND, independent <script> block from the
      // carousel's own above. That script's swipe/hover/mode-toggle logic is
      // entirely inert below 767px now, and mixing the two would couple two
      // independently-gated concerns; this driver has its own reduced-
      // motion/phone-width gate and lifecycle instead.
      //
      // Ported from DetailHero.astro's pinned scroll-scrubbed driver (lines
      // 198-322), breakpoint direction inverted (max-width: 767px, not
      // min-width: 768px) and a scale/opacity payload instead of a
      // width/position tween. Progress is derived from the zoom track's own
      // getBoundingClientRect().top (D-02) — never a bounded div's scrollTop,
      // which was sketch-only scaffolding for side-by-side variant
      // comparison. The actual math (progress/scale/opacity/focus-origin) is
      // imported from src/lib/home-carousel.ts (plan 21-01), never
      // re-implemented inline here.
      //
      // Reversibility (D-04) is free: the zoom state is a pure function of
      // live scroll position, not a played animation, so scrolling back up
      // smoothly reverses the whole effect with no extra code.
      //
      // Plan 21-07 (`21-UAT.md` gap 2, root-caused in
      // `.planning/debug/homepage-scroll-zoom-handoff-glitch.md`): this
      // driver originally ported DetailHero.astro's `scroll`-event-listener
      // pattern verbatim, carrying forward its latent assumption that
      // `scroll` events fire densely and promptly enough to keep JS-driven
      // visual state in lockstep with the composited scroll position. That
      // assumption held on desktop (mouse-wheel/trackpad input, no touch
      // momentum, no coincident scroll-snap boundary at DetailHero's own
      // completion point) but broke on real iOS Safari: touch-momentum
      // scrolling plus this deck's `scroll-snap-stop: always` boundary
      // landing exactly at the zoom's own completion offset caused `scroll`
      // dispatch (and separately, plan 21-06's `IntersectionObserver`
      // arrival callback) to be throttled/coalesced past the moment native
      // `position: sticky` had already released — producing a stale,
      // mid-crossfade frame overlapping the already-arrived first slide.
      // The driver below therefore polls live geometry every painted frame
      // instead of waiting on either event. `DetailHero.astro` itself is
      // deliberately NOT changed by this plan — it is desktop-only, has no
      // touch momentum, and has no snap boundary at its own completion
      // point, so the original assumption still holds there.
      import {
        ZOOM_REVEAL_DISTANCE,
        computeZoomProgress,
        computeWordmarkZoomState,
        computeFocusOrigin,
        computeSlideVisibleRatio,
      } from '../lib/home-carousel';

      const root = document.querySelector<HTMLElement>('.home');
      const deckRoot = document.querySelector<HTMLElement>('[data-role="scroll-deck"]');
      const track = deckRoot?.querySelector<HTMLElement>('[data-role="zoom-track"]') ?? null;
      const wordmark = deckRoot?.querySelector<HTMLElement>('[data-role="zoom-wordmark"]') ?? null;
      const focusLetter = deckRoot?.querySelector<HTMLElement>('[data-role="zoom-focus-letter"]') ?? null;
      const photoLayer = deckRoot?.querySelector<HTMLElement>('[data-role="zoom-photo"]') ?? null;
      // Plan 21-06 (HOME-14, D-09/D-13/D-14): resolved alongside the other
      // deck element lookups. An empty array (no galleries, or the deck
      // itself absent) is a safe no-op for every arrival branch below.
      const slides = deckRoot ? Array.from(deckRoot.querySelectorAll<HTMLElement>('[data-role="deck-slide"]')) : [];

      // Every element above is optional — a silent no-op if the deck is
      // absent (e.g. the zero-galleries empty state, which never renders
      // `.home` at all), mirroring the existing script's own
      // `if (root && hero && grid && dataEl)` idiom.
      if (root && deckRoot && track && wordmark && focusLetter && photoLayer) {
        // Plan 21-06 (HOME-14, D-09/D-13/D-14): arrival-complete detection.
        // High (~0.98), not GalleryGrid.astro's 0.15 — because a
        // full-viewport slide can only reach that ratio once it is
        // genuinely settled: any intermediate scroll position necessarily
        // bleeds an adjacent slide into the viewport.
        const ARRIVAL_THRESHOLD = 0.98;
        // Tracks whether applyArrival() itself is the one that wrote the
        // live accent, so clearInlineStyles() only ever removes what THIS
        // driver set (see its own comment for why unconditional removal
        // would be unsafe).
        let arrivalAccentWritten = false;

        // Plan 21-07: replaces onArrival(entries), the IntersectionObserver
        // callback. Takes no arguments — reads window.innerHeight once, then
        // for each slide computes its own LIVE getBoundingClientRect() and
        // derives the arrival ratio via computeSlideVisibleRatio (plan
        // 21-07/src/lib/home-carousel.ts) instead of waiting on a browser-
        // batched intersection callback. The rising-edge guard (wasRevealed)
        // is carried forward verbatim — it is load-bearing for HOME-16's
        // per-visit random starting accent and must not be simplified away.
        function applyArrival() {
          const viewportHeight = window.innerHeight;
          slides.forEach((slide) => {
            const rect = slide.getBoundingClientRect();
            const ratio = computeSlideVisibleRatio(rect, viewportHeight);
            // The reveal is a live, two-directional state (arrives AND
            // departs, contrast GalleryGrid.astro's one-shot reveal) — D-14
            // — so scrolling back up must hide the description again.
            const reached = ratio >= ARRIVAL_THRESHOLD;
            const wasRevealed = slide.classList.contains('is-revealed');
            slide.classList.toggle('is-revealed', reached);

            // Only write the live accent on the rising edge (just became
            // arrived), never on every frame — and never at load, since at
            // scroll position 0 the pinned zoom stage fills the viewport so
            // no slide can reach the arrival ratio yet. That keeps HOME-16's
            // per-visit random starting accent (set once by the carousel's
            // own script, above) untouched until a slide genuinely settles.
            if (reached && !wasRevealed) {
              root!.style.setProperty('--current-accent', slide.dataset.heroColor || 'var(--color-accent)');
              root!.style.setProperty('--current-accent-text', slide.dataset.heroTextColor || 'var(--color-on-accent)');
              arrivalAccentWritten = true;
            }
          });
        }

        // Pitfall 4: the "A" glyph's real rendered position shifts once
        // Unbounded finishes loading (vs. a system-sans fallback) — this
        // function only computes from whatever rects are live RIGHT NOW;
        // callers are responsible for re-invoking it after document.fonts
        // has settled (see below) and on resize/orientationchange.
        function syncFocusOrigin() {
          const wordmarkRect = wordmark!.getBoundingClientRect();
          const focusRect = focusLetter!.getBoundingClientRect();
          const origin = computeFocusOrigin(wordmarkRect, focusRect);
          if (!origin) return;
          wordmark!.style.transformOrigin = `${origin.originX}% ${origin.originY}%`;
        }

        function onProgress(t: number) {
          const state = computeWordmarkZoomState(t);
          wordmark!.style.transform = `scale(${state.scale})`;
          wordmark!.style.opacity = String(state.wordmarkOpacity);
          photoLayer!.style.opacity = String(state.photoOpacity);
          // Sole driver of D-12's header hide (CSS already declared by plan
          // 21-04): 'true' while the zoom is still scrubbing, flipped to the
          // completed value ('false', still PRESENT — not removed) once
          // progress reaches 1, so the header fades back in once the zoom
          // finishes.
          root!.setAttribute('data-zoom-active', t < 1 ? 'true' : 'false');
        }

        function clearInlineStyles() {
          // Every property onProgress() writes above has a matching removal
          // here, so the CSS end-state (reduced-motion / desktop media
          // queries) can fully take over the instant this driver detaches —
          // copy this 1:1 whenever onProgress() gains a new write.
          wordmark!.style.removeProperty('transform');
          wordmark!.style.removeProperty('transform-origin');
          wordmark!.style.removeProperty('opacity');
          photoLayer!.style.removeProperty('opacity');
          root!.removeAttribute('data-zoom-active');

          // Plan 21-06 (HOME-14, D-13/D-14/D-15): under reduced motion the
          // CSS end state already makes every description permanently
          // visible on its own (21-04's `@media (prefers-reduced-motion:
          // reduce)` block), so the arrival class is reset here rather than
          // left stale from a prior attach — harmless no-op removal when it
          // was never set (e.g. this driver's very first, desktop-only
          // setup() call, before the loop has ever run).
          slides.forEach((slide) => slide.classList.remove('is-revealed'));

          // Only ever clears the two accent custom properties if THIS
          // driver actually wrote them. Unconditionally removing
          // --current-accent/--current-accent-text here would clobber the
          // carousel's own render()/HOME-16 random-start accent the very
          // first time this function runs on desktop (detach is the branch
          // that always executes on initial load there) — a stale
          // driver-written accent left behind after detaching would
          // otherwise silently override what the rest of the page computed.
          if (arrivalAccentWritten) {
            root!.style.removeProperty('--current-accent');
            root!.style.removeProperty('--current-accent-text');
            arrivalAccentWritten = false;
          }

          // Plan 21-07: reset the progress cache too, so a later re-attach
          // cannot skip its first paint by comparing computeProgress()'s
          // first live read against a stale value from before this detach.
          lastProgress = PROGRESS_SENTINEL;
        }

        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
        // Pitfall 2: this exact 767px value must match the CSS's own
        // `@media (max-width: 767px)` gate byte-for-byte — a stray 768px
        // (or min-width) would make the JS activate at a different width
        // than the CSS that shows the markup this driver depends on.
        const mobile = matchMedia('(max-width: 767px)');

        let rafId: number | null = null;
        let driverAttached = false;

        function computeProgress(): number {
          return computeZoomProgress(track!.getBoundingClientRect().top, ZOOM_REVEAL_DISTANCE);
        }

        // Plan 21-07: a value no real progress fraction (always in [0,1])
        // can equal, so the very first frame after a (re-)attach always
        // paints regardless of what the last-seen progress was before.
        const PROGRESS_SENTINEL = -1;
        let lastProgress = PROGRESS_SENTINEL;

        // Thin wrapper around onProgress(): short-circuits when the measured
        // progress hasn't changed since last frame, so a stationary page
        // performs zero style writes per frame (T-21-07-A), only the two
        // cheap rect reads inside computeProgress()/applyArrival(). This is
        // intentional PLAIN equality, not an epsilon — the value only
        // changes when the measured rect changes, so the exact endpoints (0
        // and 1) are still always reached and written; onProgress()'s own
        // body is untouched.
        function applyProgress(t: number) {
          if (t === lastProgress) return;
          lastProgress = t;
          onProgress(t);
        }

        // Plan 21-07: the single continuously-running rAF loop that
        // replaces both the `scroll`-event-driven update and the
        // IntersectionObserver arrival reveal. Progress AND arrival are both
        // re-derived from live getBoundingClientRect() on every painted
        // frame while attached — nothing here may be gated on a scroll
        // event or an observer callback, which is the entire mechanism fix
        // for `21-UAT.md` gap 2 (see
        // `.planning/debug/homepage-scroll-zoom-handoff-glitch.md`). Order
        // matters and is deliberate: progress first, arrival second, so
        // within any single frame the crossfade/header state and the
        // reveal state are always consistent with each other.
        function frame() {
          applyProgress(computeProgress());
          applyArrival();
          rafId = requestAnimationFrame(frame);
        }

        // Mirrors src/pages/404.astro's tick()/startPointerLoop()/
        // stopPointerLoop() pair — this repo's own existing
        // continuously-running rAF loop with an explicit start/stop
        // lifecycle — rather than inventing a new shape.
        function startLoop() {
          if (driverAttached) return;
          driverAttached = true;
          // Reset so the first frame after attach always paints, even if an
          // identical progress value was last seen before a prior detach.
          lastProgress = PROGRESS_SENTINEL;
          rafId = requestAnimationFrame(frame);
        }

        function stopLoop() {
          if (!driverAttached) return;
          driverAttached = false;
          // Cancelling without nulling the id (or nulling without
          // cancelling) is exactly the leak that would let a detached
          // driver keep repainting on desktop (T-21-07-A) — both must
          // happen together.
          if (rafId !== null) {
            cancelAnimationFrame(rafId);
            rafId = null;
          }
        }

        function setup() {
          if (reduceMotion.matches || !mobile.matches) {
            stopLoop();
            clearInlineStyles();
          } else {
            // Plan 21-07: if requestAnimationFrame isn't available at all,
            // there is no mechanism left to drive the reveal — fall back to
            // always-visible descriptions (mirrors GalleryGrid.astro's own
            // JS-without-IntersectionObserver branch, which this replaces)
            // and never start the loop.
            if (typeof requestAnimationFrame !== 'function') {
              slides.forEach((slide) => slide.classList.add('is-revealed'));
              return;
            }
            syncFocusOrigin();
            // No separate "run one pass immediately" call is needed here —
            // startLoop() resets lastProgress to its sentinel and schedules
            // a frame, which paints the correct state on the very next
            // animation frame, covering a mid-page reload or a resize/
            // orientationchange crossing the gate while already scrolled.
            startLoop();
          }
        }

        setup();
        reduceMotion.addEventListener('change', setup);
        mobile.addEventListener('change', setup);

        // Pitfall 4: re-measure the focus origin once the real Unbounded
        // font has actually swapped in, only while the driver is currently
        // attached (driverAttached also implies reduced-motion doesn't match
        // and phone width does) — measuring while the display font is still
        // a system-sans fallback produces a visibly wrong anchor.
        if (document.fonts) {
          document.fonts.ready.then(() => {
            if (driverAttached) syncFocusOrigin();
          });
        }

        // Reused verbatim from DetailHero.astro's own resize-debounce idiom
        // rather than introducing a ResizeObserver. The loop itself no
        // longer needs a forced repaint here — it already re-reads live
        // geometry every frame — but setup() must still re-run on
        // resize/orientationchange to re-evaluate the media-query gate and
        // re-measure the focus origin.
        let resizeTimer: ReturnType<typeof setTimeout> | null = null;
        window.addEventListener('resize', () => {
          if (resizeTimer) clearTimeout(resizeTimer);
          resizeTimer = setTimeout(setup, 100);
        });
        window.addEventListener('orientationchange', () => {
          if (resizeTimer) clearTimeout(resizeTimer);
          resizeTimer = setTimeout(setup, 100);
        });
      }
    </script>
  </section>
)}

<style>
  .home-empty {
    max-width: 640px;
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-md);
    text-align: center;
    font-size: 16px;
  }

  .home {
    position: relative;
  }

  /* HOME-10 (D-01/D-02/D-04, Phase 10 Plan 02): the homepage now renders
     the SAME <SiteHeader> component every other page uses (About/Contact/
     gallery-detail), with variant="transparent" fixed — RESEARCH.md
     Pattern 1, never swapped by JS. Everything below is ONLY the
     homepage-specific delta layered on top of SiteHeader's own is:global
     stylesheet: the header's view-transition identity (a homepage-only
     morph concern, unrelated to the 100svh/100vh mobile-hero math — see
     .home-hero__photo/.home-hero__accent below for that), and the
     [data-display-mode='grid'] re-skin that makes the fixed-transparent
     header LOOK solid without ever changing the prop (D-02). :global()
     wraps every selector fragment targeting markup owned by
     SiteHeader.astro/LanguageSwitcher.astro — Astro's own CSS scoping
     otherwise appends THIS file's scope id to only the rightmost compound
     selector, which would never match those files' own scope id. Same
     established pattern as the pre-existing :global(.switcher-link)
     override below (that one predates this refactor). */
  .home :global(.site-header) {
    /* Direct follow-up (quick-260713-jfz): same class of bug as
       .home-hero__accent's view-transition-name (see below) — unnamed, the
       header was just part of the flat root snapshot, and since it comes
       BEFORE .home-hero__photo in DOM order, default paint-order stacking
       would put its own group BELOW ajs-hero-morph too (root-relative
       DOM position, not just "unnamed vs named", determines default
       stacking — see the explicit z-index below, which is what actually
       fixes it). The morphing photo's box overlaps the header's screen
       area while growing/shrinking, fully blanking the logo/nav/toggle for
       a visible chunk of the transition — confirmed via a cropped
       mid-transition screenshot showing the header region completely
       empty. Naming it keeps it in its own group, painted above the morph
       regardless of DOM order. Unlike .home-hero__photo/.home-hero__accent
       (HOME-06 D-10/D-12), this element was NOT flagged as a mobile-hero
       regression suspect and keeps its permanent naming — the header's own
       positioning/sizing doesn't depend on 100svh/100vh math, so there is
       no equivalent "always-on naming at first paint" risk here. */
    view-transition-name: ajs-header;
    z-index: 5;
  }

  /* Grid mode: re-skin the fixed transparent header to look solid (D-02) —
     static position, no scrim, ink text — mirroring
     .site-header--solid's own look (SiteHeader.astro) without ever
     swapping SiteHeader's variant prop. Carousel mode needs no override
     here: .site-header--transparent's own default look (dark gradient
     scrim, white text) IS the carousel look, matching gallery-detail pages
     exactly — the unification this whole phase exists to deliver. */
  .home[data-display-mode='grid'] :global(.site-header--transparent) {
    position: static;
    background: none;
    color: var(--color-ink);
  }

  .home[data-display-mode='grid'] :global(.site-header--transparent .nav-link) {
    color: inherit;
  }

  /* Grid mode logo re-skin: SiteHeader's own transparent-variant CSS shows
     the white logo by default (correct for carousel mode) — grid mode
     needs to look like the solid variant instead (black logo default,
     white-on-dark-chip on hover), so this fully inverts the transparent
     variant's default/hover swap, mirroring .site-header--solid's own
     mechanic in SiteHeader.astro. */
  .home[data-display-mode='grid'] :global(.site-header--transparent .logo-mark__img--default) {
    display: block;
  }

  .home[data-display-mode='grid'] :global(.site-header--transparent .logo-mark__img--hover) {
    display: none;
  }

  .home[data-display-mode='grid'] :global(.site-header--transparent .logo-mark:hover .logo-mark__img--hover),
  .home[data-display-mode='grid'] :global(.site-header--transparent .logo-mark:focus-within .logo-mark__img--hover),
  .home[data-display-mode='grid'] :global(.site-header--transparent .logo-mark:hover .logo-mark__chip),
  .home[data-display-mode='grid'] :global(.site-header--transparent .logo-mark:focus-within .logo-mark__chip) {
    display: block;
  }

  .home[data-display-mode='grid'] :global(.site-header--transparent .logo-mark:hover .logo-mark__img--default),
  .home[data-display-mode='grid'] :global(.site-header--transparent .logo-mark:focus-within .logo-mark__img--default) {
    display: none;
  }

  /* Mode-aware chip color: the base .logo-mark__chip rule (SiteHeader.astro)
     is dark (--color-ink) for the solid variant's white hover-logo — grid
     mode reuses that same dark chip (it's re-adopting the solid look), so
     no override is needed here beyond restoring it against the transparent
     variant's own light-chip default. */
  .home[data-display-mode='grid'] :global(.site-header--transparent .logo-mark__chip) {
    background-color: var(--color-ink);
  }

  /* SiteHeader normally derives the switcher color from its variant. The
     homepage keeps variant="transparent" in the DOM while grid mode
     visually re-skins that same header as solid, so these mode-specific
     overrides keep the switcher synchronized with that runtime state.
     I18N-04/D-08 retired the current-language link + .switcher-separator
     element entirely — only .switcher-link remains to re-skin. */
  .home[data-display-mode='carousel'] :global(.site-header .switcher-link) {
    color: #FFFFFF;
  }

  .home[data-display-mode='grid'] :global(.site-header .switcher-link) {
    color: var(--color-ink);
  }

  /* HOME-05 (D-06, unchanged by Phase 10 — D-05 explicitly excludes the
     mode-toggle from the .home-* rename). Now composed via SiteHeader's
     named `extra` slot instead of being a direct child of the old inline
     <header>, but its own markup/behavior/CSS is untouched: an INVISIBLE,
     tappable outer box (44px floor via min-width/min-height) around the
     visible square .home-toggle__box below. */
  .home-toggle {
    display: inline-flex; /* matches .nav-link/.switcher-link so text
                              baselines line up across the whole header */
    align-items: center;
    justify-content: center;
    font-size: 14px; /* Label role */
    font-weight: var(--weight-regular);
    line-height: 1.5;
    color: inherit;
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    min-width: var(--tap-target-min);
    min-height: var(--tap-target-min);
  }

  /* HOME-10-REGRESSION: restores the per-mode color the removed
     .home-header container used to provide before Phase 10's SiteHeader
     refactor (d0b2772/3850e1d) — that refactor replaced the container-level
     rule with narrower .nav-link/.switcher-link overrides only, silently
     dropping the carousel-mode white override for .home-toggle. Setting
     color here cascades via currentColor to .home-toggle__box's border and
     each .home-toggle__morph-cell's background-color, mirroring the
     .switcher-link per-mode pattern above. */
  .home[data-display-mode='carousel'] .home-toggle {
    color: #FFFFFF;
  }

  .home[data-display-mode='grid'] .home-toggle {
    color: var(--color-ink);
  }

  /* Direct user feedback: the bare 20x20 icon (no border/background) didn't
     read as an interactive button among the nav's plain text links — give
     it a visible box so it looks distinctly clickable, matching the site's
     square-cornered (--radius-none) brutalist language rather than a
     rounded chip. D-08: sized tightly around the 20x14 icon (28px, a
     4px-grid multiple) rather than the full 44px tap-target box, for a
     visually compact header row — the tap-target floor lives on the outer
     .home-toggle button above instead. */
  .home-toggle__box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1.5px solid currentColor;
  }

  /* D-06.3: moved (not duplicated) from .home-toggle itself — painting the
     full invisible 44px hit box on hover would visually contradict the
     compact-square goal this fix exists to achieve. */
  .home-toggle:hover .home-toggle__box,
  .home-toggle:focus-visible .home-toggle__box {
    background-color: currentColor;
  }

  .home-toggle:hover .home-toggle__morph-cell,
  .home-toggle:focus-visible .home-toggle__morph-cell {
    /* Invert the cells' own fill against the now-solid currentColor
       background above (background-color, not color — each cell paints
       itself via background-color: currentColor, not an SVG stroke/fill),
       so they stay visible instead of disappearing into a same-color
       backdrop. The descendant combinator still resolves correctly through
       the intermediate .home-toggle__box wrapper. */
    background-color: var(--current-accent, var(--color-accent));
  }

  .home[data-display-mode='grid'] .home-toggle:hover .home-toggle__morph-cell,
  .home[data-display-mode='grid'] .home-toggle:focus-visible .home-toggle__morph-cell {
    background-color: var(--color-dominant);
  }

  /* Direct user feedback: draw temporary attention to the toggle so first-
     time visitors notice it exists, without permanently animating a control
     they've already found. A bounded pulse (3 iterations, ~1.5s total)
     starting shortly after the page settles. Direct follow-up feedback:
     visitors may not be looking at exactly that moment, so this repeats
     periodically (a brief double-pulse every 6s, mostly at rest in
     between) rather than firing once and going quiet for good — "pour
     attirer l'oeil" even without a click. Stops permanently once the
     visitor actually clicks it (see .home-toggle--used below, set by the
     click handler in the <script> block) — no reason to keep nudging a
     control they've already found and used. Respects
     prefers-reduced-motion throughout. Targets .home-toggle__box (the
     visible square), not the outer .home-toggle button (the invisible 44px
     hit box) — scaling the invisible box has no visible pulse effect. */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes home-toggle-attention {
      0%,
      75%,
      100% {
        transform: scale(1);
      }
      82%,
      92% {
        transform: scale(1.15);
      }
      87% {
        transform: scale(1);
      }
    }

    .home-toggle:not(.home-toggle--used) .home-toggle__box {
      animation: home-toggle-attention 6s ease-in-out infinite;
      animation-delay: 1.2s;
    }
  }

  /* D-01 (revised per direct user reference — a "carousel to grid material
     icon" morph animation, not a hard icon swap): a single 6-cell CSS grid
     icon (2 rows x 3 cols, matching the reference image exactly) whose gap
     animates between two states, rather than two separate SVGs shown/
     hidden via display. When gap is 0, each row's 3 cells sit flush against
     each other with no visible seam (same solid currentColor fill, no
     border) and read as one continuous bar — the carousel/list glyph. When
     gap opens up, the same 6 cells read as a 3x2 grid — the grid glyph.
     Only the gap value changes; the 6 elements themselves never move,
     resize, or get replaced, so the browser can animate the transition
     smoothly for free via `transition: gap`. */
  .home-toggle__morph {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    width: 20px;
    height: 14px;
    /* row-gap is fixed, never animated — it's what keeps the icon reading
       as "2 bars" even once each bar's 3 cells merge into one (see
       column-gap below). Animating the shorthand `gap` collapsed row-gap
       to 0 too, which merged all 6 cells into a single solid block instead
       of two distinct bars — confirmed via a live screenshot before this
       fix, not guessed. */
    row-gap: 2px;
    column-gap: 0;
    transition: column-gap 280ms ease;
  }

  .home-toggle__morph-cell {
    background-color: currentColor;
  }

  /* Icon shown is the icon of the mode you'd switch TO, mirroring the
     aria-label (unchanged from D-01's original intent) — carousel mode
     shows the grid glyph (gap open), grid mode shows the bars glyph
     (gap closed). */
  .home[data-display-mode='carousel'] .home-toggle__morph {
    column-gap: 2px;
  }

  .home[data-display-mode='grid'] .home-toggle__morph {
    column-gap: 0;
  }

  /* Carousel mode — full-viewport hero photo + scrim + caption + accent
     panel (D-08/D-09, UI-SPEC Layout Notes — Homepage Carousel mode).
     The UI-SPEC's original min-height floor (680px, then lowered to 600px)
     still cropped the hero on a real MacBook Air 13" (confirmed by direct
     user report both times) — any fixed floor can exceed an unknown real
     window's innerHeight. A viewport-relative floor fills the visible screen
     without chasing another guessed pixel value. */
  .home-hero {
    position: relative;
  }

  /* Photo + its overlaid chrome (scrim, arrows, caption) — sized
     independently of .home-hero__accent, which on mobile is an in-flow
     sibling below (see its mobile override) and would otherwise force
     .home-hero itself to grow taller than the photo. Everything visually
     "part of the photo" is absolutely positioned against *this* box, so it
     stays confined to the photo box no matter how tall .home-hero grows. */
  .home-hero__photo {
    position: relative;
    /* Explicit width required: without it, the browser treats aspect-ratio
       + max-height together as "solve for width" once max-height clamps
       the height, shrinking the hero narrower than the viewport (confirmed
       via live measurement — a 1920x700 window produced a 1244px-wide
       hero, leaving visible gaps left/right) instead of just capping
       height and keeping it full-bleed. */
    width: 100%;
    aspect-ratio: 16 / 9;
    /* Keep the photo between the small and large viewport heights. The
       minimum prevents 16:9 from exposing the footer in a tall desktop
       window; the maximum prevents a wide/short window from growing the
       hero beyond one screen. */
    min-height: 100svh;
    max-height: 100vh;
    overflow: hidden;
    /* HOME-06 (D-10/D-12) fix: view-transition-name is NO LONGER set here.
       quick-260713-jfz originally gave this element a permanent, unconditional
       `view-transition-name: ajs-hero-morph` — present at all times, including
       first paint, not just during an active transition. That asymmetry (the
       matching grid tile in gridGalleryTiles is only named dynamically, right
       before a transition, and unnamed again afterward) was the leading
       hypothesis for the reported mobile regression: a name that is "always
       on" is exactly the kind of permanent state that could interact badly
       with a real mobile browser's dynamic address-bar chrome collapsing on
       first load (D-10). A disable/re-enable experiment under Chromium
       mobile emulation showed no measurable difference either way (see
       07-02-SUMMARY.md) — this bug class is known to escape emulation (D-11)
       — so the hypothesis could not be directly confirmed here, but removing
       the permanent naming is still the correct, low-risk fix: it makes this
       element's naming symmetric with its grid-tile counterpart (both are
       now named only for the duration of an actual transition, via
       `heroPhoto.style.viewTransitionName` in the <script> below) and
       eliminates the "always named, even at rest" state entirely, without
       gating document.startViewTransition() to desktop (D-12). */
  }

  /* quick-260726-u97 (sketch 008 Variant C): the adjacent-gallery preview
     revealed as the current photo peels back. Rests fully off-screen
     (translateX ±100%); z-index below .home-hero__img so it stays hidden
     under the current photo except in the vacated gap the parallax push
     creates. Sources are set from real data (galleries[i-1]/[i+1]) in
     render() below, so this always tracks the current neighbours. */
  .home-hero__peek {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
  }

  .home-hero__peek--prev {
    transform: translateX(-100%);
  }

  .home-hero__peek--next {
    transform: translateX(100%);
  }

  .home-hero__img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* quick-260726-u97 (sketch 008 Variant C): the parallax-push peek
       shifts the current photo itself, driven by --peek-shift (written by
       updatePeek() in the <script> below; 0 at rest / in the center zone). */
    transform: translateX(var(--peek-shift, 0));
    transition: transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* HOME-09 (D-01/D-02/D-06): blur-up placeholder crossfade — two stacked
     <img> elements sharing the box above, not a single-<img> filter:blur()
     animation (see 09-UI-SPEC.md's hard requirement). The placeholder
     renders first in DOM order (paints beneath); the sharp layer starts
     transparent and fades to opaque once loaded (render() below toggles
     .is-loaded on every first paint and swap). quick-260726-u97: this
     element sets its own `transition`, which would otherwise clobber the
     base .home-hero__img rule's transform transition entirely — both are
     carried here so the crossfade AND the parallax push animate. */
  .home-hero__img--sharp {
    opacity: 0;
    transition: opacity 260ms ease, transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .home-hero__img--sharp.is-loaded {
    opacity: 1;
  }

  /* quick-260726-u97: instantaneous commit-reset hook — openCurrent()
     (Task 5) adds .is-opening to .home-hero__photo synchronously, right
     before resetting --peek-shift/the peek layers to their resting
     transform and forcing a reflow, so the reset itself never eases: the
     outgoing cross-document View Transition snapshot must capture the
     photo already at rest, not mid-recede. */
  .home-hero__photo.is-opening .home-hero__img,
  .home-hero__photo.is-opening .home-hero__peek {
    transition: none;
  }

  /* quick-260727-drq (Bug 1 — Safari peek-transition micro-jitter):
     .is-tracking is added on mouseenter and stays on for the whole
     continuous mousemove-driven peek push (removed only before the two
     discrete moments — mouseleave's resetPeek() and commitEdge()'s
     full-slide targets — so THOSE keep easing). Disabling the transition
     here means every per-mousemove --peek-shift/transform write applies
     instantly instead of retargeting an in-flight 420ms eased transition —
     WebKit interpolates that retargeting far more roughly than Chromium
     (the measured jitter), even though both engines are technically
     spec-compliant. */
  .home-hero__photo.is-tracking .home-hero__img,
  .home-hero__photo.is-tracking .home-hero__peek {
    transition: none;
  }

  /* quick-260803-bvu (Item 1 — auto-advance must always read as a plain
     crossfade, never a slide): confirmed live via getComputedStyle
     sampling (every 15-40ms across a real swap) that when the pointer is
     resting in an edge zone at the moment the 6000ms timer fires,
     .is-tracking's blanket `transition: none` above already makes the
     --peek-shift reset instantaneous — but it ALSO silences
     .home-hero__img--sharp's own opacity crossfade (same selector matches
     both classes), so the swap was an abrupt content-and-position POP with
     no visible fade at all, not the "slide" a static read of the code
     would suggest. Separately (confirmed the same way, pointer off the
     carousel entirely) the crossfade never played even without any hover
     involved: render()'s `classList.remove('is-loaded')` immediately
     followed by a synchronous re-add (once the next photo is already
     cached via the D-05 preload, the common case) never commits an
     intermediate frame, so the browser coalesces the two writes into a
     no-op and the opacity transition never triggers.
     .is-auto-snap — added around the auto-advance tick's render() call,
     and held for ~400ms (see the <script> below) so it outlives render()'s
     own deferred crossfade retrigger — fixes both: it forces the TRANSFORM
     half of the transition to be instant (so there is truly never a
     slide, regardless of hover state) while leaving
     .home-hero__img--sharp's OPACITY transition intact so the crossfade
     can actually play once render()'s forceCrossfade branch retriggers
     it. Specificity ties .is-tracking's rule above (also 3 classes) —
     declared after it here so it wins the cascade whether or not the
     pointer also happens to be hovering. Every other render() caller
     (dash click, keyboard, swipe,
     commitEdge) never sets this class, so their behavior is unchanged. */
  .home-hero__photo.is-auto-snap .home-hero__img,
  .home-hero__photo.is-auto-snap .home-hero__peek {
    transition: transform 0s;
  }

  .home-hero__photo.is-auto-snap .home-hero__img--sharp {
    transition: opacity 260ms ease, transform 0s;
  }

  .home-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0.15) 45%, rgba(0, 0, 0, 0) 70%);
  }

  /* Replaces the old prev/next arrow buttons. Direct follow-up feedback:
     moved from a full-width bar below the header to a compact one nested
     inside .home-hero__caption (bottom-left, in normal flow above the
     index/title/byline) — no absolute positioning of its own needed, it
     just sits wherever the caption already sits. Width is capped well
     under the caption's own 60% max-width per the "20-30% max of the page
     width" request — min() keeps it from ballooning on very wide desktop
     windows while staying comfortably tappable (3 dashes + gaps) on
     narrow phones. */
  .home-hero__carousel-controls {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    width: min(calc(25vw + 48px), 268px);
    margin: 0;
  }

  .home-hero__progress {
    display: flex;
    flex: 1 1 auto;
    gap: var(--space-xs);
    min-width: 0;
    margin: 0;
  }

  .home-hero__autoplay-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 var(--tap-target-min);
    width: var(--tap-target-min);
    height: var(--tap-target-min);
    padding: 0;
    color: #FFFFFF;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .home-hero__pause-icon {
    display: flex;
    gap: 4px;
  }

  .home-hero__pause-icon span {
    width: 2px;
    height: 12px;
    background: currentColor;
  }

  .home-hero__play-icon {
    display: none;
    width: 0;
    height: 0;
    margin-left: 2px;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    border-left: 11px solid currentColor;
  }

  .home-hero__autoplay-toggle.is-paused .home-hero__pause-icon {
    display: none;
  }

  .home-hero__autoplay-toggle.is-paused .home-hero__play-icon {
    display: block;
  }

  .home-hero__progress-dash {
    position: relative;
    flex: 1 1 0;
    height: 3px;
    padding: 0;
    border: none;
    border-radius: var(--radius-none);
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
  }

  /* Invisible hit-area extension — a 3px-tall bar is far below the
     var(--tap-target-min) (44px) accessible tap-target size, so this
     enlarges the clickable/tappable region vertically without changing
     the dash's own visual thickness. */
  .home-hero__progress-dash::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--space-md)) 0;
  }

  /* quick-260725-dcg (Fix 3): dim track for the current dash — brighter
     than the inactive dashes' rgba(255,255,255,0.35) so it stays
     identifiable at 0% fill, but no longer the solid accent itself; the
     opaque ::after fill (below) grows over it and covers it entirely by
     100%, matching today's solid-accent look at completion. */
  .home-hero__progress-dash[aria-current='true'] {
    background: rgba(255, 255, 255, 0.5);
  }

  /* Instagram-Stories-style accent fill on the current dash. Gated by a
     JS-managed .is-filling class (NOT tied to aria-current) so the a11y
     attribute stays untouched and restarts are deterministic (see
     restartFill() in the <script> block). No overflow: hidden is added to
     the dash itself — that would clip the negative-inset ::before
     tap-target — but scaleX stays within [0,1] so ::after never overflows
     the dash anyway. */
  .home-hero__progress-dash.is-filling::after {
    content: '';
    position: absolute;
    inset: 0;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--current-accent, var(--color-accent));
    animation: home-progress-fill 6000ms linear;
  }

  @keyframes home-progress-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* Freezes the fill mid-flight (preserving progress, not resetting)
     whenever the root carries is-autoplay-paused — set by
     stopAutoAdvance()/startAutoAdvance() so hover/focus pause, the
     explicit pause toggle, and grid mode all pause the fill through the
     same paths. */
  .home.is-autoplay-paused .home-hero__progress-dash.is-filling::after {
    animation-play-state: paused;
  }

  .home-hero__progress-dash:hover,
  .home-hero__progress-dash:focus-visible {
    background: rgba(255, 255, 255, 0.65);
  }

  .home-hero__progress-dash[aria-current='true']:hover,
  .home-hero__progress-dash[aria-current='true']:focus-visible {
    background: var(--current-accent, var(--color-accent));
  }

  .home-hero__progress-dash:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 3px;
  }

  /* quick-260725-dcg (Fix 3): no animated fill under reduced motion — the
     current dash reverts to today's static solid accent. */
  @media (prefers-reduced-motion: reduce) {
    .home-hero__progress-dash[aria-current='true'] {
      background: var(--current-accent, var(--color-accent));
    }

    .home-hero__progress-dash.is-filling::after {
      display: none;
    }

    /* quick-260726-u97: the parallax-push peek is decorative — under
       reduced motion the JS branch (updatePeek() below) skips it entirely
       and calls resetPeek() instead; this CSS override is the belt-and-
       braces guarantee that even a stray transform write can't animate.
       .home-hero__img--sharp keeps its opacity-only crossfade (HOME-09,
       untouched by this task). */
    .home-hero__peek,
    .home-hero__img {
      transition: none;
    }

    .home-hero__img--sharp {
      transition-property: opacity;
    }
  }

  .home-hero__caption {
    position: absolute;
    left: var(--space-md);
    /* Keep the caption in the part of the photo that is not occupied by
       the coloured panel. This prevents long statements from continuing
       underneath it on wide screens. Item 4: right calc tracks the panel's
       own narrower min(700px, 52%) width so the caption keeps clearing the
       (now further-right) panel edge. */
    right: calc(min(700px, 52%) + var(--space-3xl) + var(--space-md));
    max-width: 720px;
    bottom: var(--space-xl);
    /* Fixed tracks make the progress navigation stay at exactly the same
       vertical position when the active collection changes. Item 2: the
       byline/description row is removed — 3 tracks (controls/index/title)
       instead of 4, height recomputed accordingly (was 129px with the
       byline's 63px track + one row-gap). */
    display: grid;
    grid-template-rows: 3px 21px 30px;
    row-gap: var(--space-xs);
    height: 62px;
    z-index: 3;
    color: #FFFFFF;
  }

  .home-hero__index {
    font-size: 14px; /* Label role */
    font-weight: var(--weight-regular);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 var(--space-xs);
  }

  .home-hero__title {
    font-family: var(--font-display);
    font-size: 18px; /* Compact heading role */
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    margin: var(--space-sm) 0 0;
    color: #FFFFFF;
    /* quick-260726-obg: removed the persistent underline added by
       quick-260725-tqs (Item 3) per direct user feedback — matches
       DetailHero's non-underlined overlay title (a <p>, so it never had one
       in the first place). The accent-color hover/focus state below plus
       the custom hover cursor (quick-260726-u97) already on the ancestor
       .home-hero__photo remain the click affordances; no visible discovery
       hint replaces the underline. */
    text-decoration: none;
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /* On real-mouse desktop, .home-hero__photo (an ancestor) sets
       cursor: none — an inherited property — so the custom hover-cursor
       element can stand in for it. Without this explicit override the
       title link would inherit that none and lose its own pointer
       affordance while hovered directly. */
    cursor: pointer;
  }

  .home-hero__title:hover,
  .home-hero__title:focus-visible {
    color: var(--current-accent, var(--color-accent));
    /* quick-260726-obg: .home-hero__title is an <a> — without this,
       BaseLayout's global `a:hover, a:focus-visible { text-decoration:
       underline }` rule would re-underline it on hover/focus even though
       the base rule above now sets text-decoration: none at rest. */
    text-decoration: none;
  }

  /* quick-260726-u97 follow-up (live-verification fix): the base/resting
     properties that keep .home-hero__cursor invisible and OUT OF DOCUMENT
     FLOW must NOT be gated behind the (hover: hover) and (pointer: fine)
     media query below — on a device where that query never matches (any
     touchscreen), a gated-only rule means this element gets ZERO styling
     at all and falls back to browser defaults: position:static,
     display:block, opacity:1, full container width. Confirmed live on an
     emulated mobile context (390x844, hasTouch/isMobile) via
     getComputedStyle: a real laid-out block reading "OUVRIR→" in dark ink
     at the top of the photo — invisible in one screenshot purely by
     coincidence (the site header happened to paint over it in its own
     higher stacking context), not because it was actually inert. This
     ungated rule is the fix: position/opacity/pointer-events hold on EVERY
     device by default, regardless of whether the media query below ever
     matches. Everything else (sizing, colors, the zone-morph states, the
     activation opacity:1, transitions, and cursor:none on
     .home-hero__photo) correctly stays gated — those genuinely should only
     exist on real-mouse desktop, and .is-cursor-active is only ever added
     by the hoverCapable-gated script, so it can never fire on touch. */
  .home-hero__cursor {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
  }

  /* quick-260727-bsm (Bug B — Safari cursor jitter): the outer
     .home-hero__cursor is now a PURE position anchor — its only JS-driven
     property is `transform: translate(x, y)` (per-mousemove, see the
     <script> above), and it must never carry a `transform` transition on
     any browser. Safari coalesces/duplicates mousemove-driven inline style
     writes against an in-flight CSS transition on the same property in a
     way Chromium/WebKit-on-desktop tolerate better, producing a visible
     jitter/vibration; it also meant the scale() this outer element used to
     also own (transform: translate() scale()) was silently dropped on every
     mousemove, since the inline write only ever set translate(). Splitting
     position (outer, untransitioned) from the eased scale/geometry/color
     morph (inner .home-hero__cursor-ring, its own independent transition)
     fixes both: position updates are instant everywhere, and scale can ease
     without fighting position on every frame. */
  .home-hero__cursor-ring {
    position: absolute;
    top: 0;
    left: 0;
  }

  /* quick-260726-u97 (sketch 008 Variant C): the custom hover cursor,
     gated entirely to real-mouse desktop — (hover: hover) and
     (pointer: fine) never both match on a touchscreen, so none of this
     activates there and the native default cursor + a plain tap (Task 5)
     are all a touch visitor ever sees. */
  @media (hover: hover) and (pointer: fine) {
    .home-hero__photo {
      cursor: none;
    }

    .home-hero__cursor {
      z-index: 4;
      /* Opacity only — explicitly NOT `transform` (that lives on the
         untransitioned outer element itself) and explicitly not the CSS
         default `all`, which would silently re-catch transform here. */
      transition: opacity 160ms ease;
    }

    .home-hero__cursor-ring {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 68px;
      height: 68px;
      margin: -34px 0 0 -34px;
      border: 1.5px solid rgba(255, 255, 255, 0.9);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.14);
      color: #FFFFFF;
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: var(--weight-semibold);
      letter-spacing: 0.04em;
      transform: scale(0.6);
      transition:
        transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1),
        width 200ms cubic-bezier(0.2, 0.8, 0.2, 1),
        height 200ms cubic-bezier(0.2, 0.8, 0.2, 1),
        margin 200ms cubic-bezier(0.2, 0.8, 0.2, 1),
        border-radius 200ms ease,
        background 200ms ease,
        border-color 200ms ease;
    }

    .home-hero__photo.is-cursor-active .home-hero__cursor {
      opacity: 1;
    }

    .home-hero__photo.is-cursor-active .home-hero__cursor-ring {
      transform: scale(1);
    }

    /* quick-260803-bvu (Item 2): the pause/play toggle and progress dashes
       live inside .home-hero__caption, which falls inside the left edge
       zone, so the accent-tinted directional pill was painting directly
       over them (confirmed live: cursor opacity 1, data-zone "left" while
       hovering the toggle). Declared AFTER is-cursor-active's own
       opacity: 1 rule above so this wins the tie (same 2-class
       specificity) whenever both classes are present at once — the
       common case, since the pointer is still over .home-hero__photo
       while it's over the caption nested inside it. */
    .home-hero__photo.is-over-controls .home-hero__cursor {
      opacity: 0;
    }

    /* Edge zones: the ring morphs into an accent-tinted directional pill —
       .home-hero__cursor's own `transform: translate(x, y)` (JS, tracking
       the pointer) is untouched by this; only the inner ring's
       geometry/color change. data-zone stays on the outer element, so
       these descendant selectors keep matching through the new ring
       wrapper unchanged. */
    .home-hero__cursor[data-zone='left'] .home-hero__cursor-ring,
    .home-hero__cursor[data-zone='right'] .home-hero__cursor-ring {
      width: 92px;
      height: 52px;
      margin: -26px 0 0 -46px;
      background: var(--current-accent, var(--color-accent));
      border-color: var(--current-accent, var(--color-accent));
      color: var(--current-accent-text, var(--color-on-accent));
    }

    /* Center label is permanent (no unlabeled ring state — confirmed
       feedback); hidden in the edge zones, where the arrow takes over. */
    .home-hero__cursor[data-zone='left'] .home-hero__cursor-label,
    .home-hero__cursor[data-zone='right'] .home-hero__cursor-label {
      display: none;
    }

    .home-hero__cursor-arrow {
      display: none;
      font-size: 18px;
      line-height: 1;
    }

    .home-hero__cursor[data-zone='left'] .home-hero__cursor-arrow,
    .home-hero__cursor[data-zone='right'] .home-hero__cursor-arrow {
      display: inline;
    }

    .home-hero__cursor[data-zone='left'] .home-hero__cursor-arrow {
      transform: scaleX(-1);
    }

    @media (prefers-reduced-motion: reduce) {
      .home-hero__cursor,
      .home-hero__cursor-ring {
        transition: none;
      }
    }
  }

  .home-hero__accent {
    position: absolute;
    right: var(--space-md);
    bottom: var(--space-md);
    /* Item 4 (direct request: give the photo more room): narrowed from
       min(800px, 60%) to min(700px, 52%). At the 700px cap this leaves
       636px of inner width (700px - 2 * var(--space-xl) 32px padding) —
       the wordmark clamp below is retuned to the SAME ratio this panel
       used at its old width, so the widest line ("JACQUELINE") still
       clears the panel with comfortable margin; re-verify live across
       768-1920px if the wordmark or panel geometry changes again. */
    width: min(700px, 52%);
    padding: var(--space-xl);
    z-index: 3;
    /* Direct follow-up (quick-260713-jfz) established WHY this element needs
       its own view-transition-name (without one, it was just part of the
       flat "everything else" root snapshot, painted BELOW the named
       ajs-hero-morph group in the view-transition overlay's default stacking
       order — the still-growing photo morph visually covered it for the
       whole transition, reading as a sudden pop instead of a fade-in once
       the overlay tore down and real DOM stacking took over). Naming it
       gives it its own group in the pseudo-element tree, stacked above
       ajs-hero-morph, so it can fade in independently and stay visible
       throughout (a pure enter/exit fade — no "old" counterpart on the grid
       side, since the whole .home-hero is hidden in grid mode).

       HOME-06 (D-10/D-12) fix: the name itself is NO LONGER set here as a
       permanent, unconditional value. It was one of the two elements flagged
       as the leading hypothesis for the reported mobile full-bleed
       regression (always-on naming, even at first paint, unlike the
       matching grid tile which is only named during an active transition —
       see .home-hero__photo's comment above for the full reasoning and the
       disable/re-enable experiment recorded in 07-02-SUMMARY.md). The name
       is now set dynamically via `accentPanel.style.viewTransitionName` in
       the <script> below, only for the duration of an actual transition. */
    /* Solid "paper" backing for the whole panel (wordmark + intro together),
       cycling per-gallery via --current-accent (set by render()). This is
       what makes the wordmark below read as letters CUT OUT of a solid
       sheet, revealing the photo behind through the cutout shapes, rather
       than ghostly text floating directly on the photo with no panel at
       all — corrected per direct user feedback (the panel background was
       removed entirely in an earlier pass; that was the wrong reading of
       D-08, which only meant the WORDMARK's own fill should reveal the
       photo, not that the surrounding panel should have no backing). */
    background-color: var(--current-accent, var(--color-accent));
    /* quick-260727-drq (Bug 3): render() sets --current-accent on every
       navigation (auto-advance/dash/keyboard/swipe/edge-click commit) with
       a plain custom-property write, which without a transition applied as
       a hard instant color cut. This crossfades consecutive navigations
       instead — a duration in the same ~250-350ms band as the sharp-photo
       opacity crossfade above so both read as part of the same swap. Safe
       unconditionally: .is-opening only disables the .home-hero__img/
       .home-hero__peek transform transitions, never this one.

       HOME-16/D-05: the section's inline style + render()'s own initial call
       pre-set --current-accent to gallery 0's real value, but the <script>
       below deliberately re-writes it again immediately afterward to a
       randomly-picked gallery's colour (the random STARTING accent) — this
       rule WOULD therefore fire a visible fade on every single page load if
       left unguarded. .is-accent-init (added/removed by that same script,
       right below) suppresses this transition for exactly that one
       synchronous override, so the random colour appears already-in-place
       at first paint instead of visibly sweeping in. */
    transition: background-color 300ms ease;
  }

  /* HOME-16/D-05: suppresses the transition above for the one-time initial
     random-accent override only — removed (via a double
     requestAnimationFrame in the <script> below) once that colour has
     painted, so every subsequent real navigation still crossfades normally. */
  .home.is-accent-init .home-hero__accent {
    transition: none;
  }

  /* D-07/D-08/D-09: carousel-mode wordmark cutout — the letters themselves
     have no solid fill (see @supports block below), so wherever a glyph
     shape sits, .home-hero__accent's own solid background (above) is
     overpainted by --wordmark-photo instead — a true papercut effect: solid
     panel everywhere except the exact letter shapes, which show the photo
     behind. Outside the glyphs, the panel's plain solid color shows through
     normally, since the wordmark element itself has no background of its
     own beyond the text fill. */
  /* quick-260727-iao: the wrapper owns the spacing to .home-hero__intro
     below — the in-flow h1 still sizes the box (the two peek copies are
     inset:0 overlays on that same box), but margin now lives here so all
     three layers can share identical margin: 0. */
  .home-hero__wordmark-stack {
    position: relative;
    margin: 0 0 var(--space-md);
  }

  .home-hero__wordmark,
  .home-hero__wordmark-peek {
    font-family: var(--font-display);
    /* Matches the gallery caption title convention elsewhere in this same
       component (.home-hero__title / grid tile titles both render via
       .toUpperCase() — see "SILOS" in the caption), and the AJS logo mark
       itself, which is all-caps. Direct user feedback — the wordmark should
       read consistently with those, not mixed-case. */
    text-transform: uppercase;
    /* Fluid, not a flat cap: a fixed font-size paired with the panel's
       percentage-driven width (min(700px, 52%), above) only matches at the
       exact viewport widths it was spot-checked at. clamp(38px, 5.2vw, 70px)
       tracks the SAME 52vw rate the panel width uses below the ~1346px
       breakpoint where the panel's own min(700px, 52%) switches from
       percentage to its flat cap — so the font-to-panel-width ratio stays
       constant across the entire desktop range. Item 4 (retuned from the
       previous clamp(44px, 6vw, 80px)/min(800px, 60%) panel): preserves the
       SAME font-to-panel ratio the previous panel used (70/700 = 10%, same
       as 80/800; 5.2vw = 6vw * 52/60; 38px = 44px * 52/60) against the new,
       narrower 700px/52% panel. Re-verified live across 768-1920px that
       "JACQUELINE"/"SUZANNE" (the widest lines) do not clip past the
       narrower panel edge. */
    font-size: clamp(38px, 5.2vw, 70px);
    font-weight: var(--weight-semibold);
    /* 0.9 — deliberately tight, not the previous 1.6: direct user request
       to "strongly reduce the gap between the lines." Verify live that
       Unbounded's glyphs (different metrics than Anton, which needed 1.6 to
       avoid real box overlap) don't visually collide/become illegible at
       this tightness — tight-but-legible is the goal, not overlapping. */
    line-height: 0.9;
    letter-spacing: 0.02em;
    margin: 0;
    /* Solid inherited accent-text color is both the unsupported-engine
       fallback and the loading/error state. The photo cutout below becomes
       transparent only after render() confirms the sharp hero succeeded. */
    color: inherit;
  }

  /* The two peek copies overlay the h1 exactly — the h1 stays in normal
     flow and sizes the stack, the peeks are inset:0 overlays on the same
     box. All three MUST render byte-identical glyphs at identical positions
     (same text, same <br> breaks, same metrics — enforced by the grouped
     typographic rule above) or the cutout seam will not line up. */
  .home-hero__wordmark-peek {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
    /* Hidden by default; the zone-scoped rules below reveal exactly one
       peek layer's share once the stack's data-peek-zone matches. */
    clip-path: inset(0 0 0 100%);
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .home-hero__wordmark,
    .home-hero__wordmark-peek {
      /* --wordmark-bg-size/-position are computed live by
         syncWordmarkAlignment()/syncWordmarkLayers() in the <script> below,
         so the visible slice lines up with the exact same crop of the
         photo that's actually behind the panel (a true cutout), not an
         independently re-cropped/zoomed copy. cover/center are fallbacks
         only — for the brief window before JS first runs, or if it never
         runs at all. */
      background-size: var(--wordmark-bg-size, cover);
      background-position: var(--wordmark-bg-position, center);
      /* Without this, a stale/out-of-range --wordmark-bg-position (e.g. the
         mobile fallback path, which never sets it, or any future edge
         case where the computed offset exceeds the background image's own
         size) tiles into a repeated, garbled texture instead of just
         clipping — confirmed as the cause of a reported "transparency
         effect doesn't work" regression. */
      background-repeat: no-repeat;
      -webkit-background-clip: text;
      background-clip: text;
    }

    .home-hero__wordmark {
      /* Keep exactly one photographic background and no blended color layer.
         Safari can produce raster seams when background-clip:text is combined
         with extra paint layers on multiline text. Contrast is handled later
         with a filter on the finished glyph pixels instead. The peek copies
         get their own background-image set inline by syncWordmarkLayers() in
         the <script> below — they do not read --wordmark-photo. */
      background-image: var(--wordmark-photo);
    }

    .home.has-wordmark-photo .home-hero__wordmark,
    .home.has-wordmark-photo .home-hero__wordmark-peek {
      color: transparent;
      -webkit-text-fill-color: transparent;
      /* Adjust the already-rasterized photo in the direction that contrasts
         with the panel: darker on light panels, lighter on dark panels. Keep
         this as a single filter (no text-stroke/paint-order or extra paint
         layer), since those produced geometric artifacts in Safari. */
      filter: var(--wordmark-photo-filter, brightness(0.65) contrast(1.12));
    }
  }

  /* quick-260727-iao: the seam-driven clip-path split. JS sets ONLY
     --wm-seam (0..1) and data-peek-zone on the stack; CSS does all the
     clipping — no clip-path strings are built in JS. Deliberately no
     `transition` here: the seam must track the photo per-frame (driven by
     the rAF loop in the <script> below), not run its own easing. */
  .home-hero__wordmark-stack[data-peek-zone='right'] .home-hero__wordmark {
    clip-path: inset(0 calc((1 - var(--wm-seam, 1)) * 100%) 0 0);
  }

  .home-hero__wordmark-stack[data-peek-zone='right'] .home-hero__wordmark-peek--next {
    clip-path: inset(0 0 0 calc(var(--wm-seam, 1) * 100%));
  }

  .home-hero__wordmark-stack[data-peek-zone='left'] .home-hero__wordmark {
    clip-path: inset(0 0 0 calc(var(--wm-seam, 0) * 100%));
  }

  .home-hero__wordmark-stack[data-peek-zone='left'] .home-hero__wordmark-peek--prev {
    clip-path: inset(0 calc((1 - var(--wm-seam, 0)) * 100%) 0 0);
  }

  .home-hero__intro {
    /* Item 5 (modest reduction, direct request): was 16px (Body role). */
    font-size: 15px;
    font-weight: var(--weight-regular);
    line-height: 1.5;
    margin: 0;
    /* No background of its own — .home-hero__accent's solid panel background
       (above) now covers the whole panel, wordmark included, so a separate
       backing here would just repaint the same color redundantly. */
    padding: var(--space-sm) var(--space-md);
    /* quick-260726-ltr (Item 2): confine the intro to roughly two-thirds of
       the panel — the panel (.home-hero__accent) is this element's
       containing block, so 66.67% is ~two-thirds of the panel's own width.
       (Widened from the previous 50%.) */
    max-width: 66.67%;
  }

  /* D-04/D-05/D-06: grid-mode hero is now the first *tile* of the grid
     itself (not a full-width band) — a non-link <div>, same square sizing
     as every gallery tile, solid accent background (no photo/cutout).
     Compound selector (.home-grid__tile.home-grid__tile--hero), not a bare
     .home-grid__tile--hero: the generic .home-grid__tile rule below shares
     this element (both classes are on the same <div>) and also sets
     `display`, at equal single-class specificity — since it appears later
     in source order it was silently winning and collapsing this rule's
     `display: flex` back to `display: block`, losing the vertical-centering
     layout (confirmed via getComputedStyle: display read "block" here
     despite this rule; aspect-ratio/position/overflow were unaffected since
     only .home-grid__tile itself declares those). The two-class selector
     raises specificity so this rule's `display` always wins regardless of
     source order. */
  .home-grid__tile.home-grid__tile--hero {
    background-color: var(--current-accent, var(--color-accent));
    color: var(--current-accent-text, var(--color-on-accent));
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .home-grid__wordmark {
    font-family: var(--font-display);
    text-transform: uppercase;
    /* 40px desktop — bumped from 24px (direct user feedback: too small,
       inconsistent visual weight next to the carousel version). Live-
       measured against the hero-tile's actual inner width (395px at a
       1280px viewport, 3-column grid): "JACQUELINE" (the widest line) is
       only 341px at 40px, comfortable margin, well short of the earlier
       overflow problems the carousel version hit at its much larger sizes.
       No cutout here (D-05) — stays solid --font-display text in
       --color-on-accent. */
    font-size: 40px;
    font-weight: var(--weight-semibold);
    line-height: 1.15;
    letter-spacing: 0.02em;
    margin: 0 0 var(--space-sm);
  }

  .home-grid__intro-body {
    font-size: 14px; /* Label role — down from 16px Body, same fit constraint */
    font-weight: var(--weight-regular);
    line-height: 1.5;
    margin: 0;
  }

  .home-grid__tiles {
    display: grid;
    /* 3, not 2 — direct user feedback that tiles were too big at 2 columns
       (each roughly half the viewport width). */
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .home-grid__tile {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    text-decoration: none;
  }

  .home-grid__tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* HOME-09 (D-01/D-03/D-06): blur-up crossfade — same two-layer opacity
     mechanism as the hero (see .home-hero__img--sharp above). Additive to
     `.home-grid__tile`'s existing position: relative — stacks the
     placeholder/sharp variants the same way `.home-grid__tile-scrim`
     already stacks against it. The sharp image keeps loading="lazy"
     decoding="async" unchanged (D-03) — this is purely additive on top of
     lazy-loading, not a replacement for it. */
  .home-grid__tile-img,
  .home-grid__tile-img-placeholder,
  .home-grid__tile-img--sharp {
    position: absolute;
    inset: 0;
  }

  .home-grid__tile-img--sharp {
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .home-grid__tile-img--sharp.is-loaded {
    opacity: 1;
  }

  .home-grid__tile-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0.15) 45%, rgba(0, 0, 0, 0) 70%);
  }

  /* 260718-rhv: per-gallery hover tint — a separate layer over the dark
     scrim above (not a replacement), so the dark gradient keeps doing its
     job as the white caption text's legibility floor. --tile-accent is set
     per-tile on the .home-grid__tile <a> (inline style) and inherits down
     to this pseudo-element; it is deliberately its own custom property
     (not --current-accent, the shared value the hero tile/carousel cycle
     through) so each tile always tints toward its OWN gallery's color,
     never whichever gallery the carousel currently happens to show. */
  .home-grid__tile-scrim::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--tile-accent, var(--color-accent));
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .home-grid__tile:hover .home-grid__tile-scrim::after,
  .home-grid__tile:focus-visible .home-grid__tile-scrim::after {
    opacity: 0.35;
  }

  .home-grid__tile-copy {
    position: absolute;
    left: var(--space-md);
    bottom: var(--space-md);
    right: var(--space-md);
    z-index: 2;
    color: #FFFFFF;
  }

  .home-grid__tile-title {
    display: -webkit-box;
    font-family: var(--font-display);
    font-size: 32px; /* Display role, fixed */
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    /* 260718-rhv (Rule 1 - bug, discovered live testing this task): longer
       gallery titles (e.g. "The Victorian Tea room") wrap to 2 lines at this
       font-size while short titles ("Silos", "Brume") stay on 1 — that
       height difference shifts the title's own top position exactly like
       the description-height bug this task fixes, since both sit inside
       the same bottom-anchored .home-grid__tile-copy block.
       quick-260803-bvu (Item 3): the original fix clamped to a SINGLE line
       with ellipsis truncation, which reserved a constant height but cut
       long titles mid-word (confirmed live: "The Victorian Tea room"
       reported scrollWidth 478 vs clientWidth 395 with white-space:
       nowrap). Now clamped to TWO lines instead, following the exact
       min-height-reservation pattern .home-grid__tile-description already
       uses one rule below — min-height reserves 2 full line-boxes
       regardless of whether a given title actually wraps, so the
       alignment invariant this comment describes still holds (every
       tile's title starts at the same offset from its own tile's bottom
       edge), just measured against a taller reserved box than before. */
    min-height: calc(1.2em * 2);
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    /* 260718-rhv: title lifts a few px on hover/focus, in sync with the
       description's existing 180ms translateY reveal below. */
    transition: transform 180ms ease;
  }

  .home-grid__tile:hover .home-grid__tile-title,
  .home-grid__tile:focus-visible .home-grid__tile-title {
    transform: translateY(-4px);
  }

  .home-grid__tile-description {
    display: -webkit-box;
    /* 260718-rhv: fixed 3-line reservation (1.4 line-height * 3 = 3 line-
       boxes at the 14px font-size below) so every tile's copy block is the
       same height whether the statement is absent, short, or clamped at
       three lines — opacity: 0 never collapsed layout, so an unreserved
       block let statement-having tiles push their titles higher than
       statement-less ones (the root-cause bug). Additive to the existing
       reveal mechanics below; nothing else here changes. */
    min-height: calc(1.4em * 3);
    margin-top: var(--space-sm);
    max-width: 52ch;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.4;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 180ms ease, transform 180ms ease;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .home-grid__tile:hover .home-grid__tile-description,
  .home-grid__tile:focus-visible .home-grid__tile-description {
    opacity: 1;
    transform: translateY(0);
  }

  /* Mobile responsive (D-10, UI-SPEC Layout Notes — Homepage Mobile). */
  @media (max-width: 767px) {
    /* HOME-10 (Phase 10 Plan 02): the header/nav/nav-link mobile trims that
       used to live here (flex-wrap + var(--space-xs) header gap, zeroed nav
       margin + var(--space-xs) nav gap, var(--space-xs) nav-link padding)
       are gone — not lost, PORTED FORWARD as SiteHeader.astro's own
       is:global baseline mobile CSS in Plan 01 (10-01-SUMMARY.md), using
       these exact live-tested values (they were copied from this file's own
       prior tuning). Since SiteHeader's stylesheet applies site-wide, the
       homepage inherits the identical trims automatically — duplicating
       them here would just re-declare the same rule twice for no effect.
       Re-verified live at 393px with the toggle now present via the extra
       slot (a 5th flex item About/Contact never has): homepage.spec.ts's
       393px no-overflow assertions (Instagram link, mode-toggle box) stay
       GREEN with zero homepage-only additions needed. */

    /* Direct request: the photo should cover the full phone screen on
       arrival, like a true full-bleed mobile hero. The base photo rule pairs
       max-height:100vh with min-height:100svh regardless of the 16:9
       aspect-ratio, and object-fit:cover on .home-hero__img (unchanged)
       naturally crops/zooms the photo to fill that box — a portrait phone
       screen against a landscape photo crops in hard on its own, no extra
       transform needed. The base rule's top:50% arrow centering and
       bottom-anchored caption both now measure against this same
       full-viewport box, so nothing needs a mobile-specific override —
       centering in "the whole screen" is exactly right for a full-bleed
       hero.

       100svh, not 100vh: confirmed via a real-device screenshot that plain
       vh (which resolves to the LARGE viewport, i.e. the size once
       Safari's address bar auto-hides) made the hero taller than what's
       actually visible on first load, while the browser chrome is still
       showing — the site's own footer text peeked in underneath the
       caption on arrival. svh always resolves to the SMALL viewport (chrome
       visible, the worst case), so the hero is guaranteed to fit within
       whatever is actually on screen before any scrolling happens. */
    .home-hero__caption {
      right: var(--space-md);
      max-width: none;
      /* Item 2: byline row removed — 3 tracks, height recomputed (was
         108px with the byline's 42px track + one row-gap). */
      grid-template-rows: 3px 21px 30px;
      height: 62px;
    }

    /* Direct follow-up: an in-flow panel below the photo (previous pass)
       required scrolling to see it, but "on the picture" was the whole
       point — the panel needs to overlay the full-bleed photo, not follow
       it. Back to position:absolute (like the desktop corner card), just
       anchored full-width along the bottom instead of a bottom-right
       corner. bottom offset reserves room for the fixed-height caption
       below the panel plus its own --space-xl gap to the screen edge, so
       the two overlaid layers stack without covering each other. Item 2:
       108px -> 62px, coupled to the caption's own recomputed mobile
       height above (the byline row removal shortened the caption, so the
       panel can sit closer to the caption's new, shorter height). */
    .home-hero__accent {
      position: absolute;
      left: 0;
      right: 0;
      bottom: calc(62px + var(--space-xl) + var(--space-md));
      width: 100%;
      margin-top: 0;
      /* Direct request: shrink the panel itself so less of the screen is
         solid color and more of the photo shows above it. Tighter padding
         than the desktop var(--space-xl) (32px) reduces the panel's
         footprint on all four sides and, as a side effect, widens the
         wordmark's own inner width — more room to grow it further below. */
      padding: var(--space-lg);
    }

    /* D-09/direct follow-up ("more bigger!"): pushed further than the
       first pass, using the room freed up by .home-hero__accent's tighter
       mobile padding above (var(--space-lg), not the desktop var(--space-xl))
       — a wider inner width for the same viewport. Re-measured the same
       way (actual rendered line width via Range.getBoundingClientRect()
       across 360-767px): clamp(36px, 9.8vw, 50px) keeps at least a 5px
       margin everywhere, with most of the common phone range (390-428px)
       sitting at 16-23px of margin. 360px now floors at 36px (up from the
       previous pass's 34px); ~390-428px renders 38-42px (up from 36-39px);
       cap raised from 46px to 50px for wider viewports.

       quick-260727-iao: the aria-hidden .home-hero__wordmark-peek layers
       must get this SAME mobile override — without it they keep the
       desktop clamp(38px, 5.2vw, 70px), and their unbroken words (e.g.
       "JACQUELINE") render wider than the mobile panel, overflowing the
       page even though the layer is invisible (fully clipped by default;
       the mirrored-peek mechanism is desktop-only/hoverCapable-gated, so
       these layers are always at their default clip on mobile, but a
       clipped element's own layout box still counts toward document
       scrollWidth). Confirmed via a real 320px-viewport overflow scan that
       this is the actual regression source, not the pre-existing peek-
       image/cursor transform overflow contributors (both present before
       and after this task). */
    .home-hero__wordmark,
    .home-hero__wordmark-peek {
      font-size: clamp(36px, 9.8vw, 50px);
    }

    /* Direct request: shrink the intro paragraph to make room for a bigger
       wordmark and a shorter overall panel — 14px (Label role, matching
       .home-hero__index/__byline elsewhere in this component) instead of
       the desktop 16px (Body role). */
    .home-hero__intro {
      font-size: 14px;
      line-height: 1.4;
      /* Item 5: the desktop 50% confinement doesn't apply here — mobile's
         panel is full-width and there's no "left half" to preserve; without
         this override the desktop max-width: 50% rule would squeeze the
         intro to half the (already narrower) mobile panel. */
      max-width: none;
    }

    /* Grid hero-tile wordmark — mobile-width override (Typography table).
       Deliberate mobile-only reversal of D-05 (see 06-DISCUSSION-LOG.md):
       (a) the grid hero tile was flat 16px solid text on mobile, too small
       and visually inconsistent with the carousel's photo-cutout wordmark —
       direct live-device feedback asked for the same effect here; (b) sized
       with the carousel's proven starting clamp (see Task 2 for the final
       live-measured bounds); (c) desktop (`.home-grid__wordmark` above,
       outside this media query) is untouched — still solid --color-on-accent
       text, no cutout. */
    .home-grid__wordmark {
      font-size: clamp(36px, 9.8vw, 50px);
    }

    /* --wordmark-photo is inherited from the .home root (server-rendered,
       re-set on every carousel tick) — no JS change needed here, it's
       already the "photo displayed on the carousel behind" for whichever
       gallery the carousel last showed. Unlike the carousel wordmark, the
       grid hero tile has no photo physically behind it to pixel-align to
       (it's a solid-accent square), so this uses the same cover/center
       fallback values the carousel's own @supports block falls back to
       before JS runs — not syncWordmarkAlignment()'s live-computed
       --wordmark-bg-size/--wordmark-bg-position, which would be meaningless
       here. Fallback (unsupported engines): the base rule's solid
       --color-on-accent color above still applies since it's outside this
       @supports block. */
    @supports (background-clip: text) or (-webkit-background-clip: text) {
      .home-grid__wordmark {
        background-image: var(--wordmark-photo);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        -webkit-background-clip: text;
        background-clip: text;
      }

      .home.has-wordmark-photo .home-grid__wordmark {
        color: transparent;
        -webkit-text-fill-color: transparent;
      }
    }

    .home-grid__tiles {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 359px) {
    .home-hero__wordmark,
    .home-hero__wordmark-peek,
    .home-grid__wordmark {
      font-size: 9.8vw;
    }
  }

  /* Phase 21 (HOME-14/HOME-15): the phone-width scroll deck's own CSS.
     Deliberately placed last, after the 359px block above, so source order
     alone gates every override below at phone width — no extra
     specificity tricks are needed beyond the media query itself. Task 2
     already built the markup (unstyled, visible at every width); this
     section is what actually retires the carousel/grid/toggle below 767px
     and styles the deck. See
     .claude/skills/sketch-findings-ajs-website/references/homepage-motion.md
     and 21-UI-SPEC.md "Layout & Structure Contract"/"Motion & Interaction
     Contract" for the full design rationale — this comment only records
     the CSS-specific decisions. No motion is wired here: plans 21-05/21-06
     layer the scroll driver and arrival observer on top of this static
     end-state. */
  .home-scroll-deck {
    display: none;
  }

  @media (max-width: 767px) {
    /* D-01/D-16/success criterion 1: the deck fully replaces the carousel/
       grid/toggle below 767px — a pure CSS gate, never a JS markup swap
       (21-RESEARCH.md Anti-Patterns). `.home-toggle` is this file's own
       scoped class (the button is slotted into <SiteHeader> via its
       `extra` slot but authored here), so this file's scoped selector
       reaches it without a :global() wrapper. */
    .home-hero,
    .home-grid,
    .home-toggle {
      display: none;
    }

    .home-scroll-deck {
      display: block;
    }

    /* Track: tall enough to host the full zoom scrub before the first real
       slide arrives. WR-01 fix: CSS cannot import the TS
       ZOOM_REVEAL_DISTANCE constant (src/lib/home-carousel.ts, 21-01)
       directly, so the frontmatter above writes it into the
       `--zoom-reveal-distance` custom property (and the
       `data-reveal-distance` attribute, for tests/debugging) on the track
       element itself — this is the single source of truth the constant
       now drives, rather than a second, independently-hand-maintained
       900px literal. The `900px` fallback below only matters if the
       inline custom property is ever absent (e.g. a future markup
       refactor drops it); it is not meant to require independent upkeep
       any more. */
    .home-scroll-deck__track {
      height: calc(100dvh + var(--zoom-reveal-distance, 900px));
    }

    .home-scroll-deck__stage {
      position: sticky;
      top: 0;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* End-state crossfade target (t=0.85->1.0, driven by plan 21-05's
       zoom driver) — a plain, uncut photo, so the extreme ~8.5x scale
       never has to render a flawless text-clip cutout entirely on its
       own. Rest state is fully transparent. */
    .home-scroll-deck__photo {
      position: absolute;
      inset: 0;
      background-image: var(--zoom-photo);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: 0;
    }

    .home-scroll-deck__wordmark {
      font-family: var(--font-display);
      text-transform: uppercase;
      line-height: 0.92;
      font-weight: 900;
      text-align: center;
      margin: 0;
      /* Same per-line clamp the existing mobile hero wordmark uses
         (verbatim, not retuned — see .home-hero__wordmark's own 767px
         override above). */
      font-size: clamp(36px, 9.8vw, 50px);
      /* HOME-15/success criterion 4: "full-screen" describes the wordmark's
         own BOX, not its glyph ink — reusing the hero wordmark's compact
         clamp (above) for legible letterforms would size the h1 to only
         ~106px tall at a 393px viewport, well short of the 40%-of-viewport
         floor 21-04-PLAN.md's own Task 1 spec locks in. Generous
         viewport-relative block padding (not a bigger font-size, and not
         flex/grid on the h1 itself, which would break the plain <br>-based
         "Atelier/Jacqueline/Suzanne" line breaks the span+text-node markup
         above depends on) grows the box to comfortably clear that floor
         while keeping the actual letterforms at the same reused clamp size,
         symmetric top/bottom padding keeps them centered inside the taller
         box. [Rule 1 auto-fix — see 21-04-SUMMARY.md Deviations.] */
      padding-block: 20dvh;
      padding-inline: 5vw;
      position: relative;
      will-change: transform, opacity;
      /* The full-screen wordmark's own box IS the photo's box here (unlike
         the carousel wordmark) — no computeWordmarkBackgroundPosition-style
         alignment math is needed (21-RESEARCH.md Pitfall 5). Unsupported-
         engine fallback: a solid, readable color outside the @supports
         block below. */
      background-image: var(--zoom-photo);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      color: var(--current-accent-text, var(--color-on-accent));
    }

    @supports (background-clip: text) or (-webkit-background-clip: text) {
      /* Safari warning (21-RESEARCH.md Pitfall 3, mirrors the existing
         carousel wordmark's own comment above verbatim): extra paint
         layers (a second background, a box-shadow, a text stroke)
         combined with a text-clipped background produce raster seams on
         Safari, especially at this scroll-driven scale's extreme end.
         Exactly ONE filter declaration, no other paint layer — the
         t=0.85->1.0 crossfade to the plain photo layer above is the
         safety net for a less-than-flawless cutout at ~8.5x, not this
         rule. */
      .home-scroll-deck__wordmark {
        -webkit-background-clip: text;
        background-clip: text;
      }

      /* Mirrors .home-grid__wordmark's own @supports block above verbatim
         (as instructed) — gated behind the SAME .home.has-wordmark-photo
         class the carousel's <script> already toggles once the first
         gallery's hero <img> confirms a successful load, not applied
         unconditionally. [Rule 1 auto-fix — see 21-04-SUMMARY.md
         Deviations: an unconditional transparent color/fill here would
         leave the wordmark permanently invisible if the underlying photo
         request ever fails, since --zoom-photo has no other load-success
         signal of its own; --zoom-photo/--zoom-photo-filter are sourced
         from this SAME first gallery (Task 2), so has-wordmark-photo's
         existing load-success state is exactly the right gate to reuse.] */
      .home.has-wordmark-photo .home-scroll-deck__wordmark {
        color: transparent;
        -webkit-text-fill-color: transparent;
        filter: var(--zoom-photo-filter);
      }
    }

    .home-scroll-deck__focus-letter {
      /* Measurable box for plan 21-05's live transform-origin math only —
         must not change the rendered wordmark's appearance in any way. */
      display: inline-block;
    }

    /* .home-scroll-deck__slides (the wrapper) deliberately carries no
       scroll-snap-type of its own — the html:has() rule in the is:global
       block below owns it, scoped so the zoom track above stays entirely
       outside the snap container (21-RESEARCH.md Pitfall 6). */
    .home-slide {
      display: block;
      position: relative;
      height: 100dvh;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      color: var(--slide-accent-text, var(--color-on-accent));
      text-decoration: none;
    }

    .home-slide:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: var(--focus-ring-offset);
    }

    .home-slide__img {
      position: absolute;
      inset: 0;
      object-fit: cover;
      width: 100%;
      height: 100%;
    }

    /* Mobile variant of the accent panel (D-06) — a full-width, bottom-
       anchored band, not the desktop corner-card geometry
       .home-hero__accent/.home-grid__tile-copy use. */
    .home-slide__accent {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      padding: var(--space-lg);
      background-color: var(--slide-accent, var(--color-accent));
      color: var(--slide-accent-text, var(--color-on-accent));
    }

    /* Reused verbatim from .home-grid__tile-title above (D-13) — always
       visible; the title itself is never part of the reveal. */
    .home-slide__title {
      display: -webkit-box;
      font-family: var(--font-display);
      font-size: 32px;
      font-weight: var(--weight-semibold);
      line-height: 1.2;
      min-height: calc(1.2em * 2);
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    /* Reused verbatim from .home-grid__tile-description above (D-13) — the
       reveal values themselves (opacity/translateY/180ms ease) are locked;
       do not retune. `is-revealed` is declared here and toggled by plan
       21-06's arrival observer. */
    .home-slide__description {
      display: -webkit-box;
      min-height: calc(1.4em * 3);
      margin-top: var(--space-sm);
      max-width: 52ch;
      overflow: hidden;
      font-size: 14px;
      line-height: 1.4;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 180ms ease, transform 180ms ease;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }

    .home-slide.is-revealed .home-slide__description {
      opacity: 1;
      transform: translateY(0);
    }

    /* D-12: qualified with both the .home ancestor and both header variant
       classes inside :global() so this beats .site-header--transparent's
       own position: absolute (SiteHeader.astro's transparent-variant
       rule) regardless of which variant a future change might render here.
       Stacking above the deck is already guaranteed by the header's own
       z-index: 5 (the .home :global(.site-header) rule above, near the top
       of this style block), which nothing in the deck sets or contests. */
    .home :global(.site-header--solid),
    .home :global(.site-header--transparent) {
      position: fixed;
      transition: opacity 300ms ease, visibility 0s linear 300ms;
    }

    /* data-zoom-active is absent by default — only plan 21-05's zoom
       driver ever writes it — so the header stays visible pre-JS, with JS
       disabled, and under reduced motion. That default is load-bearing for
       the reduced-motion route plan 21-03's tests rely on. Visibility only
       flips to hidden once the opacity transition above finishes, so the
       header reads as fading out rather than vanishing abruptly. */
    .home[data-zoom-active='true'] :global(.site-header--solid),
    .home[data-zoom-active='true'] :global(.site-header--transparent) {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* Phase 21 (D-15): the reduced-motion end state. Every description is
     permanently visible with no observer running (plan 21-06 gates its
     own attachment behind this identical matchMedia check, so there is
     nothing left to reveal on scroll). The is:global block above disables
     scroll-snap-type under this same query. The zoom wordmark and photo
     layer need NO rule here at all — their unconditional rest state
     (wordmark visible at scale 1, photo layer at opacity 0) IS the static
     full-screen wordmark this reduced-motion end state requires, since
     plan 21-05's driver never attaches under this query either. */
  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    .home-slide__description {
      opacity: 1;
      transform: none;
    }
  }

</style>

<style is:global>
  /* quick-260726-obg (Task 2): reintroduces quick-260725-dcg's carousel-mode
     footer-hide, now made safe by Task 1's early/visible pull feedback
     (safety_investigation item 1 — the vacuous-atBottom() tradeoff on
     desktop is an accepted, documented tradeoff, mitigated by the 150px
     threshold + the visible warning + the proactive decay together, not by
     restoring real scroll distance). `body:has()` (not a plain sibling
     combinator) is required because a <main> wrapper sits between `.home`
     and `footer.chrome-band` in BaseLayout.astro's markup — a component-
     scope boundary a `~`/`+` selector cannot cross. Kept here (not in
     BaseLayout.astro) so it only ever ships on the homepage and never
     affects gallery/édition/about/contact/legal pages; BaseLayout's own
     `hideFooter` prop is untouched (it's a build-time prop and cannot react
     to this client-side carousel/grid toggle). Grid mode leaves the footer
     visible, and the rule reverts cleanly on toggle either direction.

     Phase 21 (D-08/HOME-14): wrapped in `min-width: 768px` — below 767px
     the carousel/grid subtree is hidden entirely (see the phone-width
     scoped <style> block above) and the phone-width deck instead relies on
     the visitor scrolling straight past the last slide into the real
     footer, so this hide rule must not reach phone width at all. No other
     part of the rule changes. */
  @media (min-width: 768px) {
    body:has(.home[data-display-mode='carousel']) footer.chrome-band {
      display: none;
    }
  }

  /* Phase 21 (HOME-14/HOME-15): phone-width scroll snap for pages that
     actually render the deck. `html:has(.home-scroll-deck)` — not a bare
     `html` rule — so this snap type never leaks onto About/Contact/
     gallery/édition pages, which don't render this markup. The page
     itself is the scroll container (D-08 requires scrolling past the last
     slide into the footer, so a nested scroller is out of the question),
     and the zoom track above is a deliberately non-snapping 900px scrub
     region that a strict snap mode would fight (21-RESEARCH.md Pitfall 6)
     — `proximity` (not `mandatory`) keeps D-04's free scrub intact while
     each slide's own `scroll-snap-stop: always` still prevents a fling
     from skipping a gallery. This is the "exact snap-scroll CSS technique"
     21-CONTEXT.md left open for planning to decide, not a change to any
     locked decision. */
  @media (max-width: 767px) {
    html:has(.home-scroll-deck) {
      scroll-snap-type: y proximity;
    }
  }

  /* Phase 21 (D-15): the reduced-motion end state. No JS observer runs
     under this query (plan 21-06 gates its own attachment behind the
     identical matchMedia check), so every description must already be in
     its final revealed state and the free-scrub snap must be fully off. */
  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    html:has(.home-scroll-deck) {
      scroll-snap-type: none;
    }
  }

  /* View Transitions pseudo-elements (quick-260713-jfz) live on the document
     root, outside this component's subtree — Astro's scoped <style> above
     cannot target ::view-transition-*, so this must be a global block.
     Customizes the swap's timing beyond the browser's flat ~250ms default
     cross-fade: a deliberate ~420ms root cross-fade plus the shared-element
     ajs-hero-morph group (named on .home-hero__photo above and on the
     matching grid tile by the <script> block), so the hero photo visibly
     grows/shrinks/repositions toward its grid tile instead of just fading. */
  /* Explicit stacking, unconditional (not just under no-preference — wrong
     stacking would be just as visible, if briefly, even at reduced-motion
     durations). Default view-transition-group stacking follows DOM/paint
     order, which put ajs-header (comes BEFORE .home-hero__photo in the
     markup) and, less obviously, ajs-accent-panel too, at the mercy of
     that ordering rather than a guarantee. Named groups default to normal
     stacking (root at the back); giving ajs-hero-morph the lowest explicit
     z-index and the header/panel higher ones guarantees both always paint
     above the morphing photo regardless of markup order, instead of
     relying on "it happens to come after in the DOM." */
  ::view-transition-group(ajs-hero-morph) {
    z-index: 1;
  }

  ::view-transition-group(ajs-header),
  ::view-transition-group(ajs-accent-panel) {
    z-index: 2;
  }

  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-old(root),
    ::view-transition-new(root),
    ::view-transition-group(ajs-hero-morph) {
      animation-duration: 420ms;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* The panel's exit remains a pseudo-element fade. Its entrance is
       deliberately absent here: WebKit can start that pseudo-animation at
       its final time. The click handler instead captures the entering panel
       transparent, waits for the photo View Transition to finish, and then
       fades the real DOM panel in with the Web Animations API. */
    @keyframes ajs-panel-fade-out {
      from {
        opacity: 1;
      }
      to {
        opacity: 0;
      }
    }

    /* Exit fade (carousel->grid direction) — no entrance delay needed
       here, live measurement showed the exit already reads smoothly with
       an immediate fade-out. */
    ::view-transition-old(ajs-accent-panel) {
      animation: ajs-panel-fade-out 380ms cubic-bezier(0.4, 0, 0.2, 1) both;
    }

    /* Direct follow-up: the header (ajs-header, named above) was fully
       blanked out for a visible chunk of the transition — the morphing
       photo's box overlapped its screen area while the header was still
       painted in the (wrongly-stacked) root layer beneath it. Unlike the
       accent panel, the header is present in BOTH the carousel and grid
       states (just restyled — gradient-over-photo vs solid background), so
       this is a genuine cross-fade of its two appearances, not an
       enter/exit — no entrance delay needed, just the same duration as
       everything else for a consistent feel. */
    ::view-transition-old(ajs-header),
    ::view-transition-new(ajs-header) {
      animation-duration: 420ms;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
  }

  /* The View Transitions API does not honor prefers-reduced-motion on its
     own — this explicit override is required to keep the swap effectively
     instant for reduced-motion users, mirroring how .home-toggle--used's
     attention-pulse (above) is already gated behind the same query. */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }

</style>
