---
// Full-screen mobile-nav dialog panel (D-01/D-02/D-04, Phase 20 Plan 03,
// HOME-13). Rendered only when SiteHeader.astro's opt-in `mobileNav` prop is
// true, and rendered as a SIBLING of that <header>, never as its
// descendant. Imports only LanguageSwitcher — no getRelativeLocaleUrl/
// siteSettings/sanity — mirroring SiteHeader.astro's own
// build-time-only, zero-hydration presentational contract.
//
// 20-06 (20-UAT.md Test 2, severity major, user's live on-phone test):
// D-04's switcher clause reverses here. The language switcher is no longer
// a fourth equal-weight primary item alongside Éditions/About/Contact — it
// is now a small, ink-coloured secondary-tier line, stacked directly above
// the Instagram link near the panel's bottom edge. The primary <nav> below
// holds exactly the three equal-weight links.
//
// Hard structural constraints, each protecting a specific pre-existing spec:
// - This <dialog> must stay a SIBLING of <header data-role="site-header">,
//   never a descendant: i18n.spec.ts, homepage-carousel-core.spec.ts and
//   site-header.spec.ts all assert header-scoped counts of exactly 1
//   switcher link and exactly 1 Éditions link.
// - No element in here may reuse the header's primary-link class (the one
//   scoped to `.site-nav >` in site-header.spec.ts): that cross-page
//   structural-identity test counts those header-scoped links and expects
//   exactly 4 — a class collision here would inflate that count.
// - No <header> element may appear in here: i18n.spec.ts clicks through
//   `page.locator('header')` and would trip Playwright strict mode on a
//   second match.
// - This component carries no styles of its own (all CSS lives in
//   SiteHeader.astro's existing `is:global` sheet — see its Task 2 rules)
//   and, in this plan, no client script (open/close wiring lands in plan
//   20-04).
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  homeHref: string;
  homeLabel: string;
  siteTitle: string;
  editionsLabel: string;
  editionsHref: string;
  aboutLabel: string;
  aboutHref: string;
  contactLabel: string;
  contactHref: string;
  instagramUrl: string;
  instagramLabel: string;
  instagramNewTabHint: string;
  logoBlackSrc: string;
  closeMenuLabel: string;
  menuLabel: string;
  galleryLinks?: Array<{ href: string; label: string }>;
}

const {
  homeHref,
  homeLabel,
  siteTitle,
  editionsLabel,
  editionsHref,
  aboutLabel,
  aboutHref,
  contactLabel,
  contactHref,
  instagramUrl,
  instagramLabel,
  instagramNewTabHint,
  logoBlackSrc,
  closeMenuLabel,
  menuLabel,
  galleryLinks = [],
} = Astro.props;
const isEnLocale = Astro.currentLocale === 'en';
---

<dialog id="mobile-nav" class="mobile-nav-panel" data-role="mobile-nav-panel" aria-label={siteTitle}>
  {/* Plan 20-05 (D-02): purely decorative dot texture, first child so it
      paints behind every other panel child in source order -- the explicit
      z-index layering in SiteHeader.astro's motion CSS is what actually
      guarantees that; this ordering is just belt-and-braces. Must stay
      empty and aria-hidden; never add pointer-handling here. */}
  <div class="mobile-nav-panel__halftone" aria-hidden="true"></div>
  <div class="mobile-nav-panel__bar">
    {/* Black logo only — the panel is a white surface, so the header's
        two-image hover-swap chip mechanic is deliberately NOT reused here. */}
    <a href={homeHref} class="mobile-nav-panel__logo" aria-label={siteTitle}>
      <img src={logoBlackSrc} alt="" class="mobile-nav-panel__logo-img" />
    </a>
    {/* Pattern 3 (top-layer stacking): the same bar-glyph structure as the
        header hamburger, so one CSS definition drives both glyphs and plan
        20-04 can transform this instance into an X. */}
    <button type="button" class="mobile-nav-panel__close" data-role="mobile-nav-close" aria-label={closeMenuLabel}>
      <span class="mobile-nav__bars" aria-hidden="true">
        <span class="mobile-nav__bar"></span>
        <span class="mobile-nav__bar"></span>
        <span class="mobile-nav__bar"></span>
      </span>
    </button>
  </div>
  <nav class="mobile-nav-panel__nav" aria-label={menuLabel}>
    <div class="mobile-nav-panel__home-group">
      <a href={homeHref} class="mobile-nav-panel__link">{homeLabel}</a>
      {galleryLinks.length > 0 && (
        <div class="mobile-nav-panel__gallery-links" aria-label={isEnLocale ? 'Galleries' : 'Galeries'}>
          {galleryLinks.map((gallery) => <a href={gallery.href}>{gallery.label}</a>)}
        </div>
      )}
    </div>
    <a href={editionsHref} class="mobile-nav-panel__link">{editionsLabel}</a>
    <a href={aboutHref} class="mobile-nav-panel__link">{aboutLabel}</a>
    <a href={contactHref} class="mobile-nav-panel__link">{contactLabel}</a>
  </nav>
  {/* 20-06 (20-UAT.md Test 2): the switcher is now the upper of two stacked
      secondary lines, a direct child of the dialog rather than a primary
      <nav> item. It sits ABOVE the Instagram anchor below so the Instagram
      anchor stays the bottom-most element and keeps owning the panel's 48px
      bottom offset. The switcher component's own import, copy, href logic
      and cookie script are all untouched — only its size/position context
      changes (SiteHeader.astro's `.mobile-nav-panel > .language-switcher`
      rules). */}
  <LanguageSwitcher />
  <a
    href={instagramUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mobile-nav-panel__secondary"
    aria-label={`Instagram ${instagramLabel}`}
  >
    {/* 20-06: duplicated verbatim from SiteHeader.astro's desktop Instagram
        glyph, at 16x16 instead of 20x20 — matching the sibling switcher
        line's 16x16 globe at the same 14px Label size. This codebase has no
        shared icon component (see the mobile-nav-instagram-icon debug
        session), so inlining the same glyph per component is the existing
        convention, not a refactor debt. */}
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
      <circle cx="12" cy="12" r="4.6" />
      <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
    </svg>
    {instagramLabel}
    <span class="sr-only">{instagramNewTabHint}</span>
  </a>
</dialog>

<script>
  // Phase 20 Plan 04 (HOME-13, D-03): open/close orchestration for the
  // panel plan 20-03 left structural. The native dialog-modal API (see the
  // call below) supplies focus containment, Escape-to-close, and
  // return-focus for free (Lightbox.astro, RESEARCH.md "Don't Hand-Roll") —
  // this script must never add a keydown listener or a hand-rolled
  // focus-cycling loop; neither exists anywhere else in this codebase, by
  // design.
  const panel = document.getElementById('mobile-nav') as HTMLDialogElement | null;
  const toggle = document.querySelector<HTMLButtonElement>('[data-role="mobile-nav-toggle"]');
  const closeBtn = panel?.querySelector<HTMLButtonElement>('[data-role="mobile-nav-close"]');

  // Total no-op if the markup this script depends on is ever absent.
  if (panel && toggle) {
    // Persistent media-query objects (HomeCarousel.astro's
    // `reduceMotionQuery` convention, not a one-shot `matchMedia().matches`
    // call) — both are read repeatedly below, and phoneQuery also needs its
    // own 'change' listener.
    const phoneQuery = window.matchMedia('(max-width: 767px)');
    const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    let closing = false;
    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    // Filtered on purpose: the close button's three morphing bars (see
    // SiteHeader.astro's motion CSS) also transition and bubble
    // transitionend up to the dialog — an unfiltered handler would tear the
    // panel down the moment the FIRST bar's transition ends, not the
    // panel's own opacity/transform transition.
    function onPanelTransitionEnd(event: TransitionEvent) {
      if (event.target === panel) finishClose();
    }

    function finishClose() {
      if (closeTimer !== null) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      panel!.removeEventListener('transitionend', onPanelTransitionEnd);
      panel!.classList.remove('is-closing');
      closing = false;
      panel!.close();
    }

    function openNav() {
      if (!phoneQuery.matches || panel!.open) return;
      toggle!.setAttribute('aria-expanded', 'true');
      // The call below is what supplies focus containment, Escape-to-close
      // and focus restoration for free — none of the three may be
      // hand-rolled (no focus-trap implementation exists anywhere in this
      // codebase, by design).
      panel!.showModal();
    }

    function closeNav() {
      if (!panel!.open || closing) return;
      closing = true;
      panel!.classList.add('is-closing');

      if (reduceMotionQuery.matches) {
        finishClose();
        return;
      }

      panel!.addEventListener('transitionend', onPanelTransitionEnd);
      // Not belt-and-braces decoration: if no transition ever runs (an
      // engine quirk, a print stylesheet, a future CSS edit that drops the
      // transition), transitionend never fires and the visitor would be
      // locked inside a focus-trapped modal with no way out (T-20-03).
      closeTimer = setTimeout(finishClose, 400);
    }

    toggle.addEventListener('click', openNav);
    closeBtn?.addEventListener('click', closeNav);

    // The native `cancel` event fires on Escape and is cancelable —
    // preventing it stops <dialog>'s native instant close so closeNav()'s
    // transition can run before the real panel.close() (this is the Escape
    // path; do not add a keydown listener).
    panel.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeNav();
    });

    // The panel is opaque and fills the viewport, so in practice there is no
    // clickable ::backdrop region to hit — this handler is retained as a
    // cheap safety valve matching Lightbox.astro's own backdrop-click
    // handler, not as a primary dismiss route.
    panel.addEventListener('click', (event) => {
      if (event.target === panel) closeNav();
    });

    panel.addEventListener('close', () => {
      toggle!.setAttribute('aria-expanded', 'false');
      panel!.classList.remove('is-closing');
      closing = false;
      // The toggle is display:none above the phone breakpoint (e.g. when a
      // breakpoint-crossing resize triggered this close) — focusing a
      // non-rendered element is a no-op that silently drops focus to
      // document.body, so only claim focus when the toggle is actually
      // visible.
      if (toggle!.offsetParent !== null) toggle!.focus();
    });

    // A visitor who rotates a tablet or resizes past 768px must not be left
    // inside a modal whose only dismiss affordance is a phone-only control.
    phoneQuery.addEventListener('change', () => {
      if (!phoneQuery.matches && panel!.open) finishClose();
    });

    // Do NOT add a close-on-nav-link-click handler: every primary link
    // performs a real navigation, so the panel is discarded with the
    // document.
  }
</script>
