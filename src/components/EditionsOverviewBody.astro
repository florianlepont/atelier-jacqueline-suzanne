---
// Shared fr/en Éditions overview page body: holds the entire
// `<article class="editions-list">` markup plus the byte-identical style
// block previously duplicated across src/pages/editions/index.astro and
// src/pages/en/editions/index.astro. Takes fully pre-resolved tile data —
// no astro:i18n, ../lib/image, or ../lib/sanity import needed here.
//
// quick-260728-dbf: redesigned to the "B2 — Cursor Preview" pattern from
// sketch 010 (Romane-confirmed) — a flat vertical list of text-only rows
// with a floating cursor-follow 3:4 photo panel, replacing the previous
// zigzag poster-grid tile layout.
import EmptyState from './EmptyState.astro';
import PageTitleHeader from './PageTitleHeader.astro';

interface EditionTile {
  href: string;
  imgSrc: string;
  imgSrcset: string;
  alt: string;
  title: string;
  statement: string;
  format: string;
}

interface Props {
  heading: string;
  intro: string;
  tiles: EditionTile[];
  emptyHeading: string;
  emptyBody: string;
  viewEditionLabel: string;
}

const { heading, intro, tiles, emptyHeading, emptyBody, viewEditionLabel } = Astro.props;

const MOBILE_ACCENTS = [
  { background: 'var(--color-accent)', text: 'var(--color-on-accent)', light: true },
  { background: 'var(--palette-purple)', text: '#FFFFFF', light: false },
  { background: 'var(--palette-teal)', text: 'var(--color-ink)', light: true },
  { background: 'var(--palette-lime)', text: 'var(--color-ink)', light: true },
  { background: 'var(--palette-plum)', text: '#FFFFFF', light: false },
];

const mobileCtaLabel = viewEditionLabel.replace(/^\s*—\s*/, '');
---

<article class="editions-list">
  <PageTitleHeader heading={heading} intro={intro} />

  {
    tiles.length === 0 ? (
      <EmptyState heading={emptyHeading} body={emptyBody} variant="bold" />
    ) : (
      <>
        <div class="editions-index">
          {tiles.map((tile, idx) => {
            const label = `${heading.replace(/s$/, '')} ${String(idx + 1).padStart(2, '0')}`;
            const rowDelay = Math.min(0.6 + idx * 0.12, 1.2);
            const accent = MOBILE_ACCENTS[idx % MOBILE_ACCENTS.length];
            return (
              <a
                class="editions-index__row"
                href={tile.href}
                data-img={tile.imgSrc}
                data-accent={accent.background}
                data-accent-text={accent.text}
                data-accent-light={String(accent.light)}
                style={`animation-delay: ${rowDelay}s`}
              >
                <div class="editions-index__mobile-media" aria-hidden="true">
                  <img src={tile.imgSrc} srcset={tile.imgSrcset} sizes="(max-width: 800px) 100vw, 340px" alt="" loading={idx === 0 ? 'eager' : 'lazy'} />
                </div>
                <span class="editions-index__number">{label}</span>
                <h2 class="editions-index__title">{tile.title}</h2>
                <span class="editions-index__format">{tile.format}</span>
                <div class="editions-index__statement-wrap">
                  <p class="editions-index__statement">{tile.statement}</p>
                </div>
                <span class="editions-index__cta">{mobileCtaLabel} <span aria-hidden="true">→</span></span>
              </a>
            );
          })}
        </div>
        <div class="editions-preview" aria-hidden="true">
          <img src="" alt="" />
        </div>
      </>
    )
  }
</article>

<style>
  .editions-list {
    width: min(100%, var(--editorial-page-max));
    margin: 0 auto;
    padding-inline: var(--editorial-page-padding-inline);
    padding-top: clamp(48px, 7vw, 56px);
    padding-bottom: var(--editorial-page-padding-block);
    transition: background-color 0.35s ease;
  }
  /* Per-row hover accent, cycling the same palette the homepage's gallery
     hero panels use (HomeCarousel's ACCENTS array) — set by the <script>
     below via --editions-row-accent(-text) on <html> so the shared
     SiteHeader can pick up the same colors while a row is hovered. */
  :global(html.editions-row-active) .editions-list {
    background-color: var(--editions-row-accent);
  }

  /* PageTitleHeader.astro owns the header/eyebrow/h1/intro/halftone markup
     and base styling now (shared with the Contact page). These :global()
     rules only add the row-hover color sync that's Éditions-specific.
     EDN-09: the ENTIRE selector must sit inside :global(...), not just the
     `html.editions-row-active` prefix. Astro's :global() only exempts the
     portion inside the parentheses from this component's scope-hash — a
     trailing selector left outside still gets EditionsOverviewBody.astro's
     own data-astro-cid attribute appended at compile time. The real
     .page-title-header__* elements are rendered by PageTitleHeader.astro
     and only ever carry ITS scope attribute, never this component's, so a
     partially-wrapped selector can structurally never match them (confirmed
     live, root-caused during Phase 19 discussion). */
  :global(html.editions-row-active .page-title-header__eyebrow) {
    color: var(--editions-row-accent-text);
  }
  :global(html.editions-row-active .page-title-header__eyebrow::before) {
    background-color: var(--editions-row-accent-text);
  }
  :global(html.editions-row-active .page-title-header h1) {
    color: var(--editions-row-accent-text);
  }
  :global(html.editions-row-active .page-title-header__intro) {
    color: var(--editions-row-accent-text);
  }
  :global(html.editions-row-active .page-title-header__divider) {
    background-color: var(--editions-row-accent-text);
  }

  .editions-index {
    position: relative;
  }

  .editions-index__row {
    display: block;
    padding: var(--space-xl) 0;
    border-bottom: var(--border-hairline) solid var(--color-border);
    text-decoration: none;
    color: var(--color-ink);
    transform: translateY(20px);
    animation: editions-row-fade-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transition: color 0.35s ease, border-color 0.35s ease;
  }
  @keyframes editions-row-fade-up {
    to { transform: translateY(0); }
  }

  .editions-index__row:first-of-type {
    border-top: var(--border-hairline) solid var(--color-ink);
    transition: color 0.35s ease, border-color 0.35s ease;
  }

  :global(html.editions-row-active) .editions-index__row {
    color: var(--editions-row-accent-text);
    border-color: var(--editions-row-accent-text);
  }

  .editions-index__number {
    font-size: 13px;
    color: #6b6b6b;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-sm);
    display: block;
    transition: color 0.35s ease;
  }

  :global(html.editions-row-active) .editions-index__number {
    color: var(--editions-row-accent-text);
  }

  .editions-index__title {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: clamp(32px, 5vw, 64px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0;
    transition: opacity 0.25s ease;
  }

  .editions-index__mobile-media {
    display: none;
  }

  .editions-index__format {
    display: block;
    margin-top: var(--space-sm);
    color: #6b6b6b;
    font-size: var(--text-label-size);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    line-height: 1.35;
    text-transform: uppercase;
    transition: color 0.35s ease;
  }

  .editions-index__cta {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target-min);
    margin-top: var(--space-md);
    color: currentColor;
    font-size: var(--text-label-size);
    font-weight: var(--weight-semibold);
    line-height: 1;
  }

  .editions-index__statement-wrap {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.3s ease;
  }

  .editions-index__statement {
    min-height: 0;
    max-width: 46ch;
    line-height: 1.5;
    margin: var(--space-sm) 0 0;
    color: #6b6b6b;
    opacity: 0;
    overflow: hidden;
    transition: opacity 0.3s ease, color 0.35s ease;
  }

  :global(html.editions-row-active) .editions-index__statement {
    color: var(--editions-row-accent-text);
  }

  :global(html.editions-row-active) .editions-index__format {
    color: var(--editions-row-accent-text);
  }

  /* quick-260826-q79: 0.75 is the smallest clean quarter-step that keeps a
     dimmed non-hovered title at or above WCAG's 3:1 large-text threshold
     once composited over the accent background html.editions-row-active
     paints behind it. Binding worst case is palette entry 0 (white
     --color-on-accent over --pink-600 #D6327C), which needs alpha >= 0.717
     and lands at 3.16:1 here. The previous value (0.28) failed at roughly
     1.5:1 across every palette entry. tests/unit/editions-dim-contrast.test.ts
     recomputes this from the live palette tokens on every run, so a future
     palette change cannot silently re-break it. */
  .editions-index:hover .editions-index__title {
    opacity: 0.75;
  }

  .editions-index__row:hover .editions-index__title {
    opacity: 1;
  }

  .editions-index__row:hover .editions-index__statement-wrap {
    grid-template-rows: 1fr;
  }

  .editions-index__row:hover .editions-index__statement {
    opacity: 1;
  }

  .editions-index__row:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: var(--focus-ring-offset);
  }

  .editions-index__row:focus-visible .editions-index__title {
    opacity: 1;
  }

  .editions-index__row:focus-visible .editions-index__statement-wrap {
    grid-template-rows: 1fr;
  }

  .editions-index__row:focus-visible .editions-index__statement {
    opacity: 1;
  }

  .editions-preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 340px;
    aspect-ratio: 3 / 4;
    z-index: 9997;
    pointer-events: none;
    opacity: 0;
    transform: translate(-1000px, -1000px) scale(0.96);
    transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
    box-shadow: 0 24px 48px -12px rgba(26, 26, 26, 0.35);
    background: var(--gray-0);
  }

  .editions-preview.active {
    opacity: 1;
  }

  .editions-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .editions-index__row {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  }

  @media (max-width: 800px) {
    .editions-list {
      padding-top: var(--space-2xl);
    }

    .editions-index__row {
      padding: var(--space-lg) var(--space-md) var(--space-xl);
    }

    .editions-index__mobile-media {
      display: block;
      aspect-ratio: 4 / 5;
      margin-bottom: var(--space-lg);
      overflow: hidden;
      background: var(--gray-100);
    }

    .editions-index__mobile-media img {
      display: block;
      width: 100%;
      height: 112%;
      object-fit: cover;
      transform: translate3d(0, 0, 0) scale(1.08);
      transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .editions-index__row.is-active .editions-index__mobile-media img {
      transform: translate3d(0, -6%, 0) scale(1.14);
    }

    /* A touch browser can retain a synthetic :hover after a gesture; never
       let the desktop dimming rule make an active mobile title look faded. */
    .editions-index:hover .editions-index__title {
      opacity: 1;
    }

    .editions-index__statement-wrap {
      display: none;
    }

    .editions-index__cta {
      margin-top: var(--space-lg);
      padding: 0 var(--space-md);
      border: var(--border-hairline) solid currentColor;
      font-size: var(--text-label-size);
      font-weight: var(--weight-semibold);
      line-height: 1;
    }

    .editions-preview {
      display: none;
    }

    /* On touch, the selected edition owns the entire reading surface — not
       just the page margins. This is the mobile equivalent of desktop's
       hover takeover, with the accent's paired text colour kept intact. */
    :global(html.editions-row-active) .editions-index__row,
    :global(html.editions-row-active) .editions-index__number {
      color: var(--editions-row-accent-text);
      border-color: var(--editions-row-accent-text);
    }
  }
</style>

<script>
  (function () {
    const preview = document.querySelector('.editions-preview');
    const previewImg = preview?.querySelector('img');
    const container = document.querySelector('.editions-index');
    if (!preview || !previewImg || !container) return;

    container.addEventListener('mousemove', (e: Event) => {
      const mouseEvent = e as MouseEvent;
      (preview as HTMLElement).style.transform = `translate(${mouseEvent.clientX + 28}px, ${
        mouseEvent.clientY - (preview as HTMLElement).offsetHeight / 2
      }px)`;
    });

    // Per-row hover accent: cycles the same bg/text pairs as the homepage's
    // gallery hero panels (HomeCarousel's ACCENTS array) by row position, so
    // it extends automatically as more éditions are added. Set on <html> (not
    // scoped to this component) so the shared SiteHeader can pick up the same
    // colors — see EditionsOverviewBody.astro's :global(html.editions-row-active)
    // rules and SiteHeader.astro's matching rules.
    const ACCENTS = [
      { bg: 'var(--color-accent)', text: 'var(--color-on-accent)', light: true },
      { bg: 'var(--palette-purple)', text: '#FFFFFF', light: false },
      { bg: 'var(--palette-teal)', text: 'var(--color-ink)', light: true },
      { bg: 'var(--palette-lime)', text: 'var(--color-ink)', light: true },
      { bg: 'var(--palette-plum)', text: '#FFFFFF', light: false },
    ];
    const root = document.documentElement;

    function clearActiveRow() {
      rows.forEach((row) => row.classList.remove('is-active'));
      root.classList.remove('editions-row-active', 'editions-row-light', 'editions-row-dark');
      root.style.removeProperty('--editions-row-accent');
      root.style.removeProperty('--editions-row-accent-text');
    }

    function setActiveRow(accent: (typeof ACCENTS)[number]) {
      root.style.setProperty('--editions-row-accent', accent.bg);
      root.style.setProperty('--editions-row-accent-text', accent.text);
      root.classList.add('editions-row-active');
      root.classList.toggle('editions-row-light', accent.light);
      root.classList.toggle('editions-row-dark', !accent.light);
    }

    const rows = Array.from(container.querySelectorAll('.editions-index__row'));

    rows.forEach((row, idx) => {
      const accent = ACCENTS[idx % ACCENTS.length];
      row.addEventListener('mouseenter', () => {
        (previewImg as HTMLImageElement).src = (row as HTMLElement).dataset.img ?? '';
        preview.classList.add('active');
        setActiveRow(accent);
      });
      row.addEventListener('mouseleave', () => {
        preview.classList.remove('active');
        clearActiveRow();
      });
    });

    // Touch has no hover state. Select the edition occupying the reading
    // zone with IntersectionObserver rather than a scroll handler: the
    // colour hand-off is intentional, cheap and stable on iPhone.
    const phoneQuery = window.matchMedia('(max-width: 800px)');
    let observer: IntersectionObserver | null = null;
    let headerObserver: IntersectionObserver | null = null;

    function syncTouchSelection() {
      observer?.disconnect();
      headerObserver?.disconnect();
      clearActiveRow();

      if (!phoneQuery.matches) return;

      observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;

          const activeRow = visible.target as HTMLElement;
          rows.forEach((row) => row.classList.toggle('is-active', row === activeRow));
          setActiveRow({
            bg: activeRow.dataset.accent ?? 'var(--color-accent)',
            text: activeRow.dataset.accentText ?? 'var(--color-on-accent)',
            light: activeRow.dataset.accentLight === 'true',
          });
        },
        { threshold: [0.45, 0.6, 0.75], rootMargin: '-18% 0px -32% 0px' },
      );

      rows.forEach((row) => observer!.observe(row));

      const pageHeader = document.querySelector('.page-title-header');
      if (pageHeader) {
        headerObserver = new IntersectionObserver(
          ([entry]) => {
            // Returning to the editorial introduction is a deliberate reset
            // point: restore the white page and its divider before the user
            // reaches the menu heading, rather than leaving the last card's
            // accent stuck behind it.
            if (entry.isIntersecting && entry.intersectionRatio >= 0.55) clearActiveRow();
          },
          { threshold: [0.55] },
        );
        headerObserver.observe(pageHeader);
      }
    }

    syncTouchSelection();
    phoneQuery.addEventListener('change', syncTouchSelection);
  })();
</script>
