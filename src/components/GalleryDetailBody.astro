---
// Shared fr/en Gallery detail page body (quick-260727-the): holds the
// entire `<div class="gallery-detail">` markup PLUS the sibling
// `<Lightbox />` element, plus the byte-identical style block previously
// duplicated across src/pages/galleries/[slug].astro and
// src/pages/en/galleries/[slug].astro. All locale-resolved data arrives as
// props; this body has NO hardcoded locale strings of its own — every
// visible/aria string arrives pre-resolved from the calling route.
import DetailHero from './DetailHero.astro';
import GalleryGrid, { type GalleryGridItem } from './GalleryGrid.astro';
import Lightbox from './Lightbox.astro';
import type { GalleryImage } from '../lib/sanity';

interface Props {
  leadPhotoSrc: string;
  leadPhotoSrcSet: string;
  leadPhotoAlt: string;
  title: string;
  total: number;
  heroAriaLabel: string;
  heroIndex: number;
  statement: string;
  scrollHintLabel: string;
  carouselReturnHref: string;
  accent: string;
  accentText: string;
  relatedLink: { href: string; text: string } | null;
  gridItems: GalleryGridItem[];
  lightboxImages: GalleryImage[];
  contactCtaHref: string;
  contactCtaLabel: string;
  locale: 'fr' | 'en';
}

const {
  leadPhotoSrc,
  leadPhotoSrcSet,
  leadPhotoAlt,
  title,
  total,
  heroAriaLabel,
  heroIndex,
  statement,
  scrollHintLabel,
  carouselReturnHref,
  accent,
  accentText,
  relatedLink,
  gridItems,
  lightboxImages,
  contactCtaHref,
  contactCtaLabel,
  locale,
} = Astro.props;
---

{/* PORT-06 (v1.5): gallery and édition detail pages share identical
    footer behavior today — GalleryDetailPage.astro no longer passes
    hideFooter to BaseLayout. This component renders EDN-12's optional
    reverse cross-link to the associated édition at the top of the content
    area, and CONT-04's contact CTA at the end of it; no footer-conditional
    logic exists here. */}
<div class="gallery-detail">
  <DetailHero
    leadPhotoSrc={leadPhotoSrc}
    leadPhotoSrcSet={leadPhotoSrcSet}
    leadPhotoAlt={leadPhotoAlt}
    title={title}
    total={total}
    heroAriaLabel={heroAriaLabel}
    heroIndex={heroIndex}
    statement={statement}
    scrollHintLabel={scrollHintLabel}
    carouselReturnHref={carouselReturnHref}
    galleryVariant={true}
    accent={accent}
    accentText={accentText}
  />
  <div class="gallery-detail__content">
    {relatedLink && (
      <a class="gallery-detail__related" href={relatedLink.href}>
        {relatedLink.text}
      </a>
    )}
    {gridItems.length > 0 && <GalleryGrid items={gridItems} layout="masonry" />}
    <div class="gallery-detail__contact-cta-zone">
      <div class="gallery-detail__contact-cta-rule"></div>
      <a class="gallery-detail__contact-cta" href={contactCtaHref}>
        {contactCtaLabel}
        <span class="gallery-detail__contact-cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>
<Lightbox images={lightboxImages} locale={locale} />

<style>
  .gallery-detail {
    padding: 0 0 var(--space-2xl);
  }

  .gallery-detail__content {
    padding: var(--space-2xl) var(--space-md) 0;
  }

  /* EDN-12: reverse cross-link to the associated édition, mirroring
     EditionDetailBody.astro's .edition-detail__related treatment
     byte-for-byte (renamed only) per UI-SPEC.md's Component Contract. */
  .gallery-detail__related {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    padding: 10px var(--space-md);
    font-size: var(--text-label-size);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    border: 2px solid currentColor;
    margin: 0 0 var(--space-2xl);
  }

  .gallery-detail__related::after {
    content: '→';
    flex: none;
    font-size: 20px;
    line-height: 1;
  }

  .gallery-detail__related:hover,
  .gallery-detail__related:focus-visible {
    color: var(--color-accent);
    outline: 2px solid var(--color-accent);
    outline-offset: var(--focus-ring-offset);
  }

  @media (max-width: 767px) {
    .gallery-detail__related {
      max-width: 100%;
      margin: 0 0 var(--space-xl);
    }
  }

  /* CONT-04: contact CTA closing the photo sequence, sketch 018 Variant B. */
  .gallery-detail__contact-cta-zone {
    padding-top: var(--space-2xl);
  }

  .gallery-detail__contact-cta-rule {
    border-top: 1px solid var(--pink-600);
    width: 48px;
    margin-bottom: var(--space-md);
  }

  .gallery-detail__contact-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.25;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .gallery-detail__contact-cta-arrow {
    color: var(--pink-600);
    font-size: 20px;
    transition: transform 0.15s ease;
  }

  .gallery-detail__contact-cta:hover,
  .gallery-detail__contact-cta:focus-visible {
    border-bottom-color: var(--color-ink);
  }

  .gallery-detail__contact-cta:hover .gallery-detail__contact-cta-arrow,
  .gallery-detail__contact-cta:focus-visible .gallery-detail__contact-cta-arrow {
    transform: translateX(4px);
  }
</style>
